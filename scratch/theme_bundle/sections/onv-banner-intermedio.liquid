{%- comment -%}
  ONYVERA — Sección: Banner Intermedio Full-Bleed (Desktop & Mobile)
  Muestra imagen edge-to-edge con onv-herobody1-desktop.png en PC y onv-herobody1-phone.jpg en Celular (16:9)
{%- endcomment -%}

{%- liquid
  assign desktop_img_url = 'onv-herobody1-desktop.png' | asset_url
  if section.settings.desktop_image != blank
    assign desktop_img_url = section.settings.desktop_image | image_url: width: 2400
  endif

  assign mobile_img_url = 'onv-herobody1-phone.jpg' | asset_url
  if section.settings.mobile_image != blank
    assign mobile_img_url = section.settings.mobile_image | image_url: width: 1500
  endif

  assign banner_link = section.settings.link
  if banner_link == blank
    assign banner_link = '#onv-specs'
  endif
-%}

<section id="onv-banner-intermedio-{{ section.id }}" class="onv-banner-body">
  <a href="{{ banner_link }}" class="onv-banner-body__link" aria-label="Ver ofertas ONYVERA">
    <picture class="onv-banner-body__picture">
      <source media="(max-width: 749px)" srcset="{{ mobile_img_url }}">
      <source media="(min-width: 750px)" srcset="{{ desktop_img_url }}">
      <img
        src="{{ desktop_img_url }}"
        alt="{{ section.settings.alt_text | default: 'ONYVERA Banner Promocional' | escape }}"
        class="onv-banner-body__img"
        width="1024"
        height="209"
        loading="lazy"
      >
    </picture>
  </a>
</section>

{% style %}
  .onv-banner-body {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding: 0;
    margin-top: 10px;
    margin-bottom: 10px;
    overflow: hidden;
    line-height: 0;
    display: block;
    background-color: #ffffff;
  }

  .onv-banner-body__link {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    line-height: 0;
    text-decoration: none;
    cursor: pointer;
  }

  .onv-banner-body__picture {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    line-height: 0;
  }

  .onv-banner-body__img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    object-position: center;
    border: none;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 749px) {
    .onv-banner-body {
      width: 100%;
      left: 0;
      right: 0;
      margin-left: 0;
      margin-right: 0;
      margin-top: 8px;
      margin-bottom: 8px;
    }

    .onv-banner-body__img {
      width: 100%;
      height: auto;
      object-fit: contain;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "ONV Banner Intermedio",
  "tag": "section",
  "class": "section-onv-banner-intermedio",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Imagen para Computador (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagen para Celular (Mobile)"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace al hacer clic en el Banner"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Texto alternativo",
      "default": "ONYVERA Banner Promocional"
    }
  ],
  "presets": [
    {
      "name": "ONV Banner Intermedio"
    }
  ]
}
{% endschema %}
