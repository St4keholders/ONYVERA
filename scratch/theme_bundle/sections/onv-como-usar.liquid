{%- comment -%}
  ONYVERA — Sección: Cómo Aplicar
  Ficha gráfica con frasco central grande y prominente de fondo transparente + 4 pasos de manicura.
{%- endcomment -%}

<section
  id="onv-como-usar-{{ section.id }}"
  class="onv-app"
>
  <div class="onv-app__container">

    <!-- Encabezado con píldora dorada -->
    <div class="onv-app__header">
      <div class="onv-app__badge">APLICACIÓN</div>
    </div>

    <!-- Grilla 4 Pasos con Frasco Central GRANDE -->
    <div class="onv-app__layout">

      <!-- Paso 1 (Arriba Izquierda): Lima suavemente -->
      <div class="onv-app__step onv-app__step--1">
        <div class="onv-app__icon-box">
          <svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="onv-app__svg">
            <path d="M14 26V36C14 38.2 15.8 40 18 40H26C28.2 40 30 38.2 30 36V26" stroke="#2C6E56" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M16 26C16 21 19 19 22 19C25 19 28 21 28 26V30H16V26Z" stroke="#2C6E56" stroke-width="1.8" fill="rgba(44, 110, 86, 0.08)"/>
            <rect x="7" y="10" width="28" height="4" rx="2" transform="rotate(22 7 10)" fill="#A8833B" stroke="#8C6A28" stroke-width="1"/>
            <path d="M8 19L11 21M33 7L36 9" stroke="#A8833B" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="onv-app__content">
          <span class="onv-app__num">PASO 1</span>
          <h3 class="onv-app__step-title">Lima suavemente</h3>
          <p class="onv-app__step-desc">Pulido ligero para retirar asperezas.</p>
        </div>
      </div>

      <!-- Paso 2 (Arriba Derecha): Aplica con la brocha -->
      <div class="onv-app__step onv-app__step--2">
        <div class="onv-app__icon-box">
          <svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="onv-app__svg">
            <path d="M14 26V36C14 38.2 15.8 40 18 40H26C28.2 40 30 38.2 30 36V26" stroke="#2C6E56" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M16 26C16 21 19 19 22 19C25 19 28 21 28 26V30H16V26Z" stroke="#2C6E56" stroke-width="1.8" fill="rgba(44, 110, 86, 0.08)"/>
            <path d="M30 6L25 15L23 19L27 21L29 17L34 8L30 6Z" fill="#A8833B" stroke="#8C6A28" stroke-width="1"/>
            <path d="M22 20C21 21.5 21 23 22 24C23 25 24 24 24.5 23L22 20Z" fill="#2C6E56"/>
          </svg>
        </div>
        <div class="onv-app__content">
          <span class="onv-app__num">PASO 2</span>
          <h3 class="onv-app__step-title">Aplica con brocha</h3>
          <p class="onv-app__step-desc">Capa fina precisa en uña y contorno.</p>
        </div>
      </div>

      <!-- Frasco Central GRANDE Y HEROICO -->
      <div class="onv-app__center-visual">
        <img
          src="{{ 'onv-producto-frasco-fondo-transparente.png' | asset_url }}"
          alt="ONYVERA Sérum Frasco 16ml"
          width="180"
          height="260"
          loading="lazy"
          class="onv-app__bottle"
        >
      </div>

      <!-- Paso 3 (Abajo Izquierda): Absorción completa -->
      <div class="onv-app__step onv-app__step--3">
        <div class="onv-app__icon-box">
          <svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="onv-app__svg">
            <path d="M14 26V36C14 38.2 15.8 40 18 40H26C28.2 40 30 38.2 30 36V26" stroke="#2C6E56" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M16 26C16 21 19 19 22 19C25 19 28 21 28 26V30H16V26Z" stroke="#2C6E56" stroke-width="1.8" fill="rgba(44, 110, 86, 0.12)"/>
            <path d="M22 6C22 6 18 11 18 13.5C18 15.7 19.8 17.5 22 17.5C24.2 17.5 26 15.7 26 13.5C26 11 22 6 22 6Z" fill="#2C6E56"/>
            <path d="M13 14C13 14 10 17 10 18.5C10 20 11.2 21 12.5 21C13.8 21 15 20 15 18.5C15 17 13 14 13 14Z" fill="#A8833B"/>
            <path d="M31 14C31 14 29 17 29 18.5C29 20 30.2 21 31.5 21C32.8 21 34 20 34 18.5C34 17 31 14 31 14Z" fill="#A8833B"/>
          </svg>
        </div>
        <div class="onv-app__content">
          <span class="onv-app__num">PASO 3</span>
          <h3 class="onv-app__step-title">Deja absorber</h3>
          <p class="onv-app__step-desc">Seca al aire libre sin residuo graso.</p>
        </div>
      </div>

      <!-- Paso 4 (Abajo Derecha): Repite a diario -->
      <div class="onv-app__step onv-app__step--4">
        <div class="onv-app__icon-box">
          <svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="onv-app__svg">
            <circle cx="22" cy="22" r="14" stroke="#2C6E56" stroke-width="2"/>
            <path d="M22 13V22L28 25" stroke="#A8833B" stroke-width="2" stroke-linecap="round"/>
            <circle cx="33" cy="31" r="7" fill="#2C6E56"/>
            <path d="M30 31L32 33L36 29" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="onv-app__content">
          <span class="onv-app__num">PASO 4</span>
          <h3 class="onv-app__step-title">Repite a diario</h3>
          <p class="onv-app__step-desc">Hábito diario constante para nutrir.</p>
        </div>
      </div>

    </div>

  </div>
</section>

{% style %}
  .onv-app {
    background-color: #ffffff;
    padding: 24px 16px 20px;
    color: var(--onv-green-900);
    overflow: hidden;
  }

  .onv-app__container {
    max-width: 580px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .onv-app__header {
    text-align: center;
    margin-bottom: 12px;
  }

  .onv-app__badge {
    display: inline-block;
    padding: 4px 20px;
    border: 1.5px solid var(--onv-gold);
    border-radius: 999px;
    font-family: var(--onv-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--onv-gold);
    text-transform: uppercase;
  }

  /* Grid 2x2 con botella central agrandada */
  .onv-app__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto auto;
    gap: 6px 12px;
    width: 100%;
    align-items: center;
  }

  .onv-app__center-visual {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 4px 0;
  }

  /* Frasco GRANDE y nítido */
  .onv-app__bottle {
    width: 130px;
    height: auto;
    max-height: 190px;
    object-fit: contain;
    filter: drop-shadow(0 8px 18px rgba(19, 46, 35, 0.14));
    background: transparent;
  }

  @media (min-width: 600px) {
    .onv-app__layout {
      grid-template-columns: 1fr 160px 1fr;
      grid-template-rows: 1fr 1fr;
      gap: 14px 18px;
    }
    .onv-app__step--1 { grid-column: 1; grid-row: 1; }
    .onv-app__step--2 { grid-column: 3; grid-row: 1; }
    .onv-app__center-visual { grid-column: 2; grid-row: 1 / span 2; }
    .onv-app__step--3 { grid-column: 1; grid-row: 2; }
    .onv-app__step--4 { grid-column: 3; grid-row: 2; }
    .onv-app__bottle { width: 160px; max-height: 240px; }
  }

  .onv-app__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2px;
    padding: 4px;
  }

  .onv-app__icon-box {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    margin-bottom: 2px;
  }

  .onv-app__svg {
    width: 100%;
    height: 100%;
  }

  .onv-app__num {
    font-family: var(--onv-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--onv-teal-600);
    text-transform: uppercase;
  }

  .onv-app__step-title {
    font-family: var(--onv-body);
    font-size: 12px;
    font-weight: 700;
    color: var(--onv-green-900);
    margin: 0;
    line-height: 1.15;
  }

  .onv-app__step-desc {
    font-family: var(--onv-body);
    font-size: 10.5px;
    color: var(--onv-ink-soft);
    margin: 0;
    line-height: 1.25;
    max-width: 160px;
  }
{% endstyle %}

{% schema %}
{
  "name": "ONV Cómo Aplicar",
  "tag": "section",
  "class": "section-onv-app",
  "presets": [
    {
      "name": "ONV Cómo Aplicar"
    }
  ]
}
{% endschema %}
