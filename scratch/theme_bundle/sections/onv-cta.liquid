{%- comment -%}
  ONYVERA — Sección: CTA Final (Dos Paneles)
  Panel de texto con título, botón y lista de confianza + Panel de imagen de producto.
  Desktop: 2 columnas iguales (1fr 1fr).
  Móvil: Columna única, panel de texto primero, imagen debajo.
{%- endcomment -%}

<section id="onv-cta" class="onv-cta-section">
  <div class="onv-cta__container{% if section.settings.posicion_imagen == 'izquierda' %} onv-cta__container--reverse{% endif %}">

    <!-- PANEL DE TEXTO (COPY) -->
    <div class="onv-cta__panel onv-cta__panel--copy">
      <h2 class="onv-cta__title">
        {{ section.settings.titulo | default: "Recupera tus uñas. Recupera tu confianza." | escape }}
      </h2>

      {%- assign btn_url = section.settings.enlace_boton | default: '/collections/all' -%}
      <a href="{{ btn_url }}" class="onv-cta__button">
        {{ section.settings.texto_boton | default: "PIDE ONYVERA AHORA" | escape }}
      </a>

      <!-- Lista de Confianza -->
      <ul class="onv-cta__trust-list">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <li class="onv-cta__trust-item" {{ block.shopify_attributes }}>
              <span class="onv-cta__trust-text">{{ block.settings.texto | escape }}</span>
            </li>
          {%- endfor -%}
        {%- else -%}
          <li class="onv-cta__trust-item">
            <span class="onv-cta__trust-text">Envío gratis en EE. UU. en pedidos desde $50</span>
          </li>
          <li class="onv-cta__trust-item">
            <span class="onv-cta__trust-text">Se envía desde Orlando, Florida</span>
          </li>
          <li class="onv-cta__trust-item">
            <span class="onv-cta__trust-text">Vegano, libre de crueldad, sin parabenos ni sulfatos</span>
          </li>
        {%- endif -%}
      </ul>
    </div>

    <!-- PANEL DE IMAGEN DE PRODUCTO -->
    <div class="onv-cta__panel onv-cta__panel--media">
      {%- if section.settings.imagen != blank -%}
        <img
          src="{{ section.settings.imagen | image_url: width: 1080 }}"
          alt="{{ section.settings.alt_text | default: 'El frasco de sérum ONYVERA sostenido entre dos dedos.' | escape }}"
          class="onv-cta__img"
          width="1080"
          height="1350"
          loading="lazy"
          decoding="async"
        >
      {%- else -%}
        <img
          src="{{ 'onv-cta.png' | asset_url }}"
          alt="{{ section.settings.alt_text | default: 'El frasco de sérum ONYVERA sostenido entre dos dedos.' | escape }}"
          class="onv-cta__img"
          width="1080"
          height="1350"
          loading="lazy"
          decoding="async"
        >
      {%- endif -%}
    </div>

  </div>
</section>

{% style %}
  .onv-cta-section {
    background-color: transparent;
    padding-block: clamp(3rem, 6vw, 5.5rem);
    width: 100%;
    box-sizing: border-box;
  }

  .onv-cta__container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding-inline: 24px;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: stretch;
  }

  .onv-cta__container--reverse {
    grid-template-columns: 1fr 1fr;
  }
  @media (min-width: 900px) {
    .onv-cta__container--reverse .onv-cta__panel--copy {
      order: 2;
    }
    .onv-cta__container--reverse .onv-cta__panel--media {
      order: 1;
    }
  }

  /* Paneles Base */
  .onv-cta__panel {
    border-radius: 20px;
    overflow: hidden;
    box-shadow: none;
    box-sizing: border-box;
  }

  /* Panel Izquierdo — Copy */
  .onv-cta__panel--copy {
    background-color: #F6F2E9;
    padding: clamp(32px, 4vw, 56px);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .onv-cta__title {
    font-family: var(--font-display, "Playfair Display", Georgia, serif) !important;
    font-weight: 600 !important;
    font-size: clamp(1.9rem, 3.4vw, 3rem) !important;
    line-height: 1.12 !important;
    color: #1B3A2F !important;
    max-width: 18ch;
    margin: 0;
  }

  .onv-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    margin-top: 24px;
    background-color: #1B3A2F;
    color: #F6F2E9 !important;
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 700 !important;
    font-size: 0.875rem !important; /* 14px */
    text-transform: uppercase !important;
    letter-spacing: 0.06em !important;
    padding: 16px 32px;
    border-radius: 4px;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .onv-cta__button:hover {
    background-color: #2F7A6B;
    color: #FFFFFF !important;
  }

  .onv-cta__button:focus-visible {
    outline: 2px solid #1B3A2F;
    outline-offset: 3px;
  }

  /* Lista de Confianza */
  .onv-cta__trust-list {
    margin: 40px 0 0 0;
    margin-top: auto;
    padding: 0;
    list-style: none;
    width: 100%;
  }

  .onv-cta__trust-item {
    padding-block: 16px;
    border-top: 1px solid #E6E0D2;
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 500 !important;
    font-size: 0.9375rem !important; /* 15px */
    color: #4A5A52 !important;
    line-height: 1.4;
    display: flex;
    align-items: center;
  }

  /* Panel Derecho — Imagen */
  .onv-cta__panel--media {
    background-color: #E6E0D2;
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100%;
  }

  .onv-cta__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
    display: block;
    border-radius: 20px;
  }

  /* Layout Móvil (< 900px) */
  @media (max-width: 899px) {
    .onv-cta-section {
      padding-block: 2.5rem 3rem;
    }

    .onv-cta__container {
      display: flex;
      flex-direction: column;
      gap: 20px;
      padding-inline: 16px;
    }

    .onv-cta__panel--copy {
      padding: 28px 20px;
      order: 1;
      border-radius: 18px;
    }

    .onv-cta__title {
      font-size: clamp(20px, 5.5vw, 26px) !important;
      line-height: 1.18 !important;
    }

    .onv-cta__button {
      width: 100%;
      box-sizing: border-box;
      text-align: center;
      margin-top: 20px;
      padding: 14px 24px;
    }

    .onv-cta__panel--media {
      order: 2;
      aspect-ratio: 4 / 5;
      max-height: 440px;
      height: auto;
      min-height: auto;
      border-radius: 18px;
    }

    .onv-cta__trust-list {
      margin-top: 24px;
    }

    .onv-cta__trust-item {
      padding-block: 12px;
      font-size: 13.5px !important;
      line-height: 1.35;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "CTA final",
  "tag": "section",
  "class": "section-onv-cta",
  "settings": [
    {
      "type": "text",
      "id": "titulo",
      "label": "Título",
      "default": "Recupera tus uñas. Recupera tu confianza."
    },
    {
      "type": "text",
      "id": "texto_boton",
      "label": "Texto del botón",
      "default": "PIDE ONYVERA AHORA"
    },
    {
      "type": "url",
      "id": "enlace_boton",
      "label": "Enlace del botón"
    },
    {
      "type": "image_picker",
      "id": "imagen",
      "label": "Imagen de producto"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Texto alternativo (alt)",
      "default": "El frasco de sérum ONYVERA sostenido entre dos dedos."
    },
    {
      "type": "select",
      "id": "posicion_imagen",
      "label": "Posición de la imagen en desktop",
      "options": [
        {
          "value": "derecha",
          "label": "Derecha"
        },
        {
          "value": "izquierda",
          "label": "Izquierda"
        }
      ],
      "default": "derecha"
    }
  ],
  "blocks": [
    {
      "type": "beneficio",
      "name": "Beneficio de confianza",
      "settings": [
        {
          "type": "text",
          "id": "texto",
          "label": "Texto del beneficio",
          "default": "Envío gratis en EE. UU. en pedidos desde $50"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "CTA final",
      "blocks": [
        {
          "type": "beneficio",
          "settings": {
            "texto": "Envío gratis en EE. UU. en pedidos desde $50"
          }
        },
        {
          "type": "beneficio",
          "settings": {
            "texto": "Se envía desde Orlando, Florida"
          }
        },
        {
          "type": "beneficio",
          "settings": {
            "texto": "Vegano, libre de crueldad, sin parabenos ni sulfatos"
          }
        }
      ]
    }
  ]
}
{% endschema %}
