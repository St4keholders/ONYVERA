{%- comment -%}
  ONYVERA — Sección: Hero Full-Bleed (Desktop & Mobile)
  Muestra imagen edge-to-edge optimizada y responsiva con onv-hero-desktop.jpeg y onv-hero-mobile.jpeg
{%- endcomment -%}

{%- liquid
  assign desktop_image_url = 'onv-hero-desktop.jpeg' | asset_url
  if section.settings.desktop_image != blank
    assign desktop_image_url = section.settings.desktop_image | image_url: width: 2400
  endif

  assign mobile_image_url = 'onv-hero-mobile.jpeg' | asset_url
  if section.settings.mobile_image != blank
    assign mobile_image_url = section.settings.mobile_image | image_url: width: 1080
  endif

  assign hero_link = section.settings.link
  if hero_link == blank
    assign hero_link = '#onv-specs'
  endif
-%}

<section id="onv-hero-{{ section.id }}" class="onv-hero-fullbleed">
  <a href="{{ hero_link }}" class="onv-hero-fullbleed__link" aria-label="Ver producto ONYVERA">
    <picture class="onv-hero-fullbleed__picture">
      <source media="(max-width: 749px)" srcset="{{ mobile_image_url }}">
      <source media="(min-width: 750px)" srcset="{{ desktop_image_url }}">
      <img
        src="{{ desktop_image_url }}"
        alt="{{ section.settings.alt_text | default: 'ONYVERA Sérum Botánico para Uñas' | escape }}"
        class="onv-hero-fullbleed__img"
        width="1920"
        height="1080"
        loading="eager"
        fetchpriority="high"
      >
    </picture>
  </a>
</section>

{% style %}
  .onv-hero-fullbleed {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding: 0;
    margin-top: 0;
    margin-bottom: 0;
    overflow: hidden;
    line-height: 0;
    display: block;
    background-color: #ffffff;
  }

  .onv-hero-fullbleed__link {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    line-height: 0;
    text-decoration: none;
    cursor: pointer;
  }

  .onv-hero-fullbleed__picture {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    line-height: 0;
  }

  .onv-hero-fullbleed__img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    object-position: center;
    border: none;
    margin: 0;
    padding: 0;
  }

  /* Reducir altura en Desktop (PC) para que no consuma tanto espacio */
  @media (min-width: 750px) {
    .onv-hero-fullbleed {
      max-height: clamp(350px, 45vh, 460px);
    }

    .onv-hero-fullbleed__picture {
      max-height: clamp(350px, 45vh, 460px);
      overflow: hidden;
    }

    .onv-hero-fullbleed__img {
      height: clamp(350px, 45vh, 460px);
      width: 100%;
      object-fit: cover;
      object-position: center;
    }
  }

  /* Mobile: Exactamente igual e intacto */
  @media (max-width: 749px) {
    .onv-hero-fullbleed {
      width: 100%;
      left: 0;
      right: 0;
      margin-left: 0;
      margin-right: 0;
    }

    .onv-hero-fullbleed__img {
      width: 100%;
      height: auto;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "ONV Hero Full-Bleed",
  "tag": "section",
  "class": "section-onv-hero-fullbleed",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Imagen para Computador (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagen para Celular (Mobile)"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace al hacer clic en el Hero"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Texto alternativo (Accesibilidad)",
      "default": "ONYVERA Sérum Botánico para Uñas"
    }
  ],
  "presets": [
    {
      "name": "ONV Hero Full-Bleed"
    }
  ]
}
{% endschema %}
