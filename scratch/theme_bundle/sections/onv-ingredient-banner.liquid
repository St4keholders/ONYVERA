{%- comment -%}
  ONYVERA — Sección: Ingredient Banner (Full-Bleed Flat-Lay Banner)
  Banner botánico full-bleed con recorte responsivo por aspect-ratio, gradiente scrim y texto sobrepuesto.
{%- endcomment -%}

{%- liquid
  assign banner_img_url = 'onv-Cinta.jpeg' | asset_url
  if section.settings.image != blank
    assign banner_img_url = section.settings.image | image_url: width: 2800
  endif

  assign scrim_op = section.settings.scrim_opacity | default: 94
  assign op1 = scrim_op | divided_by: 100.0
  assign op2 = op1 | times: 0.85
  assign op3 = op1 | times: 0.64

  assign desktop_ratio = section.settings.desktop_ratio | default: '3:1'
  assign ratio_val = '3 / 1'
  if desktop_ratio == '5:2'
    assign ratio_val = '5 / 2'
  elsif desktop_ratio == '2:1'
    assign ratio_val = '2 / 1'
  endif

  assign text_pos = section.settings.text_position | default: 'left'
-%}

<section id="onv-ingredient-banner-{{ section.id }}" class="onv-ing-banner">
  <div class="onv-ing-banner__container onv-ing-banner__container--{{ text_pos }}">
    
    <picture class="onv-ing-banner__picture">
      <img
        src="{{ banner_img_url }}"
        alt="Tea tree sprig, sliced aloe vera, glycerin and vitamin E beside the ONYVERA nail serum bottle on a cream surface."
        class="onv-ing-banner__img"
        width="2752"
        height="1536"
        loading="lazy"
        decoding="async"
      >
    </picture>

    <div class="onv-ing-banner__scrim" aria-hidden="true"></div>

    <div class="onv-ing-banner__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="onv-ing-banner__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="onv-ing-banner__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

  </div>
</section>

{% style %}
  .onv-ing-banner {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding: 0;
    overflow: hidden;
    display: block;
    line-height: 0;
  }

  .onv-ing-banner__container {
    position: relative;
    width: 100%;
    aspect-ratio: {{ ratio_val }};
    overflow: hidden;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 600px) and (max-width: 999px) {
    .onv-ing-banner__container {
      aspect-ratio: 5 / 2;
    }
  }

  @media (max-width: 599px) {
    .onv-ing-banner__container {
      aspect-ratio: 3 / 2;
    }
  }

  .onv-ing-banner__picture {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
  }

  .onv-ing-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 48%;
    display: block;
    border: none;
    margin: 0;
    padding: 0;
  }

  /* Scrim Gradient Overlay */
  .onv-ing-banner__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: linear-gradient(
      to right,
      rgba(246, 242, 233, {{ op1 }}) 0%,
      rgba(246, 242, 233, {{ op2 }}) 26%,
      rgba(246, 242, 233, 0.00) 52%
    );
  }

  @media (max-width: 599px) {
    .onv-ing-banner__scrim {
      background: linear-gradient(
        to bottom,
        rgba(246, 242, 233, {{ op1 }}) 0%,
        rgba(246, 242, 233, {{ op3 }}) 42%,
        rgba(246, 242, 233, 0.00) 78%
      );
    }
  }

  /* Text Overlay */
  .onv-ing-banner__content {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    left: 6%;
    max-width: 34ch;
    z-index: 2;
    line-height: normal;
    text-align: left;
    box-sizing: border-box;
  }

  .onv-ing-banner__container--center .onv-ing-banner__content {
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
  }

  @media (max-width: 599px) {
    .onv-ing-banner__content {
      top: 6%;
      left: 6%;
      right: 6%;
      transform: none;
      max-width: 26ch;
    }
  }

  .onv-ing-banner__eyebrow {
    display: block;
    font-family: var(--onv-body, 'Karla', sans-serif);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: clamp(0.68rem, 0.9vw, 0.82rem);
    color: #2F7A6B;
    margin: 0 0 0.75rem 0;
  }

  .onv-ing-banner__heading {
    font-family: var(--onv-display, 'Cormorant Garamond', serif);
    font-weight: 600;
    line-height: 1.12;
    font-size: clamp(1.6rem, 3.4vw, 3.1rem);
    color: #1B3A2F;
    margin: 0;
  }
{% endstyle %}

{% schema %}
{
  "name": "Ingredient banner",
  "tag": "section",
  "class": "section-ingredient-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "BOTANICAL TRANSPARENCY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Five actives. Ten ingredients. Nothing hidden."
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "scrim_opacity",
      "label": "Scrim opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 94
    },
    {
      "type": "select",
      "id": "desktop_ratio",
      "label": "Desktop ratio",
      "options": [
        {
          "value": "3:1",
          "label": "3:1"
        },
        {
          "value": "5:2",
          "label": "5:2"
        },
        {
          "value": "2:1",
          "label": "2:1"
        }
      ],
      "default": "3:1"
    }
  ],
  "presets": [
    {
      "name": "Ingredient banner"
    }
  ]
}
{% endschema %}
