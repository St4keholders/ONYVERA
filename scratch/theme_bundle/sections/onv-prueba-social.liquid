{%- comment -%}
  ONYVERA — Sección: Resultados Reales (Estilo UGC / Ollie)
  Tarjetas verticales amplias, separadas y elegantes con fotos de antes/después y ficha de producto inferior.
{%- endcomment -%}

{%- liquid
  assign target_product = section.settings.product
  if target_product == blank
    assign target_product = collections.all.products.first
  endif
  if target_product == blank
    assign target_product = all_products.first
  endif
-%}

<section id="onv-testimonials-{{ section.id }}" class="onv-ugc-results">
  <div class="onv-ugc-results__container">

    <div class="onv-ugc-results__header">
      <span class="onv-ugc-results__badge">{{ section.settings.eyebrow | default: "RESULTADOS REALES" | escape }}</span>
      <h2 class="onv-ugc-results__title">{{ section.settings.title | default: "Resultados de quienes ya lo usan" | escape }}</h2>
    </div>

    <!-- Contenedor de Tarjetas UGC en Fila Continua / Grid Espacioso -->
    <div class="onv-ugc-results__slider-wrap">
      <div class="onv-ugc-results__track">

        <!-- Card 1 -->
        <div class="onv-ugc-card">
          <div class="onv-ugc-card__media">
            <span class="onv-ugc-card__badge-tag">ANTES & DESPUÉS</span>
            <img
              src="{{ 'onv-antes-y-despues-1.png' | asset_url }}"
              alt="Resultado Antes y Después 1"
              class="onv-ugc-card__img"
              width="320"
              height="420"
              loading="lazy"
            >
          </div>
          <div class="onv-ugc-card__pill">
            <div class="onv-ugc-card__pill-left">
              <img src="{{ 'onv-producto-frasco.png' | asset_url }}" alt="ONYVERA 1 Frasco" class="onv-ugc-card__thumb" width="30" height="42" loading="lazy">
              <div class="onv-ugc-card__info">
                <span class="onv-ugc-card__name">1 Frasco · 16 ml</span>
                <span class="onv-ugc-card__price">
                  {%- if target_product.variants[0] != blank -%}
                    {{ target_product.variants[0].price | money }}
                  {%- else -%}
                    $10.00
                  {%- endif -%}
                </span>
              </div>
            </div>
            <button
              type="button"
              class="onv-ugc-card__btn"
              data-onv-add
              data-variant-id="{{ target_product.variants[0].id | default: '' }}"
              aria-label="Agregar 1 frasco al carrito"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            </button>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="onv-ugc-card">
          <div class="onv-ugc-card__media">
            <span class="onv-ugc-card__badge-tag">ANTES & DESPUÉS</span>
            <img
              src="{{ 'onv-antes-y-despues-2.png' | asset_url }}"
              alt="Resultado Antes y Después 2"
              class="onv-ugc-card__img"
              width="320"
              height="420"
              loading="lazy"
            >
          </div>
          <div class="onv-ugc-card__pill">
            <div class="onv-ugc-card__pill-left">
              <img src="{{ 'onv-producto-frasco-2.png' | asset_url }}" alt="ONYVERA 2 Frascos" class="onv-ugc-card__thumb" width="30" height="42" loading="lazy">
              <div class="onv-ugc-card__info">
                <span class="onv-ugc-card__name">Pack 2 Frascos (Ahorro)</span>
                <span class="onv-ugc-card__price">
                  {%- if target_product.variants[1] != blank -%}
                    {{ target_product.variants[1].price | money }}
                  {%- else -%}
                    $18.00
                  {%- endif -%}
                </span>
              </div>
            </div>
            <button
              type="button"
              class="onv-ugc-card__btn"
              data-onv-add
              data-variant-id="{{ target_product.variants[1].id | default: '' }}"
              aria-label="Agregar pack 2 frascos al carrito"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            </button>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="onv-ugc-card">
          <div class="onv-ugc-card__media">
            <span class="onv-ugc-card__badge-tag">ANTES & DESPUÉS</span>
            <img
              src="{{ 'onv-antes-y-despues-3.png' | asset_url }}"
              alt="Resultado Antes y Después 3"
              class="onv-ugc-card__img"
              width="320"
              height="420"
              loading="lazy"
            >
          </div>
          <div class="onv-ugc-card__pill">
            <div class="onv-ugc-card__pill-left">
              <img src="{{ 'onv-producto-frasco-3.png' | asset_url }}" alt="ONYVERA 3 Frascos" class="onv-ugc-card__thumb" width="30" height="42" loading="lazy">
              <div class="onv-ugc-card__info">
                <span class="onv-ugc-card__name">Pack 3 Frascos (45 Días)</span>
                <span class="onv-ugc-card__price">
                  {%- if target_product.variants[2] != blank -%}
                    {{ target_product.variants[2].price | money }}
                  {%- else -%}
                    $25.00
                  {%- endif -%}
                </span>
              </div>
            </div>
            <button
              type="button"
              class="onv-ugc-card__btn"
              data-onv-add
              data-variant-id="{{ target_product.variants[2].id | default: '' }}"
              aria-label="Agregar pack 3 frascos al carrito"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            </button>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

{% style %}
  .onv-ugc-results {
    background-color: #ffffff;
    padding: 32px 0 28px;
    color: var(--onv-green-900);
    overflow: hidden;
    position: relative;
  }

  .onv-ugc-results__container {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 16px;
    box-sizing: border-box;
  }

  .onv-ugc-results__header {
    text-align: center;
    padding: 0 16px;
    margin-bottom: 24px;
  }

  .onv-ugc-results__badge {
    display: inline-block;
    font-family: var(--onv-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--onv-teal-600);
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .onv-ugc-results__title {
    font-family: var(--onv-display);
    font-size: clamp(22px, 3.2vw, 32px);
    font-weight: 600;
    line-height: 1.15;
    margin: 0;
    color: var(--onv-green-900);
  }

  .onv-ugc-results__slider-wrap {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 8px 0 16px;
  }

  .onv-ugc-results__slider-wrap::-webkit-scrollbar {
    display: none;
  }

  .onv-ugc-results__track {
    display: flex;
    gap: 24px;
    justify-content: center;
    align-items: stretch;
  }

  .onv-ugc-card {
    flex: 0 0 290px;
    width: 290px;
    scroll-snap-align: center;
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid rgba(19, 46, 35, 0.08);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 6px 20px rgba(19, 46, 35, 0.08);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .onv-ugc-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(19, 46, 35, 0.13);
  }

  .onv-ugc-card__media {
    position: relative;
    width: 100%;
    height: 340px;
    overflow: hidden;
    background: #f4f6f5;
  }

  .onv-ugc-card__badge-tag {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(19, 46, 35, 0.85);
    backdrop-filter: blur(6px);
    color: #ffffff;
    font-family: var(--onv-body);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 4px 9px;
    border-radius: 999px;
    z-index: 2;
  }

  .onv-ugc-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .onv-ugc-card:hover .onv-ugc-card__img {
    transform: scale(1.04);
  }

  .onv-ugc-card__pill {
    padding: 12px 14px;
    background: #ffffff;
    border-top: 1px solid rgba(19, 46, 35, 0.06);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .onv-ugc-card__pill-left {
    display: flex;
    align-items: center;
    gap: 10px;
    overflow: hidden;
  }

  .onv-ugc-card__thumb {
    width: 30px;
    height: 42px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .onv-ugc-card__info {
    display: flex;
    flex-direction: column;
    gap: 1px;
    overflow: hidden;
  }

  .onv-ugc-card__name {
    font-family: var(--onv-body);
    font-size: 11.5px;
    font-weight: 700;
    color: var(--onv-green-900);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .onv-ugc-card__price {
    font-family: var(--onv-body);
    font-size: 13px;
    font-weight: 800;
    color: var(--onv-teal-600);
  }

  .onv-ugc-card__btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #132E23;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .onv-ugc-card__btn:hover {
    background: #2C6E56;
    transform: scale(1.08);
  }

  .onv-ugc-card__btn svg {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 749px) {
    .onv-ugc-results__slider-wrap {
      padding-left: 16px;
      padding-right: 16px;
    }
    .onv-ugc-results__track {
      justify-content: flex-start;
      gap: 14px;
      padding-right: 16px;
    }
    .onv-ugc-card {
      flex: 0 0 250px;
      width: 250px;
    }
    .onv-ugc-card__media {
      height: 300px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "ONV Prueba Social UGC",
  "tag": "section",
  "class": "section-onv-ugc-results",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "RESULTADOS REALES"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Resultados de quienes ya lo usan"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto para vincular variantes y precios"
    }
  ],
  "presets": [
    {
      "name": "ONV Prueba Social UGC"
    }
  ]
}
{% endschema %}
