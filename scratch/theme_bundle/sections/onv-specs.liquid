{%- comment -%}
  ONYVERA — Sección: Los favoritos del público (Estilo Rhode Skin)
  Tarjetas minimalistas y prémium con fondo gris suave, tipografía gruesa superior, imagen centrada y ficha inferior con precio.
  Se ha eliminado por completo el bloque de ficha técnica.
{%- endcomment -%}

{%- liquid
  assign target_product = section.settings.product
  if target_product == blank
    assign target_product = collections.all.products.first
  endif
  if target_product == blank
    assign target_product = all_products.first
  endif
-%}

<section id="onv-specs-{{ section.id }}" class="onv-rhode-favorites">
  <div class="onv-rhode-favorites__container">

    <!-- Encabezado -->
    <div class="onv-rhode-favorites__header">
      <h2 class="onv-rhode-favorites__title">{{ section.settings.title | default: "Los favoritos del público" | escape }}</h2>
    </div>

    <!-- Grid / Slider de Tarjetas Estilo Rhode -->
    <div class="onv-rhode-favorites__slider-wrap">
      <div class="onv-rhode-favorites__grid">

        <!-- Card 1: 1 Frasco -->
        <article class="onv-rhode-card" data-onv-add data-variant-id="{{ target_product.variants[0].id | default: '' }}" tabindex="0" role="button" aria-label="Comprar 1 Frasco 16ml">
          <div class="onv-rhode-card__top">
            <span class="onv-rhode-card__big-label">1 frasco</span>
          </div>
          
          <div class="onv-rhode-card__img-wrap">
            <img
              src="{{ 'onv-producto-frasco.png' | asset_url }}"
              alt="ONYVERA 1 Frasco 16ml"
              class="onv-rhode-card__img"
              width="240"
              height="280"
              loading="lazy"
            >
          </div>

          <div class="onv-rhode-card__bottom">
            <div class="onv-rhode-card__bottom-left">
              <h3 class="onv-rhode-card__name">1 FRASCO · 16 ML</h3>
              <p class="onv-rhode-card__desc">Tratamiento inicial 2-3 semanas</p>
            </div>
            <div class="onv-rhode-card__bottom-right">
              <span class="onv-rhode-card__price">
                {%- if target_product.variants[0] != blank -%}
                  {{ target_product.variants[0].price | money }}
                {%- else -%}
                  $10.00
                {%- endif -%}
              </span>
            </div>
          </div>
        </article>

        <!-- Card 2: 2 Frascos -->
        <article class="onv-rhode-card" data-onv-add data-variant-id="{{ target_product.variants[1].id | default: '' }}" tabindex="0" role="button" aria-label="Comprar Pack 2 Frascos 32ml">
          <div class="onv-rhode-card__top">
            <span class="onv-rhode-card__big-label">2 frascos</span>
            <span class="onv-rhode-card__badge-pill">ahorro</span>
          </div>
          
          <div class="onv-rhode-card__img-wrap">
            <img
              src="{{ 'onv-producto-frasco-2.png' | asset_url }}"
              alt="ONYVERA Pack 2 Frascos 32ml"
              class="onv-rhode-card__img"
              width="240"
              height="280"
              loading="lazy"
            >
          </div>

          <div class="onv-rhode-card__bottom">
            <div class="onv-rhode-card__bottom-left">
              <h3 class="onv-rhode-card__name">PACK 2 FRASCOS</h3>
              <p class="onv-rhode-card__desc">Uso continuo para 4 a 6 semanas</p>
            </div>
            <div class="onv-rhode-card__bottom-right">
              <span class="onv-rhode-card__price">
                {%- if target_product.variants[1] != blank -%}
                  {{ target_product.variants[1].price | money }}
                {%- else -%}
                  $18.00
                {%- endif -%}
              </span>
            </div>
          </div>
        </article>

        <!-- Card 3: 3 Frascos -->
        <article class="onv-rhode-card" data-onv-add data-variant-id="{{ target_product.variants[2].id | default: '' }}" tabindex="0" role="button" aria-label="Comprar Pack 3 Frascos 48ml">
          <div class="onv-rhode-card__top">
            <span class="onv-rhode-card__big-label">3 frascos</span>
            <span class="onv-rhode-card__badge-pill">más popular</span>
          </div>
          
          <div class="onv-rhode-card__img-wrap">
            <img
              src="{{ 'onv-producto-frasco-3.png' | asset_url }}"
              alt="ONYVERA Pack 3 Frascos 48ml"
              class="onv-rhode-card__img"
              width="240"
              height="280"
              loading="lazy"
            >
          </div>

          <div class="onv-rhode-card__bottom">
            <div class="onv-rhode-card__bottom-left">
              <h3 class="onv-rhode-card__name">PACK 3 FRASCOS</h3>
              <p class="onv-rhode-card__desc">Rutina intensiva de 45 días</p>
            </div>
            <div class="onv-rhode-card__bottom-right">
              <span class="onv-rhode-card__price">
                {%- if target_product.variants[2] != blank -%}
                  {{ target_product.variants[2].price | money }}
                {%- else -%}
                  $25.00
                {%- endif -%}
              </span>
            </div>
          </div>
        </article>

      </div>
    </div>

  </div>
</section>

{% style %}
  .onv-rhode-favorites {
    background-color: #ffffff;
    padding: 36px 0 28px;
    color: var(--onv-green-900);
    overflow: hidden;
  }

  .onv-rhode-favorites__container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .onv-rhode-favorites__header {
    text-align: center;
    margin-bottom: 26px;
  }

  .onv-rhode-favorites__title {
    font-family: var(--onv-display);
    font-size: clamp(24px, 3.2vw, 36px);
    font-weight: 600;
    line-height: 1.1;
    color: var(--onv-green-900);
    margin: 0;
  }

  .onv-rhode-favorites__slider-wrap {
    width: 100%;
  }

  .onv-rhode-favorites__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    width: 100%;
    box-sizing: border-box;
  }

  /* Tarjeta Estilo Rhode */
  .onv-rhode-card {
    background-color: #f5f5f5;
    border-radius: 20px;
    padding: 24px 22px 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 420px;
    cursor: pointer;
    position: relative;
    box-sizing: border-box;
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
    user-select: none;
    border: none;
  }

  .onv-rhode-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
    background-color: #f0f0f0;
  }

  .onv-rhode-card:active {
    transform: scale(0.98);
  }

  /* Cabecera de la Tarjeta */
  .onv-rhode-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 12px;
  }

  .onv-rhode-card__big-label {
    font-family: var(--onv-body);
    font-size: clamp(28px, 2.8vw, 36px);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #4a4a4a;
    line-height: 1;
    text-transform: lowercase;
  }

  .onv-rhode-card__badge-pill {
    font-family: var(--onv-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: #1e1e1e;
    color: #ffffff;
    padding: 4px 9px;
    border-radius: 999px;
    line-height: 1;
  }

  /* Imagen Centrada */
  .onv-rhode-card__img-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px 0 20px;
  }

  .onv-rhode-card__img {
    max-height: 210px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.12));
    transition: transform 0.3s ease;
  }

  .onv-rhode-card:hover .onv-rhode-card__img {
    transform: scale(1.06);
  }

  /* Pie de Tarjeta */
  .onv-rhode-card__bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding-top: 12px;
    border-top: 1px solid rgba(0, 0, 0, 0.04);
  }

  .onv-rhode-card__bottom-left {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .onv-rhode-card__name {
    font-family: var(--onv-body);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #1a1a1a;
    margin: 0;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .onv-rhode-card__desc {
    font-family: var(--onv-body);
    font-size: 12px;
    color: #737373;
    margin: 0;
    line-height: 1.2;
  }

  .onv-rhode-card__bottom-right {
    text-align: right;
    flex-shrink: 0;
  }

  .onv-rhode-card__price {
    font-family: var(--onv-body);
    font-size: 14.5px;
    font-weight: 800;
    color: #1a1a1a;
    letter-spacing: -0.01em;
  }

  /* Responsive Móvil / Tablets */
  @media (max-width: 767px) {
    .onv-rhode-favorites__slider-wrap {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding: 0 16px 12px;
      margin: 0 -20px;
    }

    .onv-rhode-favorites__slider-wrap::-webkit-scrollbar {
      display: none;
    }

    .onv-rhode-favorites__grid {
      display: flex;
      gap: 14px;
      width: max-content;
    }

    .onv-rhode-card {
      flex: 0 0 250px;
      width: 250px;
      min-height: 380px;
      padding: 20px 18px 18px;
      scroll-snap-align: start;
    }

    .onv-rhode-card__big-label {
      font-size: 26px;
    }

    .onv-rhode-card__img {
      max-height: 170px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "ONV Favoritos Rhode",
  "tag": "section",
  "class": "section-onv-rhode-favorites",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Los favoritos del público"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto para vincular variantes y precios"
    }
  ],
  "presets": [
    {
      "name": "ONV Favoritos Rhode"
    }
  ]
}
{% endschema %}
