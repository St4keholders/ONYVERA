{%- comment -%}
  ONYVERA — Snippet: Hojas de Olivo con Movimiento al Desplazar (Scroll Parallax)
  Hojas ubicadas estrictamente en los bordes laterales externos que rotan y flotan al hacer scroll.
{%- endcomment -%}

<div class="onv-leaves-parallax" id="onv-leaves-parallax" aria-hidden="true">

  <!-- Hoja 1: Borde Superior Izquierdo -->
  <div class="onv-leaf-item onv-leaf-item--1" data-speed="0.12" data-rot="0.04">
    <svg viewBox="0 0 160 160" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M10 10 Q 70 70 140 140" stroke="#254B2F" stroke-width="2.5" stroke-linecap="round"/>
      <path d="M25 30 C 5 25, 0 50, 20 65 C 45 50, 40 35, 25 30 Z" fill="#2E5C38" stroke="#1D4026" stroke-width="0.8"/>
      <path d="M55 60 C 40 50, 35 80, 60 95 C 80 80, 75 65, 55 60 Z" fill="#3D6E48" stroke="#254B2F" stroke-width="0.8"/>
      <path d="M95 100 C 75 95, 70 125, 100 140 C 120 125, 115 105, 95 100 Z" fill="#2E5C38" stroke="#1D4026" stroke-width="0.8"/>
      <ellipse cx="42" cy="48" rx="6" ry="9" transform="rotate(-25 42 48)" fill="#6B7F35"/>
      <ellipse cx="80" cy="88" rx="6" ry="9" transform="rotate(20 80 88)" fill="#788F3A"/>
    </svg>
  </div>

  <!-- Hoja 2: Borde Superior Derecho -->
  <div class="onv-leaf-item onv-leaf-item--2" data-speed="-0.15" data-rot="-0.05">
    <svg viewBox="0 0 160 160" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M150 10 Q 90 70 20 130" stroke="#254B2F" stroke-width="2.5" stroke-linecap="round"/>
      <path d="M125 25 C 145 25, 150 50, 130 65 C 110 50, 115 30, 125 25 Z" fill="#3D6E48" stroke="#254B2F" stroke-width="0.8"/>
      <path d="M90 60 C 110 55, 115 80, 95 95 C 75 80, 80 65, 90 60 Z" fill="#2E5C38" stroke="#1D4026" stroke-width="0.8"/>
      <path d="M50 95 C 70 90, 75 120, 50 135 C 30 120, 35 100, 50 95 Z" fill="#3D6E48" stroke="#254B2F" stroke-width="0.8"/>
      <ellipse cx="110" cy="45" rx="6" ry="9" transform="rotate(25 110 45)" fill="#6B7F35"/>
    </svg>
  </div>

  <!-- Hoja 3: Borde Medio Izquierdo -->
  <div class="onv-leaf-item onv-leaf-item--3" data-speed="0.2" data-rot="0.08">
    <svg viewBox="0 0 100 120" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M50 10 C 20 40, 15 80, 50 105 C 85 80, 80 40, 50 10 Z" fill="#2E5C38" stroke="#1D4026" stroke-width="1"/>
      <path d="M50 10 L 50 105" stroke="#1D4026" stroke-width="0.8"/>
      <ellipse cx="65" cy="55" rx="5" ry="8" transform="rotate(30 65 55)" fill="#788F3A"/>
    </svg>
  </div>

  <!-- Hoja 4: Borde Medio Derecho -->
  <div class="onv-leaf-item onv-leaf-item--4" data-speed="-0.18" data-rot="-0.06">
    <svg viewBox="0 0 120 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M15 50 C 45 20, 85 15, 105 50 C 85 85, 45 80, 15 50 Z" fill="#3D6E48" stroke="#254B2F" stroke-width="1"/>
      <path d="M15 50 L 105 50" stroke="#254B2F" stroke-width="0.8"/>
      <ellipse cx="60" cy="30" rx="5" ry="8" transform="rotate(-20 60 30)" fill="#6B7F35"/>
    </svg>
  </div>

  <!-- Hoja 5: Borde Inferior Izquierdo -->
  <div class="onv-leaf-item onv-leaf-item--5" data-speed="0.14" data-rot="0.05">
    <svg viewBox="0 0 140 140" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M10 130 Q 60 80 130 30" stroke="#254B2F" stroke-width="2.2" stroke-linecap="round"/>
      <path d="M30 110 C 15 110, 10 90, 25 75 C 40 85, 35 105, 30 110 Z" fill="#2E5C38" stroke="#1D4026" stroke-width="0.8"/>
      <path d="M65 80 C 50 85, 45 65, 60 50 C 75 60, 70 80, 65 80 Z" fill="#3D6E48" stroke="#254B2F" stroke-width="0.8"/>
      <ellipse cx="45" cy="95" rx="5" ry="8" transform="rotate(-20 45 95)" fill="#6B7F35"/>
    </svg>
  </div>

  <!-- Hoja 6: Borde Inferior Derecho -->
  <div class="onv-leaf-item onv-leaf-item--6" data-speed="-0.16" data-rot="-0.07">
    <svg viewBox="0 0 130 130" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M120 120 Q 70 70 10 20" stroke="#254B2F" stroke-width="2.2" stroke-linecap="round"/>
      <path d="M100 100 C 115 100, 120 80, 105 65 C 90 75, 95 95, 100 100 Z" fill="#3D6E48" stroke="#254B2F" stroke-width="0.8"/>
      <path d="M65 70 C 80 65, 85 45, 70 35 C 55 45, 60 65, 65 70 Z" fill="#2E5C38" stroke="#1D4026" stroke-width="0.8"/>
      <ellipse cx="85" cy="85" rx="5" ry="8" transform="rotate(25 85 85)" fill="#788F3A"/>
    </svg>
  </div>

</div>

<script>
  (function() {
    function initLeavesParallax() {
      const container = document.getElementById('onv-leaves-parallax');
      if (!container) return;
      const leaves = container.querySelectorAll('.onv-leaf-item');
      if (!leaves.length) return;

      let ticking = false;

      function updateLeaves() {
        const scrollY = window.pageYOffset || document.documentElement.scrollTop;
        leaves.forEach(leaf => {
          const speed = parseFloat(leaf.dataset.speed || 0.1);
          const rotSpeed = parseFloat(leaf.dataset.rot || 0.03);
          const yPos = scrollY * speed;
          const rotation = scrollY * rotSpeed;
          leaf.style.transform = `translate3d(0, ${yPos}px, 0) rotate(${rotation}deg)`;
        });
        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(updateLeaves);
          ticking = true;
        }
      }, { passive: true });

      updateLeaves();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLeavesParallax);
    } else {
      initLeavesParallax();
    }
  })();
</script>

{% style %}
  .onv-leaves-parallax {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1; /* Detrás del texto interactivo, visible en los márgenes */
    overflow: hidden;
  }

  .onv-leaf-item {
    position: absolute;
    pointer-events: none;
    will-change: transform;
    filter: drop-shadow(0 4px 10px rgba(19, 46, 35, 0.12));
    opacity: 0.85;
  }

  /* Posicionamiento en bordes laterales para no chocar con el centro */
  .onv-leaf-item--1 {
    top: 80px;
    left: -25px;
    width: 85px;
  }

  .onv-leaf-item--2 {
    top: 160px;
    right: -25px;
    width: 90px;
  }

  .onv-leaf-item--3 {
    top: 42%;
    left: -20px;
    width: 55px;
  }

  .onv-leaf-item--4 {
    top: 55%;
    right: -20px;
    width: 60px;
  }

  .onv-leaf-item--5 {
    top: 75%;
    left: -25px;
    width: 80px;
  }

  .onv-leaf-item--6 {
    top: 88%;
    right: -25px;
    width: 80px;
  }

  @media (min-width: 750px) {
    .onv-leaf-item--1 { width: 130px; left: 0; }
    .onv-leaf-item--2 { width: 140px; right: 0; }
    .onv-leaf-item--3 { width: 80px; left: 10px; }
    .onv-leaf-item--4 { width: 85px; right: 10px; }
    .onv-leaf-item--5 { width: 120px; left: 0; }
    .onv-leaf-item--6 { width: 120px; right: 0; }
  }
{% endstyle %}
