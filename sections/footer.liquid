{%- comment -%}
  ONYVERA — Footer Global (Diseño Profesional & Balanceado)
  Capa de fondo responsiva, velo verde oscuro regulable, distribución balanceada
  en 2 columnas tanto en desktop como en móvil, y eliminación del marco del descargo.
{%- endcomment -%}

{%- liquid
  assign bg_desktop = section.settings.imagen_desktop
  assign bg_mobile = section.settings.imagen_mobile
  assign velo_opacity = section.settings.opacidad_velo | default: 88
  assign velo_alpha = velo_opacity | divided_by: 100.0
-%}

<footer class="site-footer" id="site-footer">
  <!-- Fondo decorativo con picture (Desktop / Móvil diferido) -->
  <picture class="site-footer__bg" aria-hidden="true">
    {%- if bg_desktop != blank -%}
      <source media="(min-width: 750px)" srcset="{{ bg_desktop | image_url: width: 1920 }}">
    {%- else -%}
      <source media="(min-width: 750px)" srcset="{{ 'onv-footer.jpg' | asset_url }}">
    {%- endif -%}

    {%- if bg_mobile != blank -%}
      <img
        src="{{ bg_mobile | image_url: width: 1400 }}"
        alt=""
        width="1400"
        height="1400"
        loading="lazy"
        decoding="async"
      >
    {%- else -%}
      <img
        src="{{ 'onv-footerphone.jpg' | asset_url }}"
        alt=""
        width="1400"
        height="1400"
        loading="lazy"
        decoding="async"
      >
    {%- endif -%}
  </picture>

  <!-- Contenido Principal del Footer -->
  <div class="site-footer__inner">

    <!-- BLOQUE SUPERIOR (Marca + Columnas) -->
    <div class="site-footer__top">

      <!-- Marca y Tagline -->
      <div class="site-footer__brand-block">
        <a href="/" class="site-footer__brand" aria-label="ONYVERA Inicio">
          {{ section.settings.wordmark | default: "ONYVERA" }}
        </a>
        <p class="site-footer__tagline">
          {{ section.settings.tagline | default: "Fórmula botánica con brocha de precisión para el cuidado diario de uñas y cutículas." | escape }}
        </p>
      </div>

      <!-- Columnas de Enlaces (2 columnas organizadas) -->
      <div class="site-footer__nav-grid">
        
        <!-- Columna A: Navegación -->
        <div class="site-footer__nav-col">
          <h3 class="site-footer__col-heading">NAVEGACIÓN</h3>
          <ul class="site-footer__link-list">
            <li><a href="/" class="site-footer__link">Inicio</a></li>
            <li><a href="/#onv-routine" class="site-footer__link">Cómo Aplicar</a></li>
            <li><a href="/#onv-progress" class="site-footer__link">Rutina 4 Semanas</a></li>
            <li><a href="/#onv-specs" class="site-footer__link">Ingredientes</a></li>
            <li><a href="/#onv-bundles" class="site-footer__link">Formatos & Precios</a></li>
          </ul>
        </div>

        <!-- Columna B: Información Legal -->
        <div class="site-footer__nav-col">
          <h3 class="site-footer__col-heading">INFORMACIÓN LEGAL</h3>
          <ul class="site-footer__link-list">
            {%- if shop.privacy_policy != blank -%}
              <li><a href="{{ shop.privacy_policy.url }}" class="site-footer__link">Privacidad</a></li>
            {%- else -%}
              <li><a href="/policies/privacy-policy" class="site-footer__link">Privacidad</a></li>
            {%- endif -%}

            {%- if shop.terms_of_service != blank -%}
              <li><a href="{{ shop.terms_of_service.url }}" class="site-footer__link">Términos de Servicio</a></li>
            {%- else -%}
              <li><a href="/policies/terms-of-service" class="site-footer__link">Términos de Servicio</a></li>
            {%- endif -%}

            {%- if shop.shipping_policy != blank -%}
              <li><a href="{{ shop.shipping_policy.url }}" class="site-footer__link">Envíos</a></li>
            {%- else -%}
              <li><a href="/policies/shipping-policy" class="site-footer__link">Envíos</a></li>
            {%- endif -%}

            {%- if shop.refund_policy != blank -%}
              <li><a href="{{ shop.refund_policy.url }}" class="site-footer__link">Reembolsos</a></li>
            {%- else -%}
              <li><a href="/policies/refund-policy" class="site-footer__link">Reembolsos</a></li>
            {%- endif -%}
          </ul>
        </div>

      </div>

    </div>

    <!-- Línea Divisoria -->
    <hr class="site-footer__divider" aria-hidden="true">

    <!-- BLOQUE INFERIOR (Corporativo, Descargo sin marco, Copyright) -->
    <div class="site-footer__bottom">
      <p class="site-footer__corp">
        {{ section.settings.linea_corporativa | default: "ONYVERA — Vitaherb International LLC · Orlando, FL · EE. UU." | escape }}
      </p>

      <!-- Descargo Regulatorio sin marco/caja -->
      <p class="site-footer__disclaimer-text">
        *Este producto es un cosmético botánico para el cuidado y embellecimiento de uñas y cutículas. No está destinado a diagnosticar, tratar, curar ni prevenir ninguna enfermedad.
      </p>

      <p class="site-footer__copy">
        © {{ 'now' | date: '%Y' }} ONYVERA. Todos los derechos reservados.
      </p>
    </div>

  </div>
</footer>

{% style %}
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    box-sizing: border-box;
  }

  .site-footer__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .site-footer__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    display: block;
  }

  /* Velo verde oscuro con opacidad regulable */
  .site-footer::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: rgba(27, 58, 47, {{ velo_alpha }});
    pointer-events: none;
  }

  .site-footer__inner {
    position: relative;
    z-index: 2;
    max-width: 1100px;
    margin-inline: auto;
    padding: 52px 24px 36px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  /* Bloque Superior (Grid Desktop) */
  .site-footer__top {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 56px;
    align-items: start;
    width: 100%;
    box-sizing: border-box;
  }

  /* 1. Wordmark & Tagline */
  .site-footer__brand-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .site-footer__brand {
    font-family: var(--font-display, "Playfair Display", Georgia, serif) !important;
    font-weight: 600 !important;
    font-size: 28px !important;
    letter-spacing: 0.06em;
    color: #F6F2E9 !important;
    text-decoration: none;
    margin-bottom: 10px;
    display: inline-block;
    transition: opacity 0.2s ease;
  }

  .site-footer__brand:hover {
    opacity: 0.88;
  }

  .site-footer__tagline {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 400 !important;
    font-size: 14px !important;
    line-height: 1.55 !important;
    color: #E6E0D2 !important;
    max-width: 38ch;
    margin: 0;
  }

  /* 2. Columnas de Enlaces */
  .site-footer__nav-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
    width: 100%;
    text-align: left;
    box-sizing: border-box;
  }

  .site-footer__col-heading {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 700 !important;
    font-size: 13px !important;
    text-transform: uppercase !important;
    letter-spacing: 0.12em !important;
    color: #D9BC85 !important; /* Contraste verificado AA */
    margin: 0 0 14px 0 !important;
  }

  .site-footer__link-list {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .site-footer__link-list li {
    margin-bottom: 8px;
  }

  .site-footer__link-list li:last-child {
    margin-bottom: 0;
  }

  .site-footer__link {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 400 !important;
    font-size: 14px !important;
    color: #F6F2E9 !important;
    text-decoration: none;
    display: inline-block;
    transition: text-decoration 0.2s ease, opacity 0.2s ease;
  }

  .site-footer__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .site-footer__link:focus-visible {
    outline: 2px solid #D9BC85;
    outline-offset: 3px;
  }

  /* 3. Línea Divisoria */
  .site-footer__divider {
    width: 100%;
    height: 1px;
    background-color: rgba(246, 242, 233, 0.14);
    border: none;
    margin: 36px 0 24px 0;
  }

  /* 4. Bloque Inferior */
  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    width: 100%;
  }

  .site-footer__corp {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 500 !important;
    font-size: 12.5px !important;
    letter-spacing: 0.03em !important;
    color: #E6E0D2 !important;
    margin: 0;
  }

  /* Descargo limpio sin recuadro ni marco */
  .site-footer__disclaimer-text {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 400 !important;
    font-size: 11.5px !important;
    line-height: 1.5 !important;
    color: rgba(246, 242, 233, 0.72) !important;
    max-width: 68ch;
    margin: 0 auto;
    background: none !important;
    border: none !important;
    padding: 0 !important;
  }

  /* Copyright */
  .site-footer__copy {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 400 !important;
    font-size: 12px !important;
    color: rgba(246, 242, 233, 0.55) !important;
    margin: 4px 0 0 0;
  }

  /* Layout Móvil (< 750px) */
  @media (max-width: 749px) {
    .site-footer__inner {
      padding: 38px 20px 24px;
    }

    .site-footer__top {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 28px;
    }

    .site-footer__brand-block {
      align-items: center;
      text-align: center;
    }

    .site-footer__brand {
      font-size: 24px !important;
      margin-bottom: 6px;
    }

    .site-footer__tagline {
      font-size: 13px !important;
      max-width: 32ch;
      margin: 0 auto;
    }

    /* En móvil: 2 columnas lado a lado en vez de listado vertical interminable */
    .site-footer__nav-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px 20px;
      max-width: 340px;
      margin: 0 auto;
      text-align: left;
    }

    .site-footer__col-heading {
      font-size: 11.5px !important;
      margin: 0 0 10px 0 !important;
    }

    .site-footer__link-list li {
      margin-bottom: 6px;
    }

    .site-footer__link {
      font-size: 13px !important;
      padding-block: 4px;
    }

    .site-footer__divider {
      margin: 24px 0 18px 0;
    }

    .site-footer__corp {
      font-size: 11.5px !important;
    }

    .site-footer__disclaimer-text {
      font-size: 10.5px !important;
      line-height: 1.45 !important;
      max-width: 100%;
    }

    .site-footer__copy {
      font-size: 11px !important;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Footer global ONYVERA",
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark / Marca",
      "default": "ONYVERA"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Fórmula botánica con brocha de precisión para el cuidado diario de uñas y cutículas."
    },
    {
      "type": "image_picker",
      "id": "imagen_desktop",
      "label": "Imagen de fondo Desktop"
    },
    {
      "type": "image_picker",
      "id": "imagen_mobile",
      "label": "Imagen de fondo Móvil"
    },
    {
      "type": "range",
      "id": "opacidad_velo",
      "min": 70,
      "max": 95,
      "step": 1,
      "unit": "%",
      "label": "Opacidad del velo verde",
      "default": 88
    },
    {
      "type": "text",
      "id": "linea_corporativa",
      "label": "Línea Corporativa",
      "default": "ONYVERA — Vitaherb International LLC · Orlando, FL · EE. UU."
    }
  ]
}
{% endschema %}
