{%- comment -%}
  ONYVERA — Plantilla de Producto (PDP)
  Layout dos columnas con galería sticky (riel vertical de miniaturas a la izquierda) y buy box densa.
  Totalmente en español, acordeones nativos, selector de paquetes tipo radio-card y microinteracciones fluidas.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign compare_at_price = current_variant.compare_at_price
  assign price = current_variant.price
  assign is_discounted = false
  if compare_at_price > price
    assign is_discounted = true
    assign discount_amount = compare_at_price | minus: price
    assign discount_percent = discount_amount | times: 100.0 | divided_by: compare_at_price | round
  endif

  assign cart_item_count = 0
  for item in cart.items
    if item.product_id == product.id
      assign cart_item_count = cart_item_count | plus: item.quantity
    endif
  endfor
-%}

<section id="onv-pdp-{{ section.id }}" class="onv-pdp-section" data-section-id="{{ section.id }}">
  <div class="onv-pdp__container">

    <!-- 2. BREADCRUMB -->
    {%- if section.settings.mostrar_breadcrumb -%}
      <nav class="onv-pdp__breadcrumb" aria-label="Ruta de navegación">
        <ol class="onv-pdp__breadcrumb-list">
          <li class="onv-pdp__breadcrumb-item">
            <a href="/" class="onv-pdp__breadcrumb-link">Inicio</a>
          </li>
          <li class="onv-pdp__breadcrumb-sep" aria-hidden="true">›</li>
          <li class="onv-pdp__breadcrumb-item">
            {%- if collection -%}
              <a href="{{ collection.url }}" class="onv-pdp__breadcrumb-link">{{ collection.title | escape }}</a>
            {%- else -%}
              <a href="/collections/all" class="onv-pdp__breadcrumb-link">Catálogo</a>
            {%- endif -%}
          </li>
          <li class="onv-pdp__breadcrumb-sep" aria-hidden="true">›</li>
          <li class="onv-pdp__breadcrumb-item onv-pdp__breadcrumb-item--current" aria-current="page">
            {{ product.title | escape }}
          </li>
        </ol>
      </nav>

      <!-- Schema JSON-LD BreadcrumbList -->
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Inicio",
              "item": "{{ shop.url }}"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Catálogo",
              "item": "{{ shop.url }}/collections/all"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ product.title | json }},
              "item": "{{ shop.url }}{{ product.url }}"
            }
          ]
        }
      </script>
    {%- endif -%}

    <!-- GRID PRINCIPAL (GALERÍA + BUY BOX) -->
    <div class="onv-pdp__grid">

      <!-- 3. COLUMNA IZQUIERDA — GALERÍA (ESTILO MARKETPLACE) -->
      <div class="onv-pdp__gallery{% if section.settings.galeria_sticky %} onv-pdp__gallery--sticky{% endif %}">
        <div class="onv-gallery">

          {%- liquid
            assign gallery_images = 'onv-producto1.jpeg,onv-producto2.jpeg,onv-producto3.jpeg,onv-producto4.jpeg,onv-producto5.jpeg,onv-producto6.jpeg,onv-producto7.jpeg,onv-producto8.jpeg' | split: ','
          -%}

          <!-- Riel Vertical de Miniaturas (Estilo Mercado Libre) -->
          <div class="pdp-thumbs-wrapper">
            <ul class="pdp-thumbs" id="PdpThumbsList" aria-label="Miniaturas del producto">
              {%- for img_file in gallery_images -%}
                {%- assign img_src = img_file | asset_url -%}
                <li class="pdp-thumbs__item{% if forloop.index > 6 %} pdp-thumbs__item--extra is-hidden-desktop{% endif %}" data-index="{{ forloop.index0 }}">
                  <button
                    type="button"
                    class="pdp-thumbs__btn{% if forloop.first %} is-active{% endif %}"
                    data-index="{{ forloop.index0 }}"
                    data-full-src="{{ img_src }}"
                    data-alt="ONYVERA Sérum Botánico - Vista {{ forloop.index }}"
                    aria-label="Ver imagen {{ forloop.index }} de {{ gallery_images.size }}"
                  >
                    <img
                      src="{{ img_src }}"
                      alt="ONYVERA Sérum Botánico - Vista {{ forloop.index }}"
                      class="pdp-thumbs__img"
                      width="76"
                      height="76"
                      loading="lazy"
                    >
                  </button>
                </li>
              {%- endfor -%}
            </ul>

            {%- if gallery_images.size > 6 -%}
              <button type="button" class="pdp-thumbs__more-btn" id="PdpMoreImagesBtn" aria-label="Ver más imágenes">
                <span id="PdpMoreBtnText">Más imágenes</span>
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
            {%- endif -%}
          </div>

          <!-- Imagen Principal Grande con Flechas de Navegación -->
          <div class="pdp-main" id="PdpMainContainer">
            <!-- Flecha Anterior -->
            <button type="button" class="pdp-main__nav pdp-main__nav--prev" id="PdpNavPrev" aria-label="Imagen anterior">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
            </button>

            <!-- Flecha Siguiente -->
            <button type="button" class="pdp-main__nav pdp-main__nav--next" id="PdpNavNext" aria-label="Siguiente imagen">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </button>

            <img
              id="PdpMainImage-{{ section.id }}"
              src="{{ gallery_images.first | asset_url }}"
              alt="{{ product.title | default: 'ONYVERA Sérum Botánico para Uñas' | escape }}"
              class="pdp-main__img"
              width="1080"
              height="1080"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            >

            <!-- Botón de Zoom (Abre Lightbox) -->
            <button
              type="button"
              class="pdp-main__zoom-btn"
              id="PdpZoomBtn-{{ section.id }}"
              aria-label="Ampliar imagen"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#1B3A2F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 3 21 3 21 9"></polyline>
                <polyline points="9 21 3 21 3 15"></polyline>
                <line x1="21" y1="3" x2="14" y2="10"></line>
                <line x1="3" y1="21" x2="10" y2="14"></line>
              </svg>
            </button>
          </div>

        </div>
      </div>

      <!-- 4. COLUMNA DERECHA — BUY BOX -->
      <div class="onv-pdp__buybox">

        <!-- 4.1 Marca -->
        <span class="pdp-brand">{{ product.vendor | default: "VITAHERB INTERNATIONAL LLC" | escape }}</span>

        <!-- 4.2 Título -->
        <h1 class="pdp-title">{{ product.title | escape }}</h1>

        <!-- 4.3 Estrellas + Conteo de Reseñas (Con Gate obligatorio) -->
        {%- if section.settings.usar_resenas_prueba or product.metafields.reviews.rating.value != blank -%}
          <div class="pdp-reviews-row">
            <div class="pdp-stars" aria-label="Calificación de 4.8 sobre 5 estrellas">
              <svg class="pdp-star pdp-star--filled" viewBox="0 0 24 24" fill="#C6A264" width="15" height="15" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg class="pdp-star pdp-star--filled" viewBox="0 0 24 24" fill="#C6A264" width="15" height="15" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg class="pdp-star pdp-star--filled" viewBox="0 0 24 24" fill="#C6A264" width="15" height="15" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg class="pdp-star pdp-star--filled" viewBox="0 0 24 24" fill="#C6A264" width="15" height="15" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg class="pdp-star pdp-star--filled" viewBox="0 0 24 24" fill="#C6A264" width="15" height="15" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <a href="#onv-reviews" class="pdp-reviews-count">4.8 · 23 reseñas</a>
          </div>
        {%- endif -%}

        <!-- 4.4 Precio y Descuento Dinámicos -->
        <div class="pdp-price-wrap" id="PdpPriceWrap-{{ section.id }}">
          <div class="pdp-price-row">
            <span class="pdp-price" id="PdpCurrentPrice-{{ section.id }}">$25.00</span>
            <s class="pdp-price-compare" id="PdpComparePrice-{{ section.id }}" style="display: none;"></s>
            <span class="pdp-discount-badge" id="PdpDiscountBadge-{{ section.id }}" style="display: none;"></span>
          </div>
          <span class="pdp-tax-note">Impuestos incluidos. Envío calculado en el checkout.</span>
        </div>

        <!-- Formulario Principal de Producto -->
        {%- form 'product', product, id: 'PdpProductForm', class: 'pdp-form' -%}
          <input type="hidden" name="id" id="PdpSelectedVariantId" value="{{ current_variant.id }}">

          <!-- 4.5 Chips de Especificación -->
          <div class="pdp-chips-block">
            <span class="pdp-block-label">En cada frasco de 16 ml:</span>
            <div class="pdp-chips-wrap">
              {%- for block in section.blocks -%}
                {%- if block.type == 'chip' -%}
                  <div class="pdp-chip" {{ block.shopify_attributes }}>
                    {%- case block.settings.icono -%}
                      {%- when 'hoja' -%}
                        <svg class="pdp-chip__icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#2F7A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                      {%- when 'calendario' -%}
                        <svg class="pdp-chip__icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#2F7A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                      {%- when 'brocha' -%}
                        <svg class="pdp-chip__icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#2F7A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 12-8.5 8.5a2.12 2.12 0 1 1-3-3L11 9"/><path d="M18 10l-4-4"/><path d="M14 6l2-2a2.83 2.83 0 1 1 4 4l-2 2"/></svg>
                      {%- when 'escudo' -%}
                        <svg class="pdp-chip__icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#2F7A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                      {%- when 'conejo' -%}
                        <svg class="pdp-chip__icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#2F7A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 16a3 3 0 0 1-6 0c0-1.5 1-3 3-3s3 1.5 3 3z"/><path d="M10 13V3.5a2.5 2.5 0 0 0-5 0V13"/><path d="M14 13V5.5a2.5 2.5 0 0 1 5 0V13"/><path d="M18 14a4 4 0 0 1-8 0"/></svg>
                    {%- endcase -%}
                    <span>{{ block.settings.texto | escape }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          <!-- 4.6 Selector de Paquete (Radio Cards) -->
          {%- if product.variants.size > 1 -%}
            <div class="pdp-bundle-block">
              <span class="pdp-block-label">Paquete</span>
              <div class="pdp-bundle-grid">
                {%- for variant in product.variants -%}
                  {%- liquid
                    assign is_selected = false
                    if forloop.first
                      assign is_selected = true
                    endif

                    assign duration_label = "2 a 3 semanas"
                    assign bundle_target_qty = 1
                    assign bundle_display_price = "$25.00"
                    if forloop.index == 2
                      assign duration_label = "4 a 6 semanas"
                      assign bundle_target_qty = 2
                      assign bundle_display_price = "$50.00"
                    elsif forloop.index == 3
                      assign duration_label = "Tratamiento intensivo"
                      assign bundle_target_qty = 3
                      assign bundle_display_price = "$60.00"
                    endif
                  -%}

                  <div class="pdp-bundle-card{% if is_selected %} is-selected{% endif %}{% unless variant.available %} is-disabled{% endunless %}">
                    {%- if forloop.index == 2 -%}
                      <span class="pdp-bundle-badge">MÁS POPULAR</span>
                    {%- endif -%}

                    <input
                      type="radio"
                      id="Variant-{{ variant.id }}"
                      name="bundle_radio"
                      value="{{ variant.id }}"
                      class="pdp-bundle__input"
                      data-qty="{{ bundle_target_qty }}"
                      data-price="{{ bundle_display_price }}"
                      data-available="{{ variant.available }}"
                      {% if is_selected %}checked{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                    >
                    <label for="Variant-{{ variant.id }}" class="pdp-bundle__label">
                      {%- assign bundle_name_clean = variant.title | replace: 'Bottles', 'Frascos' | replace: 'Bottle', 'Frasco' | escape -%}
                      <span class="pdp-bundle__name">{{ bundle_name_clean }}</span>
                      <span class="pdp-bundle__duration">{{ duration_label }}</span>
                      <span class="pdp-bundle__price">
                        {%- if variant.available -%}
                          {{ bundle_display_price }}
                        {%- else -%}
                          Agotado
                        {%- endif -%}
                      </span>
                    </label>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <!-- 4.7 Cantidad + Indicador de Compra al por Mayor -->
          <div class="pdp-qty-block">
            <span class="pdp-block-label">Cantidad</span>
            <div class="pdp-qty-row">
              <div class="pdp-qty-stepper">
                <button type="button" class="pdp-qty-btn" id="PdpQtyMinus" aria-label="Disminuir cantidad">−</button>
                <input
                  type="number"
                  name="quantity"
                  id="PdpQuantityInput"
                  value="1"
                  min="1"
                  inputmode="numeric"
                  class="pdp-qty-input"
                  aria-label="Cantidad de unidades"
                >
                <button type="button" class="pdp-qty-btn" id="PdpQtyPlus" aria-label="Aumentar cantidad">+</button>
              </div>

              <!-- Indicador de Compra al por Mayor (Siempre Visible) -->
              <div class="pdp-wholesale-indicator" id="PdpWholesaleIndicator">
                <span class="pdp-wholesale-badge">10 unidades — producto al por mayor</span>
              </div>

              {%- if cart_item_count > 0 -%}
                <span class="pdp-cart-count-note">({{ cart_item_count }} en el carrito)</span>
              {%- endif -%}
            </div>
          </div>

          <!-- 4.8 Botones de Acción (Checkout y Redirección a WhatsApp) -->
          <div class="pdp-actions" id="PdpActionsContainer">
            <!-- Botón normal Agregar al Carrito -->
            <button
              type="submit"
              name="add"
              id="PdpAddToCartBtn"
              class="pdp-btn pdp-btn--primary"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span id="PdpAddToCartText">
                {%- if current_variant.available -%}
                  Agregar al carrito
                {%- else -%}
                  Agotado
                {%- endif -%}
              </span>
            </button>

            <!-- Checkout Dinámico -->
            {%- if current_variant.available -%}
              <div class="pdp-dynamic-checkout" id="PdpDynamicCheckoutWrap">
                {{ form | payment_button }}
              </div>
            {%- endif -%}

            <!-- Botón de Contacto por WhatsApp (Visible a partir de 10 unidades) -->
            <a
              href="#"
              id="PdpWhatsAppBtn"
              class="pdp-btn pdp-btn--whatsapp is-hidden"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Hablar con un asesor por WhatsApp para pedido al por mayor"
            >
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span>Hablar con un asesor por WhatsApp</span>
            </a>
          </div>

        {%- endform -%}

        <!-- 4.9 Filas de Confianza -->
        <ul class="pdp-trust-rows">
          {%- for block in section.blocks -%}
            {%- if block.type == 'fila_confianza' -%}
              <li class="pdp-trust-row" {{ block.shopify_attributes }}>
                <span class="pdp-trust-row__icon-wrap">
                  {%- case block.settings.icono -%}
                    {%- when 'camion' -%}
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#2F7A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    {%- when 'pin' -%}
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#2F7A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    {%- when 'reloj' -%}
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#2F7A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  {%- endcase -%}
                </span>
                <span class="pdp-trust-row__text">{{ block.settings.texto | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        <!-- 4.10 Caja de Garantía (Solo si setting no está vacío) -->
        {%- if section.settings.texto_garantia != blank -%}
          <div class="pdp-guarantee-box">
            <svg class="pdp-guarantee-box__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#2F7A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <div class="pdp-guarantee-box__content">
              {{ section.settings.texto_garantia }}
            </div>
          </div>
        {%- endif -%}

        <!-- 4.11 Acordeones Nativos -->
        <div class="pdp-accordions">
          {%- for block in section.blocks -%}
            {%- if block.type == 'acordeon' -%}
              <details class="pdp-accordion" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
                <summary class="pdp-accordion__summary">
                  <span class="pdp-accordion__title">{{ block.settings.titulo | escape }}</span>
                  <svg class="pdp-accordion__chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#93A896" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </summary>
                <div class="pdp-accordion__content">
                  {{ block.settings.contenido }}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>

      </div>

    </div>

    <!-- 5. FILA DE PRODUCTOS RELACIONADOS -->
    {%- if section.settings.mostrar_relacionados -%}
      {%- assign rel_collection = collections[section.settings.coleccion_relacionados] | default: collections.all -%}
      {%- if rel_collection and rel_collection.products.size > 0 -%}
        <div class="onv-pdp__related">
          <h2 class="onv-pdp__related-title">Combina perfectamente con…</h2>
          <div class="onv-pdp__related-grid">
            {%- assign count = 0 -%}
            {%- for rel_prod in rel_collection.products -%}
              {%- if rel_prod.id != product.id and count < 4 -%}
                {%- assign count = count | plus: 1 -%}
                <a href="{{ rel_prod.url }}" class="onv-pdp__related-card">
                  <div class="onv-pdp__related-media">
                    <img
                      src="{{ rel_prod.featured_image | image_url: width: 400 }}"
                      alt="{{ rel_prod.title | escape }}"
                      width="400"
                      height="400"
                      loading="lazy"
                    >
                  </div>
                  <h3 class="onv-pdp__related-name">{{ rel_prod.title | escape }}</h3>
                  <span class="onv-pdp__related-price">{{ rel_prod.price | money }}</span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>

  <!-- LIGHTBOX MODAL DE ZOOM -->
  <div id="PdpLightboxModal" class="pdp-lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Vista ampliada del producto">
    <div class="pdp-lightbox__backdrop" id="PdpLightboxBackdrop"></div>
    <div class="pdp-lightbox__content">
      <button type="button" class="pdp-lightbox__close" id="PdpLightboxClose" aria-label="Cerrar modal">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <img id="PdpLightboxImg" src="" alt="{{ product.title | escape }}" class="pdp-lightbox__img">
    </div>
  </div>
</section>

{% style %}
  .onv-pdp-section {
    background-color: #ffffff;
    padding-top: 32px;
    padding-bottom: clamp(4rem, 8vw, 6rem);
    width: 100%;
    box-sizing: border-box;
  }

  .onv-pdp__container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding-inline: 24px;
    box-sizing: border-box;
  }

  /* 2. Breadcrumb */
  .onv-pdp__breadcrumb {
    width: 100%;
    margin-bottom: 24px;
  }

  .onv-pdp__breadcrumb-list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    font-family: var(--font-ui, 'Karla', sans-serif);
    font-weight: 400;
    font-size: 13.5px !important;
    color: #93A896;
  }

  .onv-pdp__breadcrumb-link {
    color: #93A896;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .onv-pdp__breadcrumb-link:hover {
    color: #1B3A2F;
    text-decoration: underline;
  }

  .onv-pdp__breadcrumb-sep {
    margin-inline: 8px;
    color: #93A896;
    user-select: none;
  }

  .onv-pdp__breadcrumb-item--current {
    color: #4A5A52;
  }

  /* Layout 2 Columnas */
  .onv-pdp__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: start;
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 1000px) {
    .onv-pdp__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(400px, 0.9fr);
      gap: 48px;
    }

    .onv-pdp__gallery--sticky {
      position: sticky;
      top: calc(var(--header-height, 80px) + 24px);
    }
  }

  /* 3. Galería (Estilo Marketplace / Mercado Libre) */
  .onv-gallery {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  @media (max-width: 999px) {
    .pdp-main {
      order: 1;
    }
    .pdp-thumbs-wrapper {
      order: 2;
    }
  }

  @media (min-width: 1000px) {
    .onv-gallery {
      flex-direction: row;
      align-items: flex-start;
      gap: 16px;
    }

    .pdp-thumbs-wrapper {
      order: 1;
      width: 64px;
    }

    .pdp-main {
      order: 2;
    }

    .pdp-thumbs {
      flex-direction: column;
      gap: 8px;
      max-height: 440px;
      overflow-y: auto;
      overflow-x: hidden;
      scrollbar-width: thin;
      scrollbar-color: rgba(27, 58, 47, 0.2) transparent;
      padding-right: 2px;
    }

    .pdp-thumbs::-webkit-scrollbar {
      display: block;
      width: 4px;
    }

    .pdp-thumbs::-webkit-scrollbar-thumb {
      background: rgba(27, 58, 47, 0.2);
      border-radius: 4px;
    }

    .pdp-thumbs__item--extra.is-hidden-desktop {
      display: none !important;
    }
  }

  .pdp-thumbs-wrapper {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-shrink: 0;
  }

  .pdp-thumbs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .pdp-thumbs::-webkit-scrollbar {
    display: none;
  }

  .pdp-thumbs__btn {
    width: 64px;
    height: 64px;
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    border: 1px solid #E6E0D2;
    background-color: #FFFFFF;
    cursor: pointer;
    padding: 0;
    display: block;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .pdp-thumbs__btn:hover {
    border-color: #2F7A6B;
    transform: scale(1.03);
  }

  .pdp-thumbs__btn.is-active {
    border: 2px solid #2F7A6B !important;
    box-shadow: 0 2px 10px rgba(47, 122, 107, 0.25);
  }

  .pdp-thumbs__btn:focus-visible {
    outline: 2px solid #2F7A6B;
    outline-offset: 2px;
  }

  .pdp-thumbs__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Botón 'Más imágenes' */
  .pdp-thumbs__more-btn {
    width: 100%;
    padding: 6px 4px;
    background: #F6F2E9;
    border: 1px dashed #C6A264;
    border-radius: 8px;
    font-family: var(--font-ui, 'Karla', sans-serif);
    font-size: 11px;
    font-weight: 700;
    color: #1B3A2F;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .pdp-thumbs__more-btn:hover {
    background: #EAE3D5;
    border-color: #1B3A2F;
  }

  /* Imagen Principal */
  .pdp-main {
    flex: 1 1 auto;
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    background-color: #FFFFFF;
    border: 1px solid rgba(27, 58, 47, 0.08);
    border-radius: 14px;
    padding: 0;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(19, 46, 35, 0.04);
  }

  .pdp-main__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.25s ease;
  }

  /* Flechas de Navegación sobre la Imagen Principal */
  .pdp-main__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    border: 1px solid rgba(27, 58, 47, 0.12);
    color: #1B3A2F;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 6;
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
  }

  .pdp-main__nav:hover {
    background: #FFFFFF;
    color: #2F7A6B;
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
  }

  .pdp-main__nav:active {
    transform: translateY(-50%) scale(0.95);
  }

  .pdp-main__nav--prev {
    left: 14px;
  }

  .pdp-main__nav--next {
    right: 14px;
  }

  .pdp-main__zoom-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 38px;
    height: 38px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(27, 58, 47, 0.12);
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
    transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .pdp-main__zoom-btn:hover {
    background-color: #FFFFFF;
    transform: scale(1.08);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.14);
  }

  /* 4. Buy Box */
  .onv-pdp__buybox {
    display: flex;
    flex-direction: column;
    width: 100%;
    box-sizing: border-box;
  }

  /* 4.1 Marca */
  .pdp-brand {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 700 !important;
    font-size: 13px !important;
    text-transform: uppercase !important;
    letter-spacing: 0.18em !important;
    color: #2F7A6B !important;
    margin-bottom: 10px;
    display: block;
  }

  /* 4.2 Título */
  .pdp-title {
    font-family: var(--font-display, "Playfair Display", Georgia, serif) !important;
    font-weight: 600 !important;
    font-size: clamp(24px, 2.8vw, 34px) !important;
    line-height: 1.15 !important;
    color: #1B3A2F !important;
    margin: 0 0 12px 0 !important;
  }

  /* 4.3 Estrellas + Conteo */
  .pdp-reviews-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
  }

  .pdp-stars {
    display: inline-flex;
    gap: 3px;
    align-items: center;
  }

  .pdp-star {
    width: 16px;
    height: 16px;
  }

  .pdp-reviews-count {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 400 !important;
    font-size: 14px !important;
    color: #4A5A52 !important;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .pdp-reviews-count:hover {
    color: #1B3A2F !important;
    text-decoration: underline;
  }

  /* 4.4 Precios */
  .pdp-price-wrap {
    margin-bottom: 20px;
  }

  .pdp-price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .pdp-price {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 700 !important;
    font-size: 28px !important;
    color: #1B3A2F !important;
  }

  .pdp-price-compare {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 400 !important;
    font-size: 17px !important;
    color: #93A896 !important;
    text-decoration: line-through;
  }

  .pdp-discount-badge {
    background-color: #C0392B;
    color: #FFFFFF !important;
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 700 !important;
    font-size: 12px !important;
    padding: 4px 8px;
    border-radius: 4px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
  }

  .pdp-tax-note {
    display: block;
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 400 !important;
    font-size: 13px !important;
    color: #93A896 !important;
    margin-top: 4px;
  }

  /* Etiquetas de Bloque */
  .pdp-block-label {
    display: block;
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 700 !important;
    font-size: 14.5px !important;
    color: #1B3A2F !important;
    margin-bottom: 10px;
  }

  /* 4.5 Chips de Especificación */
  .pdp-chips-block {
    margin-bottom: 24px;
  }

  .pdp-chips-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pdp-chip {
    background-color: #FFFFFF;
    border: 1px solid #E6E0D2;
    border-radius: 999px;
    padding: 8px 14px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 600 !important;
    font-size: 12px !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    color: #1B3A2F !important;
  }

  .pdp-chip__icon {
    flex-shrink: 0;
    width: 15px;
    height: 15px;
  }

  /* 4.6 Selector de Paquete (Radio Cards) */
  .pdp-bundle-block {
    margin-bottom: 20px;
  }

  .pdp-bundle-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  @media (max-width: 480px) {
    .pdp-bundle-grid {
      grid-template-columns: 1fr;
    }
  }

  .pdp-bundle-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 10px;
    border: 1px solid #E6E0D2;
    background-color: #FFFFFF;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .pdp-bundle-card.is-selected {
    border: 2px solid #1B3A2F !important;
    background-color: #F6F2E9 !important;
  }

  .pdp-bundle-card.is-disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .pdp-bundle__input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .pdp-bundle__input:focus-visible + .pdp-bundle__label {
    outline: 2px solid #2F7A6B;
    outline-offset: 2px;
  }

  .pdp-bundle__label {
    padding: 14px 12px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 100%;
    box-sizing: border-box;
    text-align: left;
  }

  .pdp-bundle__name {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 700 !important;
    font-size: 15px !important;
    color: #1B3A2F !important;
    line-height: 1.2 !important;
  }

  .pdp-bundle__duration {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 400 !important;
    font-size: 13px !important;
    color: #4A5A52 !important;
    line-height: 1.2 !important;
  }

  .pdp-bundle__price {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 700 !important;
    font-size: 16px !important;
    color: #1B3A2F !important;
    margin-top: 4px;
  }

  .pdp-bundle-badge {
    position: absolute;
    top: -9px;
    left: 50%;
    transform: translateX(-50%);
    background-color: #C6A264;
    color: #1B3A2F !important;
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 700 !important;
    font-size: 11px !important;
    padding: 4px 10px;
    border-radius: 4px;
    white-space: nowrap;
    z-index: 2;
    letter-spacing: 0.05em;
  }

  /* 4.7 Cantidad */
  .pdp-qty-block {
    margin-bottom: 16px;
  }

  .pdp-qty-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pdp-qty-stepper {
    border: 1px solid #E6E0D2;
    border-radius: 8px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    width: 140px;
    box-sizing: border-box;
    background-color: #FFFFFF;
  }

  .pdp-qty-btn {
    width: 46px;
    height: 46px;
    background: transparent;
    border: none;
    color: #1B3A2F;
    font-size: 20px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.15s ease;
  }

  .pdp-qty-btn:hover {
    background-color: #F6F2E9;
  }

  .pdp-qty-input {
    width: 48px;
    border: none;
    background: transparent;
    text-align: center;
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 700 !important;
    font-size: 16px !important;
    color: #1B3A2F !important;
    padding: 0;
    -moz-appearance: textfield;
  }

  .pdp-qty-input::-webkit-outer-spin-button,
  .pdp-qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .pdp-cart-count-note {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 400 !important;
    font-size: 13.5px !important;
    color: #93A896 !important;
  }

  /* 4.8 Botones */
  .pdp-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 22px;
    width: 100%;
  }

  .pdp-btn {
    width: 100%;
    height: 52px;
    border-radius: 999px;
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 700 !important;
    font-size: 15px !important;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.15s ease;
    text-decoration: none;
    box-sizing: border-box;
  }

  .pdp-btn--primary {
    background-color: #2F7A6B;
    color: #FFFFFF !important;
  }

  .pdp-btn--primary:hover {
    background-color: #1B3A2F;
  }

  .pdp-btn--primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .pdp-btn:focus-visible {
    outline: 2px solid #C6A264;
    outline-offset: 3px;
  }

  .pdp-dynamic-checkout {
    width: 100%;
  }

  .pdp-dynamic-checkout .shopify-payment-button__button {
    width: 100%;
    height: 52px;
    border-radius: 999px;
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 700 !important;
    font-size: 15px !important;
    background-color: #1B3A2F !important;
    color: #F6F2E9 !important;
    border: none;
    transition: background-color 0.2s ease;
  }

  .pdp-dynamic-checkout .shopify-payment-button__button:hover {
    background-color: #142C23 !important;
  }

  /* Indicador de Compra al por Mayor */
  .pdp-wholesale-indicator {
    display: inline-flex;
    align-items: center;
  }

  .pdp-wholesale-badge {
    display: inline-flex;
    align-items: center;
    padding: 7px 12px;
    background-color: #F0F7F4;
    border: 1px solid #B8D8CD;
    color: #1B3A2F;
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-size: 12.5px !important;
    font-weight: 700 !important;
    border-radius: 6px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* Botón de WhatsApp para Mayoreo */
  .pdp-btn--whatsapp {
    background-color: #25D366;
    color: #FFFFFF !important;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);
  }

  .pdp-btn--whatsapp:hover {
    background-color: #1EBE5D;
    transform: scale(1.02);
    box-shadow: 0 6px 18px rgba(37, 211, 102, 0.45);
  }

  .pdp-btn--whatsapp svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
    flex-shrink: 0;
  }

  /* Estados deshabilitados por venta al por mayor */
  .is-wholesale-disabled {
    opacity: 0.35 !important;
    pointer-events: none !important;
    cursor: not-allowed !important;
    filter: grayscale(0.8) !important;
  }

  .is-hidden {
    display: none !important;
  }

  /* Adaptación Responsive para Móvil (Galería usable en fila con scroll) */
  @media (max-width: 999px) {
    .onv-gallery {
      flex-direction: column;
      gap: 12px;
    }

    .pdp-thumbs-wrapper {
      order: 2;
      width: 100%;
    }

    .pdp-thumbs {
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 8px;
      padding-bottom: 6px;
      -webkit-overflow-scrolling: touch;
    }

    .pdp-thumbs__item {
      scroll-snap-align: start;
      flex: 0 0 68px;
    }

    .pdp-thumbs__item--extra.is-hidden-desktop {
      display: list-item !important;
    }

    .pdp-thumbs__btn {
      width: 68px;
      height: 68px;
    }

    .pdp-thumbs__more-btn {
      display: none;
    }

    .pdp-main {
      order: 1;
      aspect-ratio: 1 / 1;
      padding: 0;
      border-radius: 10px;
    }

    .pdp-main__nav {
      width: 36px;
      height: 36px;
    }

    .pdp-main__nav--prev {
      left: 8px;
    }

    .pdp-main__nav--next {
      right: 8px;
    }

    .pdp-qty-row {
      flex-wrap: wrap;
      gap: 10px;
    }
  }

  /* 4.9 Filas de Confianza */
  .pdp-trust-rows {
    list-style: none;
    margin: 0 0 18px 0;
    padding: 0;
    width: 100%;
  }

  .pdp-trust-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-block: 14px;
    border-top: 1px solid #E6E0D2;
  }

  .pdp-trust-row__icon-wrap {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .pdp-trust-row__text {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 400 !important;
    font-size: 14.5px !important;
    line-height: 1.5 !important;
    color: #4A5A52 !important;
  }

  /* 4.10 Caja de Garantía */
  .pdp-guarantee-box {
    background-color: #EDF2EF;
    border-left: 3px solid #2F7A6B;
    border-radius: 8px;
    padding: 16px 18px;
    margin-block: 18px;
    display: flex;
    gap: 12px;
    align-items: flex-start;
    box-sizing: border-box;
  }

  .pdp-guarantee-box__icon {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .pdp-guarantee-box__content {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 400 !important;
    font-size: 14px !important;
    line-height: 1.55 !important;
    color: #1B3A2F !important;
  }

  /* 4.11 Acordeones */
  .pdp-accordions {
    width: 100%;
    margin-top: 12px;
  }

  .pdp-accordion {
    padding-block: 16px;
    border-top: 1px solid #E6E0D2;
  }

  .pdp-accordion:last-child {
    border-bottom: 1px solid #E6E0D2;
  }

  .pdp-accordion__summary {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 600 !important;
    font-size: 16px !important;
    color: #1B3A2F !important;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    user-select: none;
  }

  .pdp-accordion__summary::-webkit-details-marker {
    display: none;
  }

  .pdp-accordion__chevron {
    transition: transform 0.25s ease;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
  }

  .pdp-accordion[open] .pdp-accordion__chevron {
    transform: rotate(180deg);
  }

  .pdp-accordion__content {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 400 !important;
    font-size: 14.5px !important;
    line-height: 1.65 !important;
    color: #4A5A52 !important;
    padding-top: 10px;
    padding-bottom: 6px;
  }

  .pdp-accordion__content p {
    font-size: 14.5px !important;
    line-height: 1.65 !important;
    margin: 0 0 8px 0;
    color: #4A5A52 !important;
  }

  /* 5. Fila de Productos Relacionados */
  .onv-pdp__related {
    margin-top: 72px;
    width: 100%;
  }

  .onv-pdp__related-title {
    font-family: var(--font-display, "Playfair Display", Georgia, serif) !important;
    font-weight: 600 !important;
    font-size: 22px !important;
    color: #1B3A2F !important;
    margin: 0 0 20px 0;
  }

  .onv-pdp__related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
  }

  .onv-pdp__related-card {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .onv-pdp__related-media {
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    background-color: #F6F2E9;
    overflow: hidden;
  }

  .onv-pdp__related-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .onv-pdp__related-card:hover img {
    transform: scale(1.04);
  }

  .onv-pdp__related-name {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 500 !important;
    font-size: 14px !important;
    color: #1B3A2F !important;
    margin: 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .onv-pdp__related-price {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 700 !important;
    font-size: 15px !important;
    color: #1B3A2F !important;
  }

  /* Lightbox Modal */
  .pdp-lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    box-sizing: border-box;
  }

  .pdp-lightbox.is-open {
    display: flex;
  }

  .pdp-lightbox__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .pdp-lightbox__content {
    position: relative;
    z-index: 2;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pdp-lightbox__close {
    position: absolute;
    top: -44px;
    right: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pdp-lightbox__img {
    max-width: 85vw;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.3);
  }
{% endstyle %}

<script>
  (function() {
    function initPdp() {
      // ==========================================
      // 1. GALERÍA DE PRODUCTO (ESTILO MARKETPLACE)
      // ==========================================
      var thumbs = Array.from(document.querySelectorAll('.pdp-thumbs__btn'));
      var mainImg = document.getElementById('PdpMainImage-{{ section.id }}');
      var navPrev = document.getElementById('PdpNavPrev');
      var navNext = document.getElementById('PdpNavNext');
      var moreImagesBtn = document.getElementById('PdpMoreImagesBtn');
      var moreBtnText = document.getElementById('PdpMoreBtnText');
      var extraThumbs = document.querySelectorAll('.pdp-thumbs__item--extra');

      var zoomBtn = document.getElementById('PdpZoomBtn-{{ section.id }}');
      var lightbox = document.getElementById('PdpLightboxModal');
      var lightboxImg = document.getElementById('PdpLightboxImg');
      var lightboxClose = document.getElementById('PdpLightboxClose');
      var lightboxBackdrop = document.getElementById('PdpLightboxBackdrop');

      var currentImgIndex = 0;

      function goToImage(index) {
        if (!thumbs.length) return;
        currentImgIndex = (index + thumbs.length) % thumbs.length;
        var activeBtn = thumbs[currentImgIndex];
        if (!activeBtn) return;

        thumbs.forEach(function(b) { b.classList.remove('is-active'); });
        activeBtn.classList.add('is-active');

        var fullSrc = activeBtn.getAttribute('data-full-src');
        var altText = activeBtn.getAttribute('data-alt');

        if (mainImg && fullSrc) {
          mainImg.style.opacity = '0.4';
          mainImg.src = fullSrc;
          if (altText) mainImg.alt = altText;
          setTimeout(function() {
            mainImg.style.opacity = '1';
          }, 120);
        }

        if (lightboxImg && lightbox && lightbox.classList.contains('is-open')) {
          lightboxImg.src = fullSrc;
          if (altText) lightboxImg.alt = altText;
        }

        // Asegurar que la miniatura activa sea visible
        var parentItem = activeBtn.closest('.pdp-thumbs__item');
        if (parentItem) {
          if (parentItem.classList.contains('is-hidden-desktop')) {
            parentItem.classList.remove('is-hidden-desktop');
          }
          if (parentItem.scrollIntoView) {
            parentItem.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
          }
        }
      }

      // Clic en miniaturas
      thumbs.forEach(function(btn, idx) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          goToImage(idx);
        });
      });

      // Flechas Anterior y Siguiente
      if (navPrev) {
        navPrev.addEventListener('click', function(e) {
          e.preventDefault();
          goToImage(currentImgIndex - 1);
        });
      }

      if (navNext) {
        navNext.addEventListener('click', function(e) {
          e.preventDefault();
          goToImage(currentImgIndex + 1);
        });
      }

      // Botón "Más imágenes"
      if (moreImagesBtn && extraThumbs.length > 0) {
        var isExpanded = false;
        moreImagesBtn.addEventListener('click', function(e) {
          e.preventDefault();
          isExpanded = !isExpanded;
          extraThumbs.forEach(function(item) {
            if (isExpanded) {
              item.classList.remove('is-hidden-desktop');
            } else {
              item.classList.add('is-hidden-desktop');
            }
          });
          if (moreBtnText) {
            moreBtnText.textContent = isExpanded ? 'Menos imágenes' : 'Más imágenes';
          }
          var svg = moreImagesBtn.querySelector('svg');
          if (svg) {
            svg.style.transform = isExpanded ? 'rotate(180deg)' : 'none';
          }
        });
      }

      // Lightbox Zoom
      if (zoomBtn && lightbox && lightboxImg) {
        zoomBtn.addEventListener('click', function() {
          if (mainImg) {
            lightboxImg.src = mainImg.src;
            lightboxImg.alt = mainImg.alt;
          }
          lightbox.classList.add('is-open');
          lightbox.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        });

        function closeLightbox() {
          lightbox.classList.remove('is-open');
          lightbox.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }

        if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
        if (lightboxBackdrop) lightboxBackdrop.addEventListener('click', closeLightbox);

        document.addEventListener('keydown', function(e) {
          if (lightbox.classList.contains('is-open')) {
            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowLeft') goToImage(currentImgIndex - 1);
            if (e.key === 'ArrowRight') goToImage(currentImgIndex + 1);
          }
        });
      }

      // ==========================================
      // 2. LÓGICA DE PRECIOS, MAYOREO Y WHATSAPP
      // ==========================================
      // TODO: reemplazar con número real de WhatsApp
      var WHATSAPP_PHONE_NUMBER = '1234567890'; // Reemplazar con el número de teléfono con código de país (ej. 13050000000)

      var currentPriceEl = document.getElementById('PdpCurrentPrice-{{ section.id }}');
      var comparePriceEl = document.getElementById('PdpComparePrice-{{ section.id }}');
      var discountBadgeEl = document.getElementById('PdpDiscountBadge-{{ section.id }}');
      var qtyInput = document.getElementById('PdpQuantityInput');
      var qtyMinus = document.getElementById('PdpQtyMinus');
      var qtyPlus = document.getElementById('PdpQtyPlus');
      var addBtn = document.getElementById('PdpAddToCartBtn');
      var dynamicCheckout = document.getElementById('PdpDynamicCheckoutWrap');
      var whatsappBtn = document.getElementById('PdpWhatsAppBtn');
      var bundleRadios = document.querySelectorAll('input[name="bundle_radio"]');
      var hiddenVariantInput = document.getElementById('PdpSelectedVariantId');

      // Cálculo de precio según la tabla oficial:
      // 1 unidad = $25
      // 2 unidades = $50
      // 3 unidades = $60
      // A partir de 3 unidades: +$20 por cada unidad adicional
      function calculatePrice(qty) {
        if (qty <= 0) return 0;
        if (qty === 1) return 25;
        if (qty === 2) return 50;
        if (qty === 3) return 60;
        return 60 + (qty - 3) * 20;
      }

      function getWhatsAppUrl(qty) {
        var message = 'Hola, quiero comprar ' + qty + ' unidades de ONYVERA. Me gustaría hablar con un asesor para consultar el precio al por mayor y realizar el pedido.';
        return 'https://wa.me/' + WHATSAPP_PHONE_NUMBER + '?text=' + encodeURIComponent(message);
      }

      function updatePdpState(qty) {
        var cleanQty = parseInt(qty, 10);
        if (isNaN(cleanQty) || cleanQty < 1) cleanQty = 1;
        if (qtyInput && parseInt(qtyInput.value, 10) !== cleanQty) {
          qtyInput.value = cleanQty;
        }

        // Sincronizar radio cards de paquetes
        if (bundleRadios.length > 0) {
          document.querySelectorAll('.pdp-bundle-card').forEach(function(card) {
            card.classList.remove('is-selected');
          });
          var matchingRadio = Array.from(bundleRadios).find(function(r) {
            return parseInt(r.getAttribute('data-qty'), 10) === cleanQty;
          });
          if (matchingRadio) {
            matchingRadio.checked = true;
            var parent = matchingRadio.closest('.pdp-bundle-card');
            if (parent) parent.classList.add('is-selected');
            if (hiddenVariantInput) hiddenVariantInput.value = matchingRadio.value;
          }
        }

        // A partir de 10 unidades: venta al por mayor (no hay precio automático, se habla con el asesor)
        var isWholesale = cleanQty >= 10;
        if (isWholesale) {
          // Deshabilitar botones de pago normales
          if (addBtn) {
            addBtn.disabled = true;
            addBtn.classList.add('is-wholesale-disabled');
          }
          if (dynamicCheckout) {
            dynamicCheckout.classList.add('is-wholesale-disabled');
          }
          // Mostrar botón de WhatsApp para hablar con el asesor
          if (whatsappBtn) {
            whatsappBtn.href = getWhatsAppUrl(cleanQty);
            whatsappBtn.classList.remove('is-hidden');
          }
          // Estado de precio a consultar con asesor
          if (currentPriceEl) {
            currentPriceEl.textContent = 'Consultar con asesor';
          }
          if (comparePriceEl) {
            comparePriceEl.style.display = 'none';
          }
          if (discountBadgeEl) {
            discountBadgeEl.style.display = 'none';
          }
        } else {
          // Menos de 10 unidades: precio calculado normal
          var total = calculatePrice(cleanQty);

          // Actualizar precio mostrado en la pantalla
          if (currentPriceEl) {
            currentPriceEl.textContent = '$' + total + '.00';
          }

          // Precio de comparación referencial ($25 por unidad estándar)
          if (cleanQty >= 3 && comparePriceEl && discountBadgeEl) {
            var standardPrice = cleanQty * 25;
            if (standardPrice > total) {
              var diff = standardPrice - total;
              var pct = Math.round((diff / standardPrice) * 100);
              comparePriceEl.textContent = '$' + standardPrice + '.00';
              comparePriceEl.style.display = '';
              discountBadgeEl.textContent = 'Ahorras $' + diff + ' (-' + pct + '%)';
              discountBadgeEl.style.display = '';
            } else {
              comparePriceEl.style.display = 'none';
              discountBadgeEl.style.display = 'none';
            }
          } else if (comparePriceEl && discountBadgeEl) {
            comparePriceEl.style.display = 'none';
            discountBadgeEl.style.display = 'none';
          }

          // Reactivar botones de pago normales
          if (addBtn) {
            addBtn.disabled = false;
            addBtn.classList.remove('is-wholesale-disabled');
          }
          if (dynamicCheckout) {
            dynamicCheckout.classList.remove('is-wholesale-disabled');
          }
          // Ocultar botón de WhatsApp
          if (whatsappBtn) {
            whatsappBtn.classList.add('is-hidden');
          }
        }
      }

      // Controles Stepper de Cantidad
      if (qtyMinus && qtyInput) {
        qtyMinus.addEventListener('click', function(e) {
          e.preventDefault();
          var currentVal = parseInt(qtyInput.value, 10) || 1;
          if (currentVal > 1) {
            updatePdpState(currentVal - 1);
          }
        });
      }

      if (qtyPlus && qtyInput) {
        qtyPlus.addEventListener('click', function(e) {
          e.preventDefault();
          var currentVal = parseInt(qtyInput.value, 10) || 1;
          updatePdpState(currentVal + 1);
        });
      }

      if (qtyInput) {
        qtyInput.addEventListener('change', function() {
          var val = parseInt(this.value, 10) || 1;
          updatePdpState(val);
        });
        qtyInput.addEventListener('input', function() {
          var val = parseInt(this.value, 10);
          if (!isNaN(val) && val >= 1) {
            updatePdpState(val);
          }
        });
      }

      // Evento al cambiar selección de paquete por Radio Card
      bundleRadios.forEach(function(radio) {
        radio.addEventListener('change', function() {
          var targetQty = parseInt(this.getAttribute('data-qty'), 10) || 1;
          updatePdpState(targetQty);
        });
      });

      // Inicializar con la cantidad actual
      var initialQty = qtyInput ? (parseInt(qtyInput.value, 10) || 1) : 1;
      updatePdpState(initialQty);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPdp);
    } else {
      initPdp();
    }
  })();
</script>

{% schema %}
