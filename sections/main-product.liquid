    }

    .pdp-trust-row__text {
      font-size: 13px !important;
    }

    /* Acordeones */
    .pdp-accordion__summary {
      font-size: 15px !important;
    }
  }
{% endstyle %}

<script>
  (function() {
    function initPdp() {
      // ==========================================
      // 1. GALERÍA DE PRODUCTO (ESTILO MARKETPLACE)
      // ==========================================
      var thumbs = Array.from(document.querySelectorAll('.pdp-thumbs__btn'));
      var mainImg = document.getElementById('PdpMainImage-{{ section.id }}');
      var navPrev = document.getElementById('PdpNavPrev');
      var navNext = document.getElementById('PdpNavNext');
      var moreImagesBtn = document.getElementById('PdpMoreImagesBtn');
      var moreBtnText = document.getElementById('PdpMoreBtnText');
      var extraThumbs = document.querySelectorAll('.pdp-thumbs__item--extra');

      var zoomBtn = document.getElementById('PdpZoomBtn-{{ section.id }}');
      var lightbox = document.getElementById('PdpLightboxModal');
      var lightboxImg = document.getElementById('PdpLightboxImg');
      var lightboxClose = document.getElementById('PdpLightboxClose');
      var lightboxBackdrop = document.getElementById('PdpLightboxBackdrop');

      var currentImgIndex = 0;

      function goToImage(index) {
        if (!thumbs.length) return;
        currentImgIndex = (index + thumbs.length) % thumbs.length;
        var activeBtn = thumbs[currentImgIndex];
        if (!activeBtn) return;

        thumbs.forEach(function(b) { b.classList.remove('is-active'); });
        activeBtn.classList.add('is-active');

        var fullSrc = activeBtn.getAttribute('data-full-src');
        var altText = activeBtn.getAttribute('data-alt');

        if (mainImg && fullSrc) {
          mainImg.style.opacity = '0.4';
          mainImg.src = fullSrc;
          if (altText) mainImg.alt = altText;
          setTimeout(function() {
            mainImg.style.opacity = '1';
          }, 120);
        }

        if (lightboxImg && lightbox && lightbox.classList.contains('is-open')) {
          lightboxImg.src = fullSrc;
          if (altText) lightboxImg.alt = altText;
        }

        // Asegurar que la miniatura activa sea visible
        var parentItem = activeBtn.closest('.pdp-thumbs__item');
        if (parentItem) {
          if (parentItem.classList.contains('is-hidden-desktop')) {
            parentItem.classList.remove('is-hidden-desktop');
          }
          if (parentItem.scrollIntoView) {
            parentItem.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
          }
        }
      }

      // Clic en miniaturas
      thumbs.forEach(function(btn, idx) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          goToImage(idx);
        });
      });

      // Flechas Anterior y Siguiente
      if (navPrev) {
        navPrev.addEventListener('click', function(e) {
          e.preventDefault();
          goToImage(currentImgIndex - 1);
        });
      }

      if (navNext) {
        navNext.addEventListener('click', function(e) {
          e.preventDefault();
          goToImage(currentImgIndex + 1);
        });
      }

      // Botón "Más imágenes"
      if (moreImagesBtn && extraThumbs.length > 0) {
        var isExpanded = false;
        moreImagesBtn.addEventListener('click', function(e) {
          e.preventDefault();
          isExpanded = !isExpanded;
          extraThumbs.forEach(function(item) {
            if (isExpanded) {
              item.classList.remove('is-hidden-desktop');
            } else {
              item.classList.add('is-hidden-desktop');
            }
          });
          if (moreBtnText) {
            moreBtnText.textContent = isExpanded ? 'Menos imágenes' : 'Más imágenes';
          }
          var svg = moreImagesBtn.querySelector('svg');
          if (svg) {
            svg.style.transform = isExpanded ? 'rotate(180deg)' : 'none';
          }
        });
      }

      // Lightbox Zoom
      if (zoomBtn && lightbox && lightboxImg) {
        zoomBtn.addEventListener('click', function() {
          if (mainImg) {
            lightboxImg.src = mainImg.src;
            lightboxImg.alt = mainImg.alt;
          }
          lightbox.classList.add('is-open');
          lightbox.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        });

        function closeLightbox() {
          lightbox.classList.remove('is-open');
          lightbox.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }

        if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
        if (lightboxBackdrop) lightboxBackdrop.addEventListener('click', closeLightbox);

        document.addEventListener('keydown', function(e) {
          if (lightbox.classList.contains('is-open')) {
            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowLeft') goToImage(currentImgIndex - 1);
            if (e.key === 'ArrowRight') goToImage(currentImgIndex + 1);
          }
        });
      }

      // ==========================================
      // 2. PRICING, BUNDLE & SHIPPING LOGIC
      // ==========================================
      var WHATSAPP_PHONE_NUMBER = '1234567890'; // Replace with store country code + phone

      var currentPriceEl = document.getElementById('PdpCurrentPrice-{{ section.id }}');
      var comparePriceEl = document.getElementById('PdpComparePrice-{{ section.id }}');
      var discountBadgeEl = document.getElementById('PdpDiscountBadge-{{ section.id }}');
      var shippingTeaser = document.getElementById('PdpShippingTeaser');
      var shippingTeaserText = document.getElementById('PdpShippingTeaserText');
      var qtyInput = document.getElementById('PdpQuantityInput');
      var qtyMinus = document.getElementById('PdpQtyMinus');
      var qtyPlus = document.getElementById('PdpQtyPlus');
      var addBtn = document.getElementById('PdpAddToCartBtn');
      var dynamicCheckout = document.getElementById('PdpDynamicCheckoutWrap');
      var whatsappBtn = document.getElementById('PdpWhatsAppBtn');
      var bundleRadios = document.querySelectorAll('input[name="bundle_radio"]');
      var hiddenVariantInput = document.getElementById('PdpSelectedVariantId');

      // Official tiered bundle pricing:
      // 1 unit = $25
      // 2 units = $50 (Free shipping unlocked)
      // 3 units = $60 (Save $15)
      // 4+ units = 60 + (qty - 3) * 20
      function calculatePrice(qty) {
        if (qty <= 0) return 0;
        if (qty === 1) return 25;
        if (qty === 2) return 50;
        if (qty === 3) return 60;
        return 60 + (qty - 3) * 20;
      }

      function getWhatsAppUrl(qty) {
        var message = 'Hello, I would like to order ' + qty + ' units of ONYVERA. I would like to speak with an advisor about wholesale pricing.';
        return 'https://wa.me/' + WHATSAPP_PHONE_NUMBER + '?text=' + encodeURIComponent(message);
      }

      function updatePdpState(qty) {
        var cleanQty = parseInt(qty, 10);
        if (isNaN(cleanQty) || cleanQty < 1) cleanQty = 1;
        if (qtyInput && parseInt(qtyInput.value, 10) !== cleanQty) {
          qtyInput.value = cleanQty;
        }

        // Sincronizar radio cards de paquetes (Pack 1, 2, 3)
        if (bundleRadios.length > 0) {
          document.querySelectorAll('.pdp-bundle-card').forEach(function(card) {
            card.classList.remove('is-selected');
          });
          var targetRadio = null;
          if (cleanQty === 1) {
            targetRadio = document.querySelector('input[name="bundle_radio"][data-qty="1"]');
          } else if (cleanQty === 2) {
            targetRadio = document.querySelector('input[name="bundle_radio"][data-qty="2"]');
          } else {
            targetRadio = document.querySelector('input[name="bundle_radio"][data-qty="3"]');
          }

          if (targetRadio) {
            targetRadio.checked = true;
            var parent = targetRadio.closest('.pdp-bundle-card');
            if (parent) parent.classList.add('is-selected');
          }
        }

        var baseVariantId = '{{ product.variants[0].id | default: current_variant.id }}';
        if (hiddenVariantInput) {
          hiddenVariantInput.value = baseVariantId;
        }

        // Wholesale mode at 10+ units
        var isWholesale = cleanQty >= 10;
        if (isWholesale) {
          if (addBtn) {
            addBtn.disabled = true;
            addBtn.classList.add('is-wholesale-disabled');
          }
          if (dynamicCheckout) {
            dynamicCheckout.classList.add('is-wholesale-disabled');
          }
          if (whatsappBtn) {
            whatsappBtn.href = getWhatsAppUrl(cleanQty);
            whatsappBtn.classList.remove('is-hidden');
          }
          if (currentPriceEl) {
            currentPriceEl.textContent = 'Wholesale pricing';
          }
          if (comparePriceEl) comparePriceEl.style.display = 'none';
          if (discountBadgeEl) discountBadgeEl.style.display = 'none';
          if (shippingTeaser) {
            shippingTeaser.classList.add('has-unlocked');
            if (shippingTeaserText) shippingTeaserText.innerHTML = '🎉 <strong>FREE U.S. SHIPPING INCLUDED</strong>';
          }
        } else {
          var total = calculatePrice(cleanQty);

          if (currentPriceEl) {
            currentPriceEl.textContent = '$' + total + '.00';
          }

          // Shipping Teaser & Savings Dynamic Feedback
          if (cleanQty === 1) {
            if (comparePriceEl) comparePriceEl.style.display = 'none';
            if (discountBadgeEl) discountBadgeEl.style.display = 'none';
            if (shippingTeaser) {
              shippingTeaser.classList.remove('has-unlocked');
              if (shippingTeaserText) shippingTeaserText.innerHTML = 'Buy 2 or more → <strong>FREE U.S. SHIPPING</strong> (You’re $25 away)';
            }
          } else if (cleanQty === 2) {
            if (comparePriceEl) comparePriceEl.style.display = 'none';
            if (discountBadgeEl) discountBadgeEl.style.display = 'none';
            if (shippingTeaser) {
              shippingTeaser.classList.add('has-unlocked');
              if (shippingTeaserText) shippingTeaserText.innerHTML = '🎉 <strong>FREE U.S. SHIPPING UNLOCKED!</strong>';
            }
          } else {
            // 3+ units
            var standardPrice = cleanQty * 25;
            if (standardPrice > total && comparePriceEl && discountBadgeEl) {
              var diff = standardPrice - total;
              var pct = Math.round((diff / standardPrice) * 100);
              comparePriceEl.textContent = '$' + standardPrice + '.00';
              comparePriceEl.style.display = '';
              discountBadgeEl.textContent = 'Save $' + diff + ' (' + pct + '% OFF)';
              discountBadgeEl.style.display = '';
            }
            if (shippingTeaser) {
              shippingTeaser.classList.add('has-unlocked');
              if (shippingTeaserText) shippingTeaserText.innerHTML = '🎉 <strong>FREE U.S. SHIPPING + BULK SAVINGS UNLOCKED!</strong>';
            }
          }

          if (addBtn) {
            addBtn.disabled = false;
            addBtn.classList.remove('is-wholesale-disabled');
          }
          if (dynamicCheckout) {
            dynamicCheckout.classList.remove('is-wholesale-disabled');
          }
          if (whatsappBtn) {
            whatsappBtn.classList.add('is-hidden');
          }
        }
      }

      // Quantity stepper controls
      if (qtyMinus && qtyInput) {
        qtyMinus.addEventListener('click', function(e) {
          e.preventDefault();
          var currentVal = parseInt(qtyInput.value, 10) || 2;
          if (currentVal > 1) {
            updatePdpState(currentVal - 1);
          }
        });
      }

      if (qtyPlus && qtyInput) {
        qtyPlus.addEventListener('click', function(e) {
          e.preventDefault();
          var currentVal = parseInt(qtyInput.value, 10) || 2;
          updatePdpState(currentVal + 1);
        });
      }

      if (qtyInput) {
        qtyInput.addEventListener('change', function() {
          var val = parseInt(this.value, 10) || 2;
          updatePdpState(val);
        });
        qtyInput.addEventListener('input', function() {
          var val = parseInt(this.value, 10);
          if (!isNaN(val) && val >= 1) {
            updatePdpState(val);
          }
        });
      }

      // Bundle radio selection change
      bundleRadios.forEach(function(radio) {
        radio.addEventListener('change', function() {
          var targetQty = parseInt(this.getAttribute('data-qty'), 10) || 2;
          updatePdpState(targetQty);
        });
      });

      // Default initial state: 2 Bottles (Pack 2)
      var initialQty = qtyInput ? (parseInt(qtyInput.value, 10) || 2) : 2;
      updatePdpState(initialQty);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPdp);
    } else {
      initPdp();
    }
  })();
</script>

