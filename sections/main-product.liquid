  /* ============================================================
     RESPONSIVE MÓVIL — Correcciones de layout para pantallas < 750px
     ============================================================ */
  @media (max-width: 749px) {

    /* ── Sección / Contenedor ── */
    .onv-pdp-section {
      padding-top: 16px;
      padding-bottom: 40px;
    }

    /* ── Galería principal ── */
    .onv-pdp__gallery {
      width: 100%;
      overflow: hidden;    /* evita desbordamiento horizontal */
    }

    .onv-gallery {
      width: 100%;
      overflow: hidden;
    }

    /* Imagen principal: cuadrada, ocupa todo el ancho disponible */
    .pdp-main {
      width: 100%;
      max-width: 100%;
      aspect-ratio: 1 / 1;
      border-radius: 10px;
      overflow: hidden;
    }

    .pdp-main__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Tira de miniaturas: scroll horizontal, no desborda la página */
    .pdp-thumbs-wrapper {
      width: 100%;
      max-width: 100%;
      overflow: hidden;
    }

    .pdp-thumbs {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 8px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      max-width: 100%;
      padding-bottom: 4px;
    }

    .pdp-thumbs__item {
      flex: 0 0 60px;
      scroll-snap-align: start;
    }

    .pdp-thumbs__btn {
      width: 60px;
      height: 60px;
    }

    /* ── Buybox / Información ── */
    .onv-pdp__buybox {
      width: 100%;
      max-width: 100%;
      overflow: hidden;
      box-sizing: border-box;
    }

    /* Título: que rompa palabra si es muy largo */
    .pdp-title {
      font-size: clamp(22px, 6vw, 30px) !important;
      word-break: break-word !important;
      overflow-wrap: break-word !important;
      hyphens: auto !important;
    }

    /* Chips: reduce tamaño de fuente y padding */
    .pdp-chip {
      font-size: 10.5px !important;
      padding: 6px 10px !important;
      gap: 5px !important;
    }

    /* Grid de paquetes: ya era 1 columna en <480px, asegurar en <750px */
    .pdp-bundle-grid {
      grid-template-columns: 1fr !important;
      gap: 8px;
    }

    /* Fila de cantidad: wrap para que el badge de mayoreo no desborde */
    .pdp-qty-row {
      flex-wrap: wrap;
      gap: 8px;
      width: 100%;
    }

    /* Badge de "mayoreo": permitir wrap en lugar de nowrap */
    .pdp-wholesale-badge {
      white-space: normal !important;
      word-break: break-word !important;
      max-width: 100%;
      box-sizing: border-box;
    }

    .pdp-cart-count-note {
      font-size: 12px !important;
      flex: 1 1 100%;   /* ocupa línea completa */
    }

    /* Botones CTA a ancho completo */
    .pdp-btn,
    .pdp-btn--primary,
    .pdp-btn--whatsapp {
      width: 100% !important;
      font-size: 14px !important;
    }

