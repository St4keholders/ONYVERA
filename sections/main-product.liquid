{%- comment -%}
  ONYVERA — Plantilla de Producto (PDP)
  Layout dos columnas con galería sticky (riel vertical de miniaturas a la izquierda) y buy box densa.
  Totalmente en español, acordeones nativos, selector de paquetes tipo radio-card y microinteracciones fluidas.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign compare_at_price = current_variant.compare_at_price
  assign price = current_variant.price
  assign is_discounted = false
  if compare_at_price > price
    assign is_discounted = true
    assign discount_amount = compare_at_price | minus: price
    assign discount_percent = discount_amount | times: 100.0 | divided_by: compare_at_price | round
  endif

  assign cart_item_count = 0
  for item in cart.items
    if item.product_id == product.id
      assign cart_item_count = cart_item_count | plus: item.quantity
    endif
  endfor
-%}

<section id="onv-pdp-{{ section.id }}" class="onv-pdp-section" data-section-id="{{ section.id }}">
  <div class="onv-pdp__container">

    <!-- 2. BREADCRUMB -->
    {%- if section.settings.mostrar_breadcrumb -%}
      <nav class="onv-pdp__breadcrumb" aria-label="Breadcrumb navigation">
        <ol class="onv-pdp__breadcrumb-list">
          <li class="onv-pdp__breadcrumb-item">
            <a href="/" class="onv-pdp__breadcrumb-link">Home</a>
          </li>
          <li class="onv-pdp__breadcrumb-sep" aria-hidden="true">›</li>
          <li class="onv-pdp__breadcrumb-item">
            {%- if collection -%}
              <a href="{{ collection.url }}" class="onv-pdp__breadcrumb-link">{{ collection.title | escape }}</a>
            {%- else -%}
              <a href="/collections/all" class="onv-pdp__breadcrumb-link">Shop</a>
            {%- endif -%}
          </li>
          <li class="onv-pdp__breadcrumb-sep" aria-hidden="true">›</li>
          <li class="onv-pdp__breadcrumb-item onv-pdp__breadcrumb-item--current" aria-current="page">
            {{ product.title | escape }}
          </li>
        </ol>
      </nav>

      <!-- Schema JSON-LD BreadcrumbList -->
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": "{{ shop.url }}"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Shop",
              "item": "{{ shop.url }}/collections/all"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ product.title | json }},
              "item": "{{ shop.url }}{{ product.url }}"
            }
          ]
        }
      </script>
    {%- endif -%}

    <!-- Schema JSON-LD Product (Estándar de Shopify sin reseñas de prueba) -->
    <script type="application/ld+json">
      {{ product | structured_data }}
    </script>

    <!-- GRID PRINCIPAL (GALERÍA + BUY BOX) -->
    <div class="onv-pdp__grid">

      <!-- 3. COLUMNA IZQUIERDA — GALERÍA (ESTILO MARKETPLACE) -->
      <div class="onv-pdp__gallery{% if section.settings.galeria_sticky %} onv-pdp__gallery--sticky{% endif %}">
        <div class="onv-gallery">

          {%- liquid
            assign gallery_images = 'onv-producto1.jpeg,onv-producto2.jpeg,onv-producto3.jpeg,onv-producto4.jpeg,onv-producto5.jpeg,onv-producto6.jpeg,onv-producto7.jpeg,onv-producto8.jpeg' | split: ','
          -%}

          <!-- Riel Vertical de Miniaturas (Estilo Mercado Libre) -->
          <div class="pdp-thumbs-wrapper">
            <ul class="pdp-thumbs" id="PdpThumbsList" aria-label="Miniaturas del producto">
              {%- for img_file in gallery_images -%}
                {%- assign img_src = img_file | asset_url -%}
                <li class="pdp-thumbs__item{% if forloop.index > 6 %} pdp-thumbs__item--extra is-hidden-desktop{% endif %}" data-index="{{ forloop.index0 }}">
                  <button
                    type="button"
                    class="pdp-thumbs__btn{% if forloop.first %} is-active{% endif %}"
                    data-index="{{ forloop.index0 }}"
                    data-full-src="{{ img_src }}"
                    data-alt="ONYVERA Sérum Botánico - Vista {{ forloop.index }}"
                    aria-label="Ver imagen {{ forloop.index }} de {{ gallery_images.size }}"
                  >
                    <img
                      src="{{ img_src }}"
                      alt="ONYVERA Sérum Botánico - Vista {{ forloop.index }}"
                      class="pdp-thumbs__img"
                      width="76"
                      height="76"
                      loading="lazy"
                    >
                  </button>
                </li>
              {%- endfor -%}
            </ul>

            {%- if gallery_images.size > 6 -%}
              <button type="button" class="pdp-thumbs__more-btn" id="PdpMoreImagesBtn" aria-label="Ver más imágenes">
                <span id="PdpMoreBtnText">Más imágenes</span>
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
            {%- endif -%}
          </div>

          <!-- Imagen Principal Grande con Flechas de Navegación -->
          <div class="pdp-main" id="PdpMainContainer">
            <!-- Flecha Anterior -->
            <button type="button" class="pdp-main__nav pdp-main__nav--prev" id="PdpNavPrev" aria-label="Imagen anterior">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
            </button>

            <!-- Flecha Siguiente -->
            <button type="button" class="pdp-main__nav pdp-main__nav--next" id="PdpNavNext" aria-label="Siguiente imagen">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </button>

            <img
              id="PdpMainImage-{{ section.id }}"
              src="{{ gallery_images.first | asset_url }}"
              alt="{{ product.title | default: 'ONYVERA Botanical Nail Care Serum' | escape }}"
              class="pdp-main__img"
              width="1080"
              height="1080"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            >

            <!-- Botón de Zoom (Abre Lightbox) -->
            <button
              type="button"
              class="pdp-main__zoom-btn"
              id="PdpZoomBtn-{{ section.id }}"
              aria-label="Ampliar imagen"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#1B3A2F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 3 21 3 21 9"></polyline>
                <polyline points="9 21 3 21 3 15"></polyline>
                <line x1="21" y1="3" x2="14" y2="10"></line>
                <line x1="3" y1="21" x2="10" y2="14"></line>
              </svg>
            </button>
          </div>

        </div>
      </div>

      <!-- 4. COLUMNA DERECHA — BUY BOX -->
      <div class="onv-pdp__buybox">

        <!-- 4.1 Marca -->
        <span class="pdp-brand">{{ product.vendor | default: "VITAHERB INTERNATIONAL LLC" | escape }}</span>

        <!-- 4.2 Título -->
        <h1 class="pdp-title">{{ product.title | escape }}</h1>

        <!-- 4.3 Estrellas + Conteo de Reseñas (Con Gate obligatorio) -->
        {%- if section.settings.usar_resenas_prueba or product.metafields.reviews.rating.value != blank -%}
          <div class="pdp-reviews-row">
            <div class="pdp-stars" aria-label="Rated 4.8 out of 5 stars">
              <svg class="pdp-star pdp-star--filled" viewBox="0 0 24 24" fill="#C6A264" width="15" height="15" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg class="pdp-star pdp-star--filled" viewBox="0 0 24 24" fill="#C6A264" width="15" height="15" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg class="pdp-star pdp-star--filled" viewBox="0 0 24 24" fill="#C6A264" width="15" height="15" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg class="pdp-star pdp-star--filled" viewBox="0 0 24 24" fill="#C6A264" width="15" height="15" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg class="pdp-star pdp-star--filled" viewBox="0 0 24 24" fill="#C6A264" width="15" height="15" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <a href="#onv-reviews" class="pdp-reviews-count">4.8 · 23 verified customer reviews</a>
          </div>
        {%- endif -%}

        <!-- Above the fold cosmetic hook -->
        <div class="pdp-cosmetic-hook">
          <h2 class="pdp-cosmetic-heading">Daily Botanical Care for Dry, Brittle-Looking Nails</h2>
          <p class="pdp-cosmetic-subhead">Tea Tree Oil, Aloe Vera &amp; Vitamin E in a precision brush serum designed to hydrate, nourish, and condition nails and cuticles.</p>
        </div>

        <!-- 4.4 Dynamic Price & Free Shipping Teaser -->
        <div class="pdp-price-wrap" id="PdpPriceWrap-{{ section.id }}">
          <div class="pdp-price-row">
            <span class="pdp-price" id="PdpCurrentPrice-{{ section.id }}">$50.00</span>
            <s class="pdp-price-compare" id="PdpComparePrice-{{ section.id }}" style="display: none;"></s>
            <span class="pdp-discount-badge" id="PdpDiscountBadge-{{ section.id }}" style="display: none;"></span>
          </div>
          <div class="pdp-shipping-teaser has-unlocked" id="PdpShippingTeaser">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <span id="PdpShippingTeaserText">🎉 <strong>FREE U.S. SHIPPING UNLOCKED!</strong></span>
          </div>
          <span class="pdp-tax-note">Taxes included. Fast dispatch from Orlando, FL.</span>
        </div>

        <!-- Formulario Principal de Producto -->
        {%- form 'product', product, id: 'PdpProductForm', class: 'pdp-form' -%}
          <input type="hidden" name="id" id="PdpSelectedVariantId" value="{{ product.variants[0].id | default: current_variant.id }}">
          <input type="hidden" name="return_to" id="PdpReturnTo" value="/checkout">

          <!-- 4.5 Chips de Especificación -->
          <div class="pdp-chips-block">
            <span class="pdp-block-label">In each 16 ml bottle:</span>
            <div class="pdp-chips-wrap">
              {%- for block in section.blocks -%}
                {%- if block.type == 'chip' -%}
                  <div class="pdp-chip" {{ block.shopify_attributes }}>
                    {%- case block.settings.icono -%}
                      {%- when 'hoja' -%}
                        <svg class="pdp-chip__icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#2F7A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                      {%- when 'calendario' -%}
                        <svg class="pdp-chip__icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#2F7A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                      {%- when 'brocha' -%}
                        <svg class="pdp-chip__icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#2F7A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 12-8.5 8.5a2.12 2.12 0 1 1-3-3L11 9"/><path d="M18 10l-4-4"/><path d="M14 6l2-2a2.83 2.83 0 1 1 4 4l-2 2"/></svg>
                      {%- when 'escudo' -%}
                        <svg class="pdp-chip__icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#2F7A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                      {%- when 'conejo' -%}
                        <svg class="pdp-chip__icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#2F7A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 16a3 3 0 0 1-6 0c0-1.5 1-3 3-3s3 1.5 3 3z"/><path d="M10 13V3.5a2.5 2.5 0 0 0-5 0V13"/><path d="M14 13V5.5a2.5 2.5 0 0 1 5 0V13"/><path d="M18 14a4 4 0 0 1-8 0"/></svg>
                    {%- endcase -%}
                    <span>{{ block.settings.texto | escape }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          <!-- 4.6 Selector de Paquete (Radio Cards) -->
          <div class="pdp-bundle-block">
            <div class="pdp-bundle-header">
              <span class="pdp-block-label">Select Bundle</span>
              <span class="pdp-bundle-header-note">Packs 2 &amp; 3 include Free U.S. Shipping</span>
            </div>
            <div class="pdp-bundle-grid">
              <!-- Pack 1 -->
              <div class="pdp-bundle-card pdp-bundle-card--pack1" data-pack="1">
                <input
                  type="radio"
                  id="Variant-Pack1"
                  name="bundle_radio"
                  value="{{ product.variants[0].id | default: current_variant.id }}"
                  class="pdp-bundle__input"
                  data-qty="1"
                  data-price="$25.00"
                  data-available="true"
                >
                <label for="Variant-Pack1" class="pdp-bundle__label">
                  <div class="pdp-bundle__top">
                    <span class="pdp-bundle__name">1 Bottle</span>
                    <span class="pdp-bundle__price">$25</span>
                  </div>
                  <span class="pdp-bundle__duration">2–3 Weeks Routine</span>
                  <span class="pdp-bundle__shipping-note">Shipping calculated at checkout</span>
                </label>
              </div>

              <!-- Pack 2 (MOST POPULAR - DEFAULT SELECTED) -->
              <div class="pdp-bundle-card pdp-bundle-card--pack2 is-selected pdp-bundle-card--popular" data-pack="2">
                <span class="pdp-bundle-badge pdp-bundle-badge--popular">MOST POPULAR</span>
                <input
                  type="radio"
                  id="Variant-Pack2"
                  name="bundle_radio"
                  value="{{ product.variants[0].id | default: current_variant.id }}"
                  class="pdp-bundle__input"
                  data-qty="2"
                  data-price="$50.00"
                  data-available="true"
                  checked
                >
                <label for="Variant-Pack2" class="pdp-bundle__label">
                  <div class="pdp-bundle__top">
                    <span class="pdp-bundle__name">2 Bottles</span>
                    <span class="pdp-bundle__price">$50</span>
                  </div>
                  <span class="pdp-bundle__duration">4–6 Weeks Routine</span>
                  <span class="pdp-bundle__perk">
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                    FREE U.S. SHIPPING
                  </span>
                </label>
              </div>

              <!-- Pack 3 (BEST VALUE) -->
              <div class="pdp-bundle-card pdp-bundle-card--pack3 pdp-bundle-card--value" data-pack="3">
                <span class="pdp-bundle-badge pdp-bundle-badge--value">BEST VALUE</span>
                <input
                  type="radio"
                  id="Variant-Pack3"
                  name="bundle_radio"
                  value="{{ product.variants[0].id | default: current_variant.id }}"
                  class="pdp-bundle__input"
                  data-qty="3"
                  data-price="$60.00"
                  data-available="true"
                >
                <label for="Variant-Pack3" class="pdp-bundle__label">
                  <div class="pdp-bundle__top">
                    <span class="pdp-bundle__name">3 Bottles</span>
                    <div class="pdp-bundle__prices">
                      <s class="pdp-bundle__compare">$75</s>
                      <span class="pdp-bundle__price">$60</span>
                    </div>
                  </div>
                  <span class="pdp-bundle__duration">$20 per bottle</span>
                  <span class="pdp-bundle__savings">SAVE $15 + FREE SHIPPING</span>
                </label>
              </div>
            </div>
          </div>

          <!-- 4.7 Quantity Stepper -->
          <div class="pdp-qty-block">
            <span class="pdp-block-label">Quantity</span>
            <div class="pdp-qty-row">
              <div class="pdp-qty-stepper">
                <button type="button" class="pdp-qty-btn" id="PdpQtyMinus" aria-label="Decrease quantity">−</button>
                <input
                  type="number"
                  name="quantity"
                  id="PdpQuantityInput"
                  value="2"
                  min="1"
                  inputmode="numeric"
                  class="pdp-qty-input"
                  aria-label="Item quantity"
                >
                <button type="button" class="pdp-qty-btn" id="PdpQtyPlus" aria-label="Increase quantity">+</button>
              </div>

              <!-- Indicador de Compra al por Mayor -->
              <div class="pdp-wholesale-indicator" id="PdpWholesaleIndicator">
                <span class="pdp-wholesale-badge">10+ units — wholesale pricing inquiry</span>
              </div>

              {%- if cart_item_count > 0 -%}
                <span class="pdp-cart-count-note">({{ cart_item_count }} in cart)</span>
              {%- endif -%}
            </div>
          </div>

          <!-- 4.8 Direct Checkout Actions -->
          <div class="pdp-actions" id="PdpActionsContainer">
            <button
              type="submit"
              name="add"
              id="PdpAddToCartBtn"
              class="pdp-btn pdp-btn--primary pdp-btn--checkout"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span id="PdpAddToCartText">
                {%- if current_variant.available -%}
                  CHECKOUT — SECURE PAYMENT
                {%- else -%}
                  Sold Out
                {%- endif -%}
              </span>
              <svg class="pdp-btn__arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>

            <!-- Checkout Dinámico (Shop Pay, Apple Pay, PayPal) -->
            {%- if current_variant.available -%}
              <div class="pdp-dynamic-checkout" id="PdpDynamicCheckoutWrap">
                {{ form | payment_button }}
              </div>
            {%- endif -%}

            <!-- Botón de Contacto por WhatsApp para Mayoreo -->
            <a
              href="#"
              id="PdpWhatsAppBtn"
              class="pdp-btn pdp-btn--whatsapp is-hidden"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Inquire about wholesale order on WhatsApp"
            >
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span>Inquire Wholesale on WhatsApp</span>
            </a>
          </div>

          <!-- 4.9 Compact Trust Badges (Point 4 CRO) -->
          <div class="pdp-trust-bar">
            <div class="pdp-trust-item">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#2F7A6B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <span>Secure Checkout</span>
            </div>
            <div class="pdp-trust-item">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#2F7A6B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              <span>Fast U.S. Shipping (FL)</span>
            </div>
            <div class="pdp-trust-item">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#2F7A6B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              <span>Easy Order Support</span>
            </div>
          </div>

          <!-- Payment Security Row -->
          <div class="pdp-payment-icons">
            <span class="pdp-payment-icons__label">Guaranteed safe &amp; secure checkout:</span>
            <div class="pdp-payment-icons__list">
              <span class="pdp-pay-pill">Shop Pay</span>
              <span class="pdp-pay-pill">Apple Pay</span>
              <span class="pdp-pay-pill">Google Pay</span>
              <span class="pdp-pay-pill">PayPal</span>
              <span class="pdp-pay-pill">Visa</span>
              <span class="pdp-pay-pill">Mastercard</span>
              <span class="pdp-pay-pill">Amex</span>
            </div>
          </div>

        {%- endform -%}

        <!-- 4.9 Filas de Confianza -->
        <ul class="pdp-trust-rows">
          {%- for block in section.blocks -%}
            {%- if block.type == 'fila_confianza' -%}
              <li class="pdp-trust-row" {{ block.shopify_attributes }}>
                <span class="pdp-trust-row__icon-wrap">
                  {%- case block.settings.icono -%}
                    {%- when 'camion' -%}
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#2F7A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    {%- when 'pin' -%}
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#2F7A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    {%- when 'reloj' -%}
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#2F7A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  {%- endcase -%}
                </span>
                <span class="pdp-trust-row__text">{{ block.settings.texto | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        <!-- 4.10 Caja de Garantía (Solo si setting no está vacío) -->
        {%- if section.settings.texto_garantia != blank -%}
          <div class="pdp-guarantee-box">
            <svg class="pdp-guarantee-box__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#2F7A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <div class="pdp-guarantee-box__content">
              {{ section.settings.texto_garantia }}
            </div>
          </div>
        {%- endif -%}

        <!-- 4.11 Acordeones Nativos -->
        <div class="pdp-accordions">
          {%- for block in section.blocks -%}
            {%- if block.type == 'acordeon' -%}
              <details class="pdp-accordion" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
                <summary class="pdp-accordion__summary">
                  <span class="pdp-accordion__title">{{ block.settings.titulo | escape }}</span>
                  <svg class="pdp-accordion__chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#93A896" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </summary>
                <div class="pdp-accordion__content">
                  {{ block.settings.contenido }}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>

      </div>

    </div>

    <!-- 5. FILA DE PRODUCTOS RELACIONADOS -->
    {%- if section.settings.mostrar_relacionados -%}
      {%- assign rel_collection = collections[section.settings.coleccion_relacionados] | default: collections.all -%}
      {%- if rel_collection and rel_collection.products.size > 0 -%}
        <div class="onv-pdp__related">
          <h2 class="onv-pdp__related-title">Combina perfectamente con…</h2>
          <div class="onv-pdp__related-grid">
            {%- assign count = 0 -%}
            {%- for rel_prod in rel_collection.products -%}
              {%- if rel_prod.id != product.id and count < 4 -%}
                {%- assign count = count | plus: 1 -%}
                <a href="{{ rel_prod.url }}" class="onv-pdp__related-card">
                  <div class="onv-pdp__related-media">
                    <img
                      src="{{ rel_prod.featured_image | image_url: width: 400 }}"
                      alt="{{ rel_prod.title | escape }}"
                      width="400"
                      height="400"
                      loading="lazy"
                    >
                  </div>
                  <h3 class="onv-pdp__related-name">{{ rel_prod.title | escape }}</h3>
                  <span class="onv-pdp__related-price">{{ rel_prod.price | money }}</span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>

  <!-- LIGHTBOX MODAL DE ZOOM -->
  <div id="PdpLightboxModal" class="pdp-lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Enlarged product image view">
    <div class="pdp-lightbox__backdrop" id="PdpLightboxBackdrop"></div>
    <div class="pdp-lightbox__content">
      <button type="button" class="pdp-lightbox__close" id="PdpLightboxClose" aria-label="Close modal">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <img id="PdpLightboxImg" src="" alt="{{ product.title | escape }}" class="pdp-lightbox__img" width="1200" height="1200" loading="lazy">
    </div>
  </div>
</section>

{% style %}
  .onv-pdp-section {
    background-color: #ffffff;
    padding-top: 32px;
    padding-bottom: clamp(4rem, 8vw, 6rem);
    width: 100%;
    box-sizing: border-box;
  }

  .onv-pdp__container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding-inline: 24px;
    box-sizing: border-box;
  }

  @media (max-width: 749px) {
    .onv-pdp__container {
      padding-inline: 12px;
    }
  }

  /* 2. Breadcrumb */
  .onv-pdp__breadcrumb {
    width: 100%;
    margin-bottom: 24px;
  }

  .onv-pdp__breadcrumb-list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    font-family: var(--font-ui, 'Karla', sans-serif);
    font-weight: 400;
    font-size: 13.5px !important;
    color: #93A896;
  }

  .onv-pdp__breadcrumb-link {
    color: #93A896;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .onv-pdp__breadcrumb-link:hover {
    color: #1B3A2F;
    text-decoration: underline;
  }

  .onv-pdp__breadcrumb-sep {
    margin-inline: 8px;
    color: #93A896;
    user-select: none;
  }

  .onv-pdp__breadcrumb-item--current {
    color: #4A5A52;
  }

  /* Layout 2 Columnas */
  .onv-pdp__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: start;
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 1000px) {
    .onv-pdp__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(400px, 0.9fr);
      gap: 48px;
    }

    .onv-pdp__gallery--sticky {
      position: sticky;
      top: calc(var(--header-height, 80px) + 24px);
    }
  }

  /* 3. Galería (Estilo Marketplace / Mercado Libre) */
  .onv-gallery {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  @media (max-width: 999px) {
    .pdp-main {
      order: 1;
    }
    .pdp-thumbs-wrapper {
      order: 2;
    }
  }

  @media (min-width: 1000px) {
    .onv-gallery {
      flex-direction: row;
      align-items: flex-start;
      gap: 16px;
    }

    .pdp-thumbs-wrapper {
      order: 1;
      width: 64px;
    }

    .pdp-main {
      order: 2;
    }

    .pdp-thumbs {
      flex-direction: column;
      gap: 8px;
      max-height: 440px;
      overflow-y: auto;
      overflow-x: hidden;
      scrollbar-width: thin;
      scrollbar-color: rgba(27, 58, 47, 0.2) transparent;
      padding-right: 2px;
    }

    .pdp-thumbs::-webkit-scrollbar {
      display: block;
      width: 4px;
    }

    .pdp-thumbs::-webkit-scrollbar-thumb {
      background: rgba(27, 58, 47, 0.2);
      border-radius: 4px;
    }

    .pdp-thumbs__item--extra.is-hidden-desktop {
      display: none !important;
    }
  }

  .pdp-thumbs-wrapper {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-shrink: 0;
  }

  .pdp-thumbs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .pdp-thumbs::-webkit-scrollbar {
    display: none;
  }

  .pdp-thumbs__btn {
    width: 64px;
    height: 64px;
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    border: 1px solid #E6E0D2;
    background-color: #FFFFFF;
    cursor: pointer;
    padding: 0;
    display: block;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .pdp-thumbs__btn:hover {
    border-color: #2F7A6B;
    transform: scale(1.03);
  }

  .pdp-thumbs__btn.is-active {
    border: 2px solid #2F7A6B !important;
    box-shadow: 0 2px 10px rgba(47, 122, 107, 0.25);
  }

  .pdp-thumbs__btn:focus-visible {
    outline: 2px solid #2F7A6B;
    outline-offset: 2px;
  }

  .pdp-thumbs__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Botón 'Más imágenes' */
  .pdp-thumbs__more-btn {
    width: 100%;
    padding: 6px 4px;
    background: #F6F2E9;
    border: 1px dashed #C6A264;
    border-radius: 8px;
    font-family: var(--font-ui, 'Karla', sans-serif);
    font-size: 11px;
    font-weight: 700;
    color: #1B3A2F;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .pdp-thumbs__more-btn:hover {
    background: #EAE3D5;
    border-color: #1B3A2F;
  }

  /* Imagen Principal */
  .pdp-main {
    flex: 1 1 auto;
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    background-color: #FFFFFF;
    border: 1px solid rgba(27, 58, 47, 0.08);
    border-radius: 14px;
    padding: 0;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(19, 46, 35, 0.04);
  }

  .pdp-main__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.25s ease;
  }

  /* Flechas de Navegación sobre la Imagen Principal */
  .pdp-main__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    border: 1px solid rgba(27, 58, 47, 0.12);
    color: #1B3A2F;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 6;
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
  }

  .pdp-main__nav:hover {
    background: #FFFFFF;
    color: #2F7A6B;
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
  }

  .pdp-main__nav:active {
    transform: translateY(-50%) scale(0.95);
  }

  .pdp-main__nav--prev {
    left: 14px;
  }

  .pdp-main__nav--next {
    right: 14px;
  }

  .pdp-main__zoom-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 38px;
    height: 38px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(27, 58, 47, 0.12);
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
    transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .pdp-main__zoom-btn:hover {
    background-color: #FFFFFF;
    transform: scale(1.08);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.14);
  }

  /* 4. Buy Box */
  .onv-pdp__buybox {
    display: flex;
    flex-direction: column;
    width: 100%;
    box-sizing: border-box;
  }

  /* 4.1 Marca */
  .pdp-brand {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 700 !important;
    font-size: 13px !important;
    text-transform: uppercase !important;
    letter-spacing: 0.18em !important;
    color: #2F7A6B !important;
    margin-bottom: 10px;
    display: block;
  }

  /* 4.2 Título */
  .pdp-title {
    font-family: var(--font-display, "Playfair Display", Georgia, serif) !important;
    font-weight: 600 !important;
    font-size: clamp(24px, 2.8vw, 34px) !important;
    line-height: 1.15 !important;
    color: #1B3A2F !important;
    margin: 0 0 12px 0 !important;
  }

  /* 4.3 Estrellas + Conteo */
  .pdp-reviews-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
  }

  .pdp-stars {
    display: inline-flex;
    gap: 3px;
    align-items: center;
  }

  .pdp-star {
    width: 16px;
    height: 16px;
  }

  .pdp-reviews-count {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 400 !important;
    font-size: 14px !important;
    color: #4A5A52 !important;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .pdp-reviews-count:hover {
    color: #1B3A2F !important;
    text-decoration: underline;
  }

  /* 4.4 Precios */
  .pdp-price-wrap {
    margin-bottom: 20px;
  }

  .pdp-price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .pdp-price {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 700 !important;
    font-size: 28px !important;
    color: #1B3A2F !important;
  }

  .pdp-price-compare {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 400 !important;
    font-size: 17px !important;
    color: #93A896 !important;
    text-decoration: line-through;
  }

  .pdp-discount-badge {
    background-color: #C0392B;
    color: #FFFFFF !important;
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 700 !important;
    font-size: 12px !important;
    padding: 4px 8px;
    border-radius: 4px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
  }

  .pdp-tax-note {
    display: block;
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 400 !important;
    font-size: 13px !important;
    color: #93A896 !important;
    margin-top: 4px;
  }

  /* Above the Fold Cosmetic Hook */
  .pdp-cosmetic-hook {
    margin-bottom: 16px;
    padding: 12px 14px;
    background-color: #F8F6F0;
    border-left: 3px solid #2F7A6B;
    border-radius: 0 8px 8px 0;
  }

  .pdp-cosmetic-heading {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-size: 15px !important;
    font-weight: 700 !important;
    color: #1B3A2F !important;
    margin: 0 0 4px 0 !important;
    line-height: 1.3 !important;
  }

  .pdp-cosmetic-subhead {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-size: 13.5px !important;
    color: #4A5A52 !important;
    line-height: 1.4 !important;
    margin: 0 !important;
  }

  /* Free Shipping Dynamic Teaser */
  .pdp-shipping-teaser {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-size: 13px !important;
    color: #2F7A6B !important;
    background: #EAF4F0;
    padding: 6px 12px;
    border-radius: 6px;
    margin-top: 8px;
    font-weight: 500;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .pdp-shipping-teaser.has-unlocked {
    background: #D8EDE4;
    color: #1B3A2F !important;
    font-weight: 600;
  }

  .pdp-shipping-teaser svg {
    flex-shrink: 0;
  }

  /* Etiquetas de Bloque */
  .pdp-block-label {
    display: block;
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 700 !important;
    font-size: 14.5px !important;
    color: #1B3A2F !important;
    margin-bottom: 10px;
  }

  /* 4.5 Chips de Especificación */
  .pdp-chips-block {
    margin-bottom: 24px;
  }

  .pdp-chips-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pdp-chip {
    background-color: #FFFFFF;
    border: 1px solid #E6E0D2;
    border-radius: 999px;
    padding: 8px 14px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 600 !important;
    font-size: 12px !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    color: #1B3A2F !important;
  }

  .pdp-chip__icon {
    flex-shrink: 0;
    width: 15px;
    height: 15px;
  }

  /* 4.6 Selector de Paquete (Radio Cards) */
  .pdp-bundle-block {
    margin-bottom: 22px;
  }

  .pdp-bundle-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 10px;
    flex-wrap: wrap;
    gap: 6px;
  }

  .pdp-bundle-header-note {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-size: 12.5px !important;
    color: #2F7A6B !important;
    font-weight: 600;
  }

  .pdp-bundle-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  @media (max-width: 580px) {
    .pdp-bundle-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }

  .pdp-bundle-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    border: 1.5px solid #E6E0D2;
    background-color: #FFFFFF;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
  }

  .pdp-bundle-card:hover {
    border-color: #2F7A6B;
  }

  .pdp-bundle-card.is-selected {
    border: 2.5px solid #1B3A2F !important;
    background-color: #F8F6F0 !important;
    box-shadow: 0 4px 14px rgba(27, 58, 47, 0.1) !important;
  }

  .pdp-bundle-card--popular {
    border-color: #C6A264;
  }

  .pdp-bundle-card--popular.is-selected {
    border: 2.5px solid #1B3A2F !important;
  }

  .pdp-bundle-badge--popular {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    background-color: #C6A264;
    color: #1B3A2F !important;
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 800 !important;
    font-size: 10.5px !important;
    padding: 3px 10px;
    border-radius: 999px;
    white-space: nowrap;
    z-index: 2;
    letter-spacing: 0.06em;
    box-shadow: 0 2px 6px rgba(198, 162, 100, 0.4);
  }

  .pdp-bundle-badge--value {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    background-color: #1B3A2F;
    color: #F6F2E9 !important;
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-weight: 800 !important;
    font-size: 10.5px !important;
    padding: 3px 10px;
    border-radius: 999px;
    white-space: nowrap;
    z-index: 2;
    letter-spacing: 0.06em;
    box-shadow: 0 2px 6px rgba(27, 58, 47, 0.35);
  }

  .pdp-bundle__input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .pdp-bundle__input:focus-visible + .pdp-bundle__label {
    outline: 2px solid #2F7A6B;
    outline-offset: 2px;
  }

  .pdp-bundle__label {
    padding: 16px 12px 14px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 4px;
