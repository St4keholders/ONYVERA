{%- comment -%}
  ONYVERA — Sección: Hero Full-Bleed (Desktop & Mobile)
  Carrusel automático de 3 imágenes en desktop (cada 4s), 1 imagen en mobile.
  Todos los slides son position:absolute para garantizar el crossfade.
{%- endcomment -%}

{%- liquid
  assign desktop_image_url = 'onv-hero-desktop.jpeg' | asset_url
  if section.settings.desktop_image != blank
    assign desktop_image_url = section.settings.desktop_image | image_url: width: 3800
  endif

  assign mobile_image_url = 'onv-hero-mobile.jpeg' | asset_url
  if section.settings.mobile_image != blank
    assign mobile_image_url = section.settings.mobile_image | image_url: width: 1080
  endif

  assign hero2_url = 'onv-hero2.jpeg' | asset_url
  if section.settings.image_2 != blank
    assign hero2_url = section.settings.image_2 | image_url: width: 3800
  endif

  assign hero3_url = 'onv-hero3.jpeg' | asset_url
  if section.settings.image_3 != blank
    assign hero3_url = section.settings.image_3 | image_url: width: 3800
  endif

  assign hero_link = section.settings.link
  if hero_link == blank
    assign target_prod = collections.all.products.first
    if target_prod != blank
      assign hero_link = target_prod.url
    else
      assign hero_link = '/products/onyvera-advanced-nail-fungus-solution-precision-brush-16-ml'
    endif
  endif
-%}

<section id="onv-hero-{{ section.id }}" class="onv-hero-fullbleed" data-autoplay-interval="4000">
  <div class="onv-hero-slider" id="onv-hero-slider-{{ section.id }}">

    <!-- Slide 1 -->
    <div class="onv-hero-slide is-active" data-index="0">
      <a href="{{ hero_link }}" class="onv-hero-fullbleed__link" aria-label="Ver producto ONYVERA">
        <picture class="onv-hero-fullbleed__picture">
          <source media="(max-width: 749px)" srcset="{{ mobile_image_url }}">
          <source media="(min-width: 750px)" srcset="{{ desktop_image_url }}">
          <img
            src="{{ desktop_image_url }}"
            alt="{{ section.settings.alt_text | default: 'ONYVERA Sérum Botánico para Uñas' | escape }}"
            class="onv-hero-fullbleed__img"
            width="2752"
            height="1536"
            loading="eager"
            fetchpriority="high"
          >
        </picture>
      </a>
    </div>

    <!-- Slide 2 (solo desktop) -->
    <div class="onv-hero-slide onv-hero-slide--desktop-only" data-index="1">
      <a href="{{ hero_link }}" class="onv-hero-fullbleed__link" aria-label="Ver producto ONYVERA - Slide 2">
        <img
          src="{{ hero2_url }}"
          alt="{{ section.settings.alt_text | default: 'ONYVERA Cuidado Avanzado' | escape }}"
          class="onv-hero-fullbleed__img"
          width="2752"
          height="1536"
          loading="lazy"
        >
      </a>
    </div>

    <!-- Slide 3 (solo desktop) -->
    <div class="onv-hero-slide onv-hero-slide--desktop-only" data-index="2">
      <a href="{{ hero_link }}" class="onv-hero-fullbleed__link" aria-label="Ver producto ONYVERA - Slide 3">
        <img
          src="{{ hero3_url }}"
          alt="{{ section.settings.alt_text | default: 'ONYVERA Resultados Reales' | escape }}"
          class="onv-hero-fullbleed__img"
          width="2752"
          height="1536"
          loading="lazy"
        >
      </a>
    </div>

    <!-- Indicadores / Dots (solo desktop) -->
    <div class="onv-hero-dots onv-hero-dots--desktop-only" aria-label="Diapositivas del hero">
      <button type="button" class="onv-hero-dot is-active" data-slide-to="0" aria-label="Ir a diapositiva 1"></button>
      <button type="button" class="onv-hero-dot" data-slide-to="1" aria-label="Ir a diapositiva 2"></button>
      <button type="button" class="onv-hero-dot" data-slide-to="2" aria-label="Ir a diapositiva 3"></button>
    </div>

  </div>
</section>

{% style %}
  /* ── Hero contenedor ── */
  .onv-hero-fullbleed {
    width: 100%;
    max-width: 100%;
    position: relative;
    padding: 0;
    margin-top: 0;
    margin-bottom: 0;
    overflow: hidden;
    line-height: 0;
    display: block;
    background-color: #1B3A2F;
  }

  /* ── Slider: altura explícita para que los slides absolutos funcionen ── */
  .onv-hero-slider {
    position: relative;
    width: 100%;
    /* Desktop: 56.8vw = ratio original 1536/2752. max-height 70vh lo recorta en pantallas altas */
    height: clamp(320px, 56vw, 70vh);
    overflow: hidden;
    line-height: 0;
  }

  /* ── Todos los slides: position:absolute sobre el mismo espacio ── */
  .onv-hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease, visibility 0.8s ease;
    pointer-events: none;
    z-index: 1;
  }

  /* Slide activo */
  .onv-hero-slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 2;
  }

  .onv-hero-fullbleed__link {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    line-height: 0;
    text-decoration: none;
    cursor: pointer;
  }

  .onv-hero-fullbleed__picture {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    line-height: 0;
  }

  .onv-hero-fullbleed__img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center center;
    border: none;
    margin: 0;
    padding: 0;
    border-radius: 0;
    box-shadow: none;
  }

  /* ── Dots ── */
  .onv-hero-dots {
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 10;
    background: rgba(27, 58, 47, 0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 6px 12px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .onv-hero-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .onv-hero-dot.is-active {
    width: 24px;
    border-radius: 6px;
    background: #ffffff;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
  }

  /* ── Mobile: solo slide 1, sin carrusel ── */
  @media (max-width: 749px) {
    .onv-hero-slider {
      /* Mobile: altura proporcional a la imagen de celular */
      height: clamp(240px, 75vw, 420px);
    }

    .onv-hero-fullbleed__img {
      object-position: center top;
    }

    /* Ocultar slides 2 y 3 en mobile */
    .onv-hero-slide--desktop-only {
      display: none !important;
    }

    /* Ocultar dots en mobile */
    .onv-hero-dots--desktop-only {
      display: none !important;
    }
  }
{% endstyle %}

<script>
  (function() {
    function initHeroCarousel() {
      var section = document.getElementById('onv-hero-{{ section.id }}');
      if (!section) return;

      // Solo activar en desktop (>749px)
      if (window.matchMedia('(max-width: 749px)').matches) return;

      var slides = section.querySelectorAll('.onv-hero-slide');
      var dots   = section.querySelectorAll('.onv-hero-dot');

      // Necesitamos al menos 2 slides para el carrusel
      if (slides.length < 2) return;

      var currentIndex = 0;
      var timer = null;
      var intervalMs = parseInt(section.dataset.autoplayInterval, 10) || 4000;

      function goToSlide(index) {
        // Quitar clase activa del slide y dot actuales
        slides[currentIndex].classList.remove('is-active');
        if (dots[currentIndex]) dots[currentIndex].classList.remove('is-active');

        // Calcular índice nuevo (circular)
        currentIndex = ((index % slides.length) + slides.length) % slides.length;

        // Activar nuevo slide y dot
        slides[currentIndex].classList.add('is-active');
        if (dots[currentIndex]) dots[currentIndex].classList.add('is-active');
      }

      function nextSlide() { goToSlide(currentIndex + 1); }

      function startTimer() {
        clearInterval(timer);
        timer = setInterval(nextSlide, intervalMs);
      }

      function stopTimer() { clearInterval(timer); }

      // Eventos en dots
      dots.forEach(function(dot) {
        dot.addEventListener('click', function(e) {
          e.preventDefault();
          var idx = parseInt(dot.dataset.slideTo, 10);
          if (!isNaN(idx)) { goToSlide(idx); startTimer(); }
        });
      });

      // Pausar en hover, reanudar al salir
      section.addEventListener('mouseenter', stopTimer);
      section.addEventListener('mouseleave', startTimer);

      // Arrancar automáticamente
      startTimer();
    }

    // Asegurarse de que el DOM esté listo
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroCarousel);
    } else {
      initHeroCarousel();
    }
  })();
</script>

{% schema %}
{
  "name": "ONV Hero Full-Bleed",
  "tag": "section",
  "class": "section-onv-hero-fullbleed",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Slide 1: Computador (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Slide 1: Celular (Mobile)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Slide 2: Imagen"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Slide 3: Imagen"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace al hacer clic en el Hero"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Texto alternativo (Accesibilidad)",
      "default": "ONYVERA Sérum Botánico para Uñas"
    }
  ],
  "presets": [
    {
      "name": "ONV Hero Full-Bleed"
    }
  ]
}
{% endschema %}
