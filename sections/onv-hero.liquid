{%- comment -%}
  ONYVERA — Sección: Hero Full-Bleed (Desktop & Mobile)
  Desktop: Carrusel automático de 3 imágenes panorámicas (cada 4s).
  Mobile: Carrusel automático en loop de 2 imágenes (onv-cellnewhero.jpeg y onv-cellnewhero2.jpeg, cada 4s).
{%- endcomment -%}

{%- liquid
  assign desktop_image_url = 'onv-heronew3.jpg' | asset_url | append: '&v=20260913_desktop'
  if section.settings.desktop_image != blank
    assign desktop_image_url = section.settings.desktop_image | image_url: width: 3800
  endif

  assign hero2_url = 'onv-heronew2.jpg' | asset_url | append: '&v=20260913_desktop2'
  if section.settings.image_2 != blank
    assign hero2_url = section.settings.image_2 | image_url: width: 3800
  endif

  assign hero3_url = 'onv-heronew1.jpg' | asset_url | append: '&v=20260913_desktop'
  if section.settings.image_3 != blank
    assign hero3_url = section.settings.image_3 | image_url: width: 3800
  endif

  assign mobile_image_1_url = 'onv-cellnewhero.jpeg' | asset_url
  if section.settings.mobile_image != blank
    assign mobile_image_1_url = section.settings.mobile_image | image_url: width: 1792
  endif

  assign mobile_image_2_url = 'onv-cellnewhero2.jpeg' | asset_url
  if section.settings.mobile_image_2 != blank
    assign mobile_image_2_url = section.settings.mobile_image_2 | image_url: width: 1792
  endif

  assign hero_link = section.settings.link
  if hero_link == blank
    assign target_prod = collections.all.products.first
    if target_prod != blank
      assign hero_link = target_prod.url
    else
      assign hero_link = '/products/onyvera-advanced-nail-fungus-solution-precision-brush-16-ml'
    endif
  endif
-%}

<section id="onv-hero-{{ section.id }}" class="onv-hero-fullbleed" data-autoplay-interval="4000">

  <!-- ================= DESKTOP SLIDER (>= 750px) ================= -->
  <div class="onv-hero-slider onv-hero-slider--desktop" id="onv-hero-slider-desktop-{{ section.id }}">
    <!-- Desktop Slide 1 -->
    <div class="onv-hero-slide onv-hero-slide--desktop is-active" data-index="0">
      <a href="{{ hero_link }}" class="onv-hero-fullbleed__link" aria-label="Ver producto ONYVERA - Slide 1">
        <img
          src="{{ desktop_image_url }}"
          alt="{{ section.settings.alt_text | default: 'ONYVERA Sérum Botánico para Uñas' | escape }}"
          class="onv-hero-fullbleed__img"
          width="3488"
          height="1216"
          loading="eager"
          fetchpriority="high"
        >
      </a>
    </div>

    <!-- Desktop Slide 2 -->
    <div class="onv-hero-slide onv-hero-slide--desktop" data-index="1">
      <a href="{{ hero_link }}" class="onv-hero-fullbleed__link" aria-label="Ver producto ONYVERA - Slide 2">
        <img
          src="{{ hero2_url }}"
          alt="{{ section.settings.alt_text | default: 'ONYVERA Cuidado Avanzado' | escape }}"
          class="onv-hero-fullbleed__img"
          width="3488"
          height="1216"
          loading="lazy"
        >
      </a>
    </div>

    <!-- Desktop Slide 3 -->
    <div class="onv-hero-slide onv-hero-slide--desktop" data-index="2">
      <a href="{{ hero_link }}" class="onv-hero-fullbleed__link" aria-label="Ver producto ONYVERA - Slide 3">
        <img
          src="{{ hero3_url }}"
          alt="{{ section.settings.alt_text | default: 'ONYVERA Resultados Reales' | escape }}"
          class="onv-hero-fullbleed__img"
          width="3488"
          height="1216"
          loading="lazy"
        >
      </a>
    </div>

    <!-- Desktop Dots -->
    <div class="onv-hero-dots onv-hero-dots--desktop" aria-label="Diapositivas del hero en computador">
      <button type="button" class="onv-hero-dot is-active" data-slide-to="0" aria-label="Ir a diapositiva 1"></button>
      <button type="button" class="onv-hero-dot" data-slide-to="1" aria-label="Ir a diapositiva 2"></button>
      <button type="button" class="onv-hero-dot" data-slide-to="2" aria-label="Ir a diapositiva 3"></button>
    </div>
  </div>

  <!-- ================= MOBILE SLIDER (< 750px) ================= -->
  <div class="onv-hero-slider onv-hero-slider--mobile" id="onv-hero-slider-mobile-{{ section.id }}">
    <!-- Mobile Slide 1: Primera nueva -->
    <div class="onv-hero-slide onv-hero-slide--mobile is-active" data-index="0">
      <a href="{{ hero_link }}" class="onv-hero-fullbleed__link" aria-label="Ver producto ONYVERA - Móvil 1">
        <img
          src="{{ mobile_image_1_url }}"
          alt="{{ section.settings.alt_text | default: 'ONYVERA Máximo Poder Sérum' | escape }}"
          class="onv-hero-fullbleed__img"
          width="1792"
          height="2400"
          loading="eager"
          fetchpriority="high"
        >
      </a>
    </div>

    <!-- Mobile Slide 2: Segunda nueva -->
    <div class="onv-hero-slide onv-hero-slide--mobile" data-index="1">
      <a href="{{ hero_link }}" class="onv-hero-fullbleed__link" aria-label="Ver producto ONYVERA - Móvil 2">
        <img
          src="{{ mobile_image_2_url }}"
          alt="{{ section.settings.alt_text | default: 'ONYVERA Restauración de Uñas' | escape }}"
          class="onv-hero-fullbleed__img"
          width="1792"
          height="2400"
          loading="lazy"
        >
      </a>
    </div>

    <!-- Mobile Dots (2 indicadores) -->
    <div class="onv-hero-dots onv-hero-dots--mobile" aria-label="Diapositivas del hero en celular">
      <button type="button" class="onv-hero-dot is-active" data-slide-to="0" aria-label="Ir a imagen móvil 1"></button>
      <button type="button" class="onv-hero-dot" data-slide-to="1" aria-label="Ir a imagen móvil 2"></button>
    </div>
  </div>

</section>

{% style %}
  /* ── Hero contenedor ── */
  .onv-hero-fullbleed {
    width: 100%;
    max-width: 100%;
    position: relative;
    padding: 0;
    margin-top: 0;
    margin-bottom: 0;
    overflow: hidden;
    line-height: 0;
    display: block;
    background-color: #1B3A2F;
  }

  /* ── DESKTOP (>= 750px) ── */
  @media (min-width: 750px) {
    .onv-hero-slider--mobile {
      display: none !important;
    }

    .onv-hero-slider--desktop {
      display: block;
      position: relative;
      width: 100%;
      aspect-ratio: 3488 / 1216;
      height: auto;
      overflow: hidden;
      line-height: 0;
    }
  }

  /* ── MOBILE (< 750px) ── */
  @media (max-width: 749px) {
    .onv-hero-slider--desktop {
      display: none !important;
    }

    .onv-hero-slider--mobile {
      display: block;
      position: relative;
      width: 100%;
      aspect-ratio: 1792 / 2400;
      height: auto;
      overflow: hidden;
      line-height: 0;
    }

    .onv-hero-dots--mobile {
      position: absolute;
      bottom: 12px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 6px;
      z-index: 10;
      background: rgba(27, 58, 47, 0.45);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      padding: 4px 10px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.25);
    }

    .onv-hero-dots--mobile .onv-hero-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      border: none;
      background: rgba(255, 255, 255, 0.5);
      cursor: pointer;
      padding: 0;
      transition: all 0.3s ease;
    }

    .onv-hero-dots--mobile .onv-hero-dot.is-active {
      width: 18px;
      border-radius: 4px;
      background: #ffffff;
      box-shadow: 0 0 6px rgba(255, 255, 255, 0.6);
    }
  }

  /* ── Slides comunes (Crossfade) ── */
  .onv-hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease, visibility 0.8s ease;
    pointer-events: none;
    z-index: 1;
  }

  /* Slide activo */
  .onv-hero-slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 2;
  }

  .onv-hero-fullbleed__link {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    line-height: 0;
    text-decoration: none;
    cursor: pointer;
  }

  .onv-hero-fullbleed__img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center center;
    border: none;
    margin: 0;
    padding: 0;
    border-radius: 0;
    box-shadow: none;
  }

  /* ── Dots Desktop ── */
  .onv-hero-dots--desktop {
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 10;
    background: rgba(27, 58, 47, 0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 6px 12px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .onv-hero-dots--desktop .onv-hero-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .onv-hero-dots--desktop .onv-hero-dot.is-active {
    width: 24px;
    border-radius: 6px;
    background: #ffffff;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
  }
{% endstyle %}

<script>
  (function() {
    function initHeroCarousels() {
      var section = document.getElementById('onv-hero-{{ section.id }}');
      if (!section) return;

      var intervalMs = parseInt(section.dataset.autoplayInterval, 10) || 4000;

      function setupCarousel(sliderEl, slideSelector, dotSelector) {
        if (!sliderEl) return null;

        var slides = sliderEl.querySelectorAll(slideSelector);
        var dots   = sliderEl.querySelectorAll(dotSelector);
        if (slides.length < 2) return null;

        var currentIndex = 0;
        var timer = null;

        function goToSlide(index) {
          slides[currentIndex].classList.remove('is-active');
          if (dots[currentIndex]) dots[currentIndex].classList.remove('is-active');

          currentIndex = ((index % slides.length) + slides.length) % slides.length;

          slides[currentIndex].classList.add('is-active');
          if (dots[currentIndex]) dots[currentIndex].classList.add('is-active');
        }

        function nextSlide() { goToSlide(currentIndex + 1); }
        function prevSlide() { goToSlide(currentIndex - 1); }

        function startTimer() {
          stopTimer();
          timer = setInterval(nextSlide, intervalMs);
        }

        function stopTimer() {
          if (timer) {
            clearInterval(timer);
            timer = null;
          }
        }

        // Clic en dots
        dots.forEach(function(dot) {
          dot.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var idx = parseInt(dot.dataset.slideTo, 10);
            if (!isNaN(idx)) {
              goToSlide(idx);
              startTimer();
            }
          });
        });

        // Pausar en hover (desktop)
        sliderEl.addEventListener('mouseenter', stopTimer);
        sliderEl.addEventListener('mouseleave', startTimer);

        // Gesto Touch Swipe (mobile)
        var touchStartX = 0;
        var touchStartY = 0;
        var swipeThreshold = 40;

        sliderEl.addEventListener('touchstart', function(e) {
          if (e.touches && e.touches[0]) {
            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
            stopTimer();
          }
        }, { passive: true });

        sliderEl.addEventListener('touchend', function(e) {
          if (e.changedTouches && e.changedTouches[0]) {
            var diffX = e.changedTouches[0].clientX - touchStartX;
            var diffY = e.changedTouches[0].clientY - touchStartY;

            if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > swipeThreshold) {
              if (diffX < 0) {
                nextSlide();
              } else {
                prevSlide();
              }
            }
          }
          startTimer();
        }, { passive: true });

        // Iniciar loop automático
        startTimer();

        return {
          start: startTimer,
          stop: stopTimer,
          goTo: goToSlide
        };
      }

      // Detener instancias anteriores si se re-renderiza la sección
      if (section.__heroDesktopInstance) section.__heroDesktopInstance.stop();
      if (section.__heroMobileInstance) section.__heroMobileInstance.stop();

      var desktopSlider = section.querySelector('.onv-hero-slider--desktop');
      var mobileSlider = section.querySelector('.onv-hero-slider--mobile');

      section.__heroDesktopInstance = setupCarousel(
        desktopSlider,
        '.onv-hero-slide--desktop',
        '.onv-hero-dots--desktop .onv-hero-dot'
      );

      section.__heroMobileInstance = setupCarousel(
        mobileSlider,
        '.onv-hero-slide--mobile',
        '.onv-hero-dots--mobile .onv-hero-dot'
      );
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroCarousels);
    } else {
      initHeroCarousels();
    }
    document.addEventListener('shopify:section:load', initHeroCarousels);
  })();
</script>

{% schema %}
{
  "name": "ONV Hero Full-Bleed",
  "tag": "section",
  "class": "section-onv-hero-fullbleed",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Slide 1: Computador (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Slide 2: Imagen (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Slide 3: Imagen (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Slide 1: Celular (Mobile) - Imagen 1"
    },
    {
      "type": "image_picker",
      "id": "mobile_image_2",
      "label": "Slide 2: Celular (Mobile) - Imagen 2"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace al hacer clic en el Hero"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Texto alternativo (Accesibilidad)",
      "default": "ONYVERA Sérum Botánico para Uñas"
    }
  ],
  "presets": [
    {
      "name": "ONV Hero Full-Bleed"
    }
  ]
}
{% endschema %}
