{%- comment -%}
  ONYVERA — Sección: Ingredient Banner (Full-Bleed Flat-Lay Banner)
  Banner botánico full-bleed con cápsula en glassmorphism para garantizar 100% de legibilidad y contraste.
{%- endcomment -%}

{%- liquid
  assign banner_img_url = 'onv-Cinta.jpeg' | asset_url
  if section.settings.image != blank
    assign banner_img_url = section.settings.image | image_url: width: 2800
  endif

  assign desktop_ratio = section.settings.desktop_ratio | default: '3:1'
  assign ratio_val = '3 / 1'
  if desktop_ratio == '5:2'
    assign ratio_val = '5 / 2'
  elsif desktop_ratio == '2:1'
    assign ratio_val = '2 / 1'
  endif

  assign text_pos = section.settings.text_position | default: 'left'

  assign target_prod = collections.all.products.first
  if section.settings.link != blank
    assign banner_link = section.settings.link
  elsif target_prod != blank
    assign banner_link = target_prod.url
  else
    assign banner_link = '/products/onyvera-advanced-nail-fungus-solution-precision-brush-16-ml'
  endif
-%}

<section id="onv-ingredient-banner-{{ section.id }}" class="onv-ing-banner">
  <a href="{{ banner_link }}" class="onv-ing-banner__container onv-ing-banner__container--{{ text_pos }}" aria-label="Ver producto ONYVERA">
    
    <picture class="onv-ing-banner__picture">
      <img
        src="{{ banner_img_url }}"
        alt="Tea tree sprig, sliced aloe vera, glycerin and vitamin E beside the ONYVERA nail serum bottle on a cream surface."
        class="onv-ing-banner__img"
        width="2752"
        height="1536"
        loading="lazy"
        decoding="async"
      >
    </picture>

    <div class="onv-ing-banner__scrim" aria-hidden="true"></div>

    <!-- Cápsula Flotante en Glassmorphism de Alta Legibilidad -->
    <div class="onv-ing-banner__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="onv-ing-banner__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="onv-ing-banner__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

  </a>
</section>

{% style %}
  .onv-ing-banner {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding: 0;
    overflow: hidden;
    display: block;
    line-height: 0;
  }

  .onv-ing-banner__container {
    position: relative;
    width: 100%;
    aspect-ratio: {{ ratio_val }};
    overflow: hidden;
    margin: 0;
    padding: 0;
    display: block;
    text-decoration: none;
    cursor: pointer;
  }

  @media (min-width: 600px) and (max-width: 999px) {
    .onv-ing-banner__container {
      aspect-ratio: 5 / 2;
    }
  }

  @media (max-width: 599px) {
    .onv-ing-banner__container {
      aspect-ratio: 3 / 2;
    }
  }

  .onv-ing-banner__picture {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
  }

  .onv-ing-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 48%;
    display: block;
    border: none;
    margin: 0;
    padding: 0;
  }

  /* Scrim de Fondo Suave */
  .onv-ing-banner__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: linear-gradient(
      to right,
      rgba(246, 242, 233, 0.40) 0%,
      rgba(246, 242, 233, 0.15) 30%,
      rgba(246, 242, 233, 0.00) 55%
    );
  }

  /* Cápsula de Texto en Glassmorphism Líquido/Transparente */
  .onv-ing-banner__content {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    left: 4%;
    width: clamp(320px, 36vw, 520px);
    z-index: 2;
    line-height: normal;
    text-align: left;
    box-sizing: border-box;
    background: rgba(255, 255, 255, 0.50);
    backdrop-filter: blur(20px) saturate(1.5);
    -webkit-backdrop-filter: blur(20px) saturate(1.5);
    border: 1px solid rgba(255, 255, 255, 0.40);
    border-radius: 24px;
    padding: 40px 44px;
    box-shadow: 0 12px 40px rgba(19, 46, 35, 0.08);
  }

  .onv-ing-banner__container--center .onv-ing-banner__content {
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
  }

  @media (max-width: 999px) and (min-width: 600px) {
    .onv-ing-banner__content {
      padding: 28px 32px;
      width: clamp(280px, 40vw, 400px);
      border-radius: 20px;
    }
  }

  @media (max-width: 599px) {
    .onv-ing-banner__content {
      top: 50%;
      left: 16px;
      right: auto;
      transform: translateY(-50%);
      width: calc(100% - 32px);
      max-width: 340px;
      padding: 24px 26px;
      border-radius: 16px;
    }
  }

  .onv-ing-banner__eyebrow {
    display: block;
    font-family: var(--font-ui, 'Karla', sans-serif);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 13px;
    color: #1A5E4E;
    margin: 0 0 12px 0;
  }

  .onv-ing-banner__heading {
    font-family: var(--font-display, 'Playfair Display', serif);
    font-weight: 600;
    line-height: 1.10;
    font-size: clamp(32px, 3.5vw, 48px);
    color: #132E23;
    margin: 0;
  }
{% endstyle %}

{% schema %}
{
  "name": "Ingredient banner",
  "tag": "section",
  "class": "section-ingredient-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "BOTANICAL TRANSPARENCY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Five actives. Ten ingredients. Nothing hidden."
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "desktop_ratio",
      "label": "Desktop ratio",
      "options": [
        {
          "value": "3:1",
          "label": "3:1"
        },
        {
          "value": "5:2",
          "label": "5:2"
        },
        {
          "value": "2:1",
          "label": "2:1"
        }
      ],
      "default": "3:1"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace del banner"
    }
  ],
  "presets": [
    {
      "name": "Ingredient banner"
    }
  ]
}
{% endschema %}
