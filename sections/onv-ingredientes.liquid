{%- comment -%}
  ONYVERA — Sección: Ingredientes Botánicos
  5 tarjetas botánicas centradas con layout responsive (grid de 5 columnas en desktop,
  adaptable en tablet y deslizador táctil en móvil) más desplegable INCI centrado.
{%- endcomment -%}

<section
  id="onv-ingredientes-{{ section.id }}"
  class="onv-ingredients"
>
  <div class="onv-ingredients__container">
    <h2 class="visually-hidden">Ingredientes botánicos</h2>

    <!-- 5 Tarjetas Botánicas Centradas -->
    <div class="onv-ingredients__grid">
      <!-- Card 1 -->
      <article class="onv-ingredients__card">
        <div class="onv-ingredients__top">
          <div class="onv-ingredients__icon">
            <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="18" cy="18" r="15" fill="rgba(44, 110, 86, 0.08)"/>
              <path d="M12 24C12 16 18 10 24 10C22 16 18 20 12 24Z" fill="#2C6E56"/>
              <path d="M22 18C22 22 19 25 15 26" stroke="#A8833B" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <span class="onv-ingredients__num">01 · PURIFICANTE</span>
        </div>
        <h3 class="onv-ingredients__name">{{ section.settings.ing_1_name | default: 'Aceite de árbol de té (Melaleuca Alternifolia)' | escape }}</h3>
        <p class="onv-ingredients__desc">{{ section.settings.ing_1_desc | default: 'Aceite botánico muy apreciado en el cuidado de uñas y piel por su acabado limpio y purificante.' | escape }}</p>
      </article>

      <!-- Card 2 -->
      <article class="onv-ingredients__card">
        <div class="onv-ingredients__top">
          <div class="onv-ingredients__icon">
            <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="18" cy="18" r="15" fill="rgba(44, 110, 86, 0.08)"/>
              <path d="M18 7C14 13 11 19 12 27C16 26 21 23 24 17C21 13 19 10 18 7Z" fill="#2C6E56"/>
              <path d="M18 14V22" stroke="#A8833B" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <span class="onv-ingredients__num">02 · CALMANTE</span>
        </div>
        <h3 class="onv-ingredients__name">{{ section.settings.ing_2_name | default: 'Aloe vera' | escape }}</h3>
        <p class="onv-ingredients__desc">{{ section.settings.ing_2_desc | default: 'Acondiciona y calma la piel alrededor del lecho ungueal.' | escape }}</p>
      </article>

      <!-- Card 3 -->
      <article class="onv-ingredients__card">
        <div class="onv-ingredients__top">
          <div class="onv-ingredients__icon">
            <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="18" cy="18" r="15" fill="rgba(44, 110, 86, 0.08)"/>
              <path d="M18 10C18 10 13 16 13 19.5C13 22.5 15.2 25 18 25C20.8 25 23 22.5 23 19.5C23 16 18 10 18 10Z" fill="#2C6E56"/>
              <circle cx="18" cy="20" r="2" fill="#A8833B"/>
            </svg>
          </div>
          <span class="onv-ingredients__num">03 · HIDRATANTE</span>
        </div>
        <h3 class="onv-ingredients__name">{{ section.settings.ing_3_name | default: 'Glicerina' | escape }}</h3>
        <p class="onv-ingredients__desc">{{ section.settings.ing_3_desc | default: 'Atrae y retiene la humedad en uñas secas y quebradizas.' | escape }}</p>
      </article>

      <!-- Card 4 -->
      <article class="onv-ingredients__card">
        <div class="onv-ingredients__top">
          <div class="onv-ingredients__icon">
            <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="18" cy="18" r="15" fill="rgba(44, 110, 86, 0.08)"/>
              <path d="M18 9L26 13V19C26 23.5 22.5 27 18 28C13.5 27 10 23.5 10 19V13L18 9Z" stroke="#2C6E56" stroke-width="1.6" fill="none"/>
              <path d="M15 18L17 20L21 16" stroke="#A8833B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="onv-ingredients__num">04 · NUTRICIÓN</span>
        </div>
        <h3 class="onv-ingredients__name">{{ section.settings.ing_4_name | default: 'Provitamina B5 (Pantenol)' | escape }}</h3>
        <p class="onv-ingredients__desc">{{ section.settings.ing_4_desc | default: 'Aporta suavidad y flexibilidad a la uña.' | escape }}</p>
      </article>

      <!-- Card 5 -->
      <article class="onv-ingredients__card">
        <div class="onv-ingredients__top">
          <div class="onv-ingredients__icon">
            <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="18" cy="18" r="15" fill="rgba(44, 110, 86, 0.08)"/>
              <circle cx="18" cy="18" r="7" stroke="#2C6E56" stroke-width="1.6"/>
              <path d="M18 7V9M18 27V29M7 18H9M27 18H29" stroke="#A8833B" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </div>
          <span class="onv-ingredients__num">05 · PROTECCIÓN ANTIOXIDANTE</span>
        </div>
        <h3 class="onv-ingredients__name">{{ section.settings.ing_5_name | default: 'Vitamina E (Acetato de tocoferilo)' | escape }}</h3>
        <p class="onv-ingredients__desc">{{ section.settings.ing_5_desc | default: 'Protección antioxidante para uñas castigadas.' | escape }}</p>
      </article>
    </div>

    <!-- Desplegable INCI Centrado -->
    {%- if section.settings.inci_title != blank -%}
      <div class="onv-ingredients__inci-container">
        <div class="onv-ingredients__inci">
          <details class="onv-ingredients__details">
            <summary class="onv-ingredients__summary">
              <span>{{ section.settings.inci_title | escape }}</span>
              <span class="onv-ingredients__chevron" aria-hidden="true">▼</span>
            </summary>
            <div class="onv-ingredients__inci-body">
              <p class="onv-ingredients__inci-text">{{ section.settings.inci_text | escape }}</p>
              {%- if section.settings.inci_note != blank -%}
                <p class="onv-ingredients__inci-note">{{ section.settings.inci_note | escape }}</p>
              {%- endif -%}
            </div>
          </details>
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{% style %}
  .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .onv-ingredients {
    background-color: #ffffff;
    padding-block: clamp(2rem, 3.5vw, 3.5rem);
    color: #132E23;
    overflow: hidden;
    width: 100%;
  }

  .onv-ingredients__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
    width: 100%;
  }

  .onv-ingredients__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
    width: 100%;
    margin: 0 auto;
    justify-content: center;
    align-items: stretch;
  }

  .onv-ingredients__card {
    width: 100%;
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid rgba(19, 46, 35, 0.08);
    padding: 20px 18px;
    box-shadow: 0 4px 16px rgba(19, 46, 35, 0.04);
    display: flex;
    flex-direction: column;
    gap: 8px;
    box-sizing: border-box;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .onv-ingredients__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(19, 46, 35, 0.08);
    border-color: rgba(44, 110, 86, 0.2);
  }

  .onv-ingredients__top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 2px;
  }

  .onv-ingredients__icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }

  .onv-ingredients__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .onv-ingredients__num {
    font-family: var(--font-ui, 'Karla', sans-serif);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #A8833B;
    text-transform: uppercase;
  }

  .onv-ingredients__name {
    font-family: var(--font-display, 'Playfair Display', serif);
    font-size: 16px;
    font-weight: 700;
    color: #132E23;
    margin: 0;
    line-height: 1.25;
  }

  .onv-ingredients__desc {
    font-family: var(--font-ui, 'Karla', sans-serif);
    font-size: 12px;
    color: #4A5A52;
    margin: 0;
    line-height: 1.45;
  }

  /* Desplegable INCI */
  .onv-ingredients__inci-container {
    max-width: 650px;
    margin: 32px auto 0;
    padding: 0;
    box-sizing: border-box;
  }

  .onv-ingredients__inci {
    width: 100%;
  }

  .onv-ingredients__details {
    background: #fafafa;
    border: 1px solid rgba(19, 46, 35, 0.08);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .onv-ingredients__details[open] {
    border-color: rgba(44, 110, 86, 0.25);
  }

  .onv-ingredients__summary {
    padding: 14px 18px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-ui, 'Karla', sans-serif);
    font-size: 13px;
    font-weight: 600;
    color: #2C6E56;
    list-style: none;
    user-select: none;
  }

  .onv-ingredients__summary::-webkit-details-marker {
    display: none;
  }

  .onv-ingredients__chevron {
    font-size: 11px;
    transition: transform 0.2s ease;
  }

  .onv-ingredients__details[open] .onv-ingredients__chevron {
    transform: rotate(180deg);
  }

  .onv-ingredients__inci-body {
    padding: 12px 18px 16px;
    border-top: 1px solid rgba(19, 46, 35, 0.06);
  }

  .onv-ingredients__inci-text {
    font-family: var(--font-ui, 'Karla', sans-serif);
    font-size: 11px;
    color: #4A5A52;
    margin: 0 0 6px 0;
    line-height: 1.45;
  }

  .onv-ingredients__inci-note {
    font-family: var(--font-ui, 'Karla', sans-serif);
    font-size: 10.5px;
    color: #2C6E56;
    font-weight: 700;
    margin: 0;
  }

  /* Responsive: Tablets (768px - 1199px) */
  @media (max-width: 1199px) and (min-width: 768px) {
    .onv-ingredients__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      justify-content: center;
    }
  }

  /* Responsive: Móviles (< 768px) */
  @media (max-width: 767px) {
    .onv-ingredients__container {
      padding: 0 16px;
    }

    .onv-ingredients__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 12px;
      padding: 4px 16px 16px;
      margin: 0 -16px;
      scrollbar-width: thin;
      scrollbar-color: rgba(27, 58, 47, 0.2) transparent;
      -webkit-overflow-scrolling: touch;
    }

    .onv-ingredients__grid > article {
      flex: 0 0 280px;
      scroll-snap-align: center;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "ONV Ingredientes",
  "tag": "section",
  "class": "section-onv-ingredients",
  "settings": [
    {
      "type": "text",
      "id": "ing_1_name",
      "label": "Ingrediente 1",
      "default": "Aceite de árbol de té (Melaleuca Alternifolia)"
    },
    {
      "type": "text",
      "id": "ing_1_desc",
      "label": "Descripción 1",
      "default": "Aceite botánico muy apreciado en el cuidado de uñas y piel por su acabado limpio y purificante."
    },
    {
      "type": "text",
      "id": "ing_2_name",
      "label": "Ingrediente 2",
      "default": "Aloe vera"
    },
    {
      "type": "text",
      "id": "ing_2_desc",
      "label": "Descripción 2",
      "default": "Acondiciona y calma la piel alrededor del lecho ungueal."
    },
    {
      "type": "text",
      "id": "ing_3_name",
      "label": "Ingrediente 3",
      "default": "Glicerina"
    },
    {
      "type": "text",
      "id": "ing_3_desc",
      "label": "Descripción 3",
      "default": "Atrae y retiene la humedad en uñas secas y quebradizas."
    },
    {
      "type": "text",
      "id": "ing_4_name",
      "label": "Ingrediente 4",
      "default": "Provitamina B5 (Pantenol)"
    },
    {
      "type": "text",
      "id": "ing_4_desc",
      "label": "Descripción 4",
      "default": "Aporta suavidad y flexibilidad a la uña."
    },
    {
      "type": "text",
      "id": "ing_5_name",
      "label": "Ingrediente 5",
      "default": "Vitamina E (Acetato de tocoferilo)"
    },
    {
      "type": "text",
      "id": "ing_5_desc",
      "label": "Descripción 5",
      "default": "Protección antioxidante para uñas castigadas."
    },
    {
      "type": "text",
      "id": "inci_title",
      "label": "Título INCI",
      "default": "Ver lista completa de ingredientes (Nomenclatura INCI)"
    },
    {
      "type": "textarea",
      "id": "inci_text",
      "label": "Lista INCI",
      "default": "Water (Aqua), Glycerin, Aloe Barbadensis Leaf Juice, Panthenol, Tocopheryl Acetate, Melaleuca Alternifolia (Tea Tree) Leaf Oil, Caprylyl Glycol, Phenoxyethanol, Xanthan Gum, Citric Acid."
    },
    {
      "type": "text",
      "id": "inci_note",
      "label": "Nota de pureza",
      "default": "Fórmula libre de parabenos, sulfatos, ftalatos y fragancias artificiales."
    }
  ],
  "presets": [
    {
      "name": "ONV Ingredientes"
    }
  ]
}
{% endschema %}
