{% style %}
  .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .onv-ingredients {
    background-color: #ffffff;
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
    color: var(--onv-green-900);
    overflow: hidden;
  }

  /* Marquee Strip Full-Bleed */
  .ing-marquee {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
            mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
    padding: 10px 0;
  }

  .ing-marquee__track {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: ing-scroll 60s linear infinite;
  }

  .ing-marquee__track > li {
    flex: 0 0 320px;
    margin-right: 16px;   /* margin, NOT flex gap — gap breaks the -33.3333% math */
    display: flex;        /* stretch cards to equal height */
  }

  @keyframes ing-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-33.3333%); }
  }

  /* Pausa al hover y focus */
  .ing-marquee:hover .ing-marquee__track,
  .ing-marquee:focus-within .ing-marquee__track {
    animation-play-state: paused;
  }

  /* Tarjeta de Ingrediente */
  .onv-ingredients__card {
    width: 100%;
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid rgba(19, 46, 35, 0.08);
    padding: 18px 20px;
    box-shadow: 0 4px 16px rgba(19, 46, 35, 0.04);
    display: flex;
    flex-direction: column;
    gap: 8px;
    box-sizing: border-box;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .onv-ingredients__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(19, 46, 35, 0.08);
    border-color: rgba(44, 110, 86, 0.2);
  }

  .onv-ingredients__top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 2px;
  }

  .onv-ingredients__icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }

  .onv-ingredients__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .onv-ingredients__num {
    font-family: var(--onv-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--onv-gold);
    text-transform: uppercase;
  }

  .onv-ingredients__name {
    font-family: var(--onv-body);
    font-size: 13.5px;
    font-weight: 700;
    color: var(--onv-green-900);
    margin: 0;
    line-height: 1.25;
  }

  .onv-ingredients__desc {
    font-family: var(--onv-body);
    font-size: 12px;
    color: var(--onv-ink-soft);
    margin: 0;
    line-height: 1.4;
  }

  /* Desplegable INCI */
  .onv-ingredients__inci-container {
    max-width: 650px;
    margin: 28px auto 0;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .onv-ingredients__inci {
    width: 100%;
  }

  .onv-ingredients__details {
    background: #fafafa;
    border: 1px solid rgba(19, 46, 35, 0.08);
    border-radius: 12px;
    overflow: hidden;
  }

  .onv-ingredients__summary {
    padding: 12px 16px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--onv-body);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--onv-teal-600);
    list-style: none;
  }

  .onv-ingredients__summary::-webkit-details-marker {
    display: none;
  }

  .onv-ingredients__chevron {
    font-size: 13px;
    transition: transform 0.2s ease;
  }

  .onv-ingredients__details[open] .onv-ingredients__chevron {
    transform: rotate(180deg);
  }

  .onv-ingredients__inci-body {
    padding: 12px 16px 14px;
    border-top: 1px solid rgba(19, 46, 35, 0.06);
  }

  .onv-ingredients__inci-text {
    font-family: var(--onv-body);
    font-size: 11px;
    color: var(--onv-ink-soft);
    margin: 0 0 6px 0;
    line-height: 1.4;
  }

  .onv-ingredients__inci-note {
    font-family: var(--onv-body);
    font-size: 10.5px;
    color: var(--onv-teal-600);
    font-weight: 700;
    margin: 0;
  }

  /* Responsive < 700px */
  @media (max-width: 700px) {
    .ing-marquee__track > li {
      flex: 0 0 260px;
    }
    .ing-marquee__track {
      animation-duration: 45s;
    }
    .onv-ingredients__card {
      padding: 14px 16px;
    }
    .onv-ingredients__name {
      font-size: 12.5px;
    }
    .onv-ingredients__desc {
      font-size: 11px;
    }
  }

  /* Prefers Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .ing-marquee {
      overflow-x: auto;
      scroll-snap-type: x proximity;
    }
    .ing-marquee__track {
      animation: none;
    }
    .ing-marquee__track > li:nth-child(n+6) {
      display: none;
    }
  }
{% endstyle %}

