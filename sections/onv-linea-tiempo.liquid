</section>

<script>
  (function() {
    function initMarqueeTouchPause() {
      const marquee = document.getElementById('onv-reviews-marquee');
      if (!marquee) return;

      marquee.addEventListener('touchstart', function() {
        marquee.classList.add('is-paused');
      }, { passive: true });

      marquee.addEventListener('touchend', function() {
        marquee.classList.remove('is-paused');
      }, { passive: true });

      marquee.addEventListener('click', function() {
        marquee.classList.toggle('is-paused');
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMarqueeTouchPause);
    } else {
      initMarqueeTouchPause();
    }
  })();
</script>

{% style %}
  .onv-routine {
    background-color: #ffffff;
    padding: 24px 0 20px;
    color: var(--onv-green-900);
    overflow: hidden;
  }

  .onv-routine__container {
    max-width: 580px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .onv-routine__header {
    text-align: center;
    margin-bottom: 14px;
    padding: 0 16px;
  }

  .onv-routine__eyebrow {
    font-family: var(--onv-body);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--onv-teal-600);
    text-transform: uppercase;
    margin: 0 0 3px;
  }

  .onv-routine__title {
    font-family: var(--onv-display);
    font-size: clamp(20px, 3vw, 30px);
    font-weight: 600;
    line-height: 1.1;
    color: var(--onv-green-900);
    margin: 0 0 3px;
  }

  .onv-routine__subtitle {
    font-family: var(--onv-body);
    font-size: 11px;
    color: var(--onv-ink-soft);
    margin: 0;
  }

  /* Grid 2x2 en móvil, 4 columnas en desktop */
  .onv-routine__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    width: 100%;
    padding: 0 12px;
    margin-bottom: 22px;
  }

  @media (min-width: 650px) {
    .onv-routine__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      padding: 0 16px;
    }
  }

  .onv-routine__card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid rgba(19, 46, 35, 0.10);
    padding: 14px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: 0 3px 12px rgba(19, 46, 35, 0.05);
  }

  .onv-routine__day {
    display: inline-block;
    font-family: var(--onv-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.10em;
    color: var(--onv-green-900);
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  /* Foto circular en bolita más grande y nítida */
  .onv-routine__thumb-wrap {
    width: 86px;
    height: 86px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 8px;
    border: 2.5px solid #2C6E56;
    box-shadow: 0 4px 14px rgba(44, 110, 86, 0.22);
    flex-shrink: 0;
    background: #ffffff;
  }

  @media (min-width: 650px) {
    .onv-routine__thumb-wrap {
      width: 98px;
      height: 98px;
    }
  }

  .onv-routine__thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .onv-routine__card-title {
    font-family: var(--onv-body);
    font-size: 12px;
    font-weight: 700;
    color: var(--onv-green-900);
    margin: 0 0 3px;
    line-height: 1.2;
  }

  .onv-routine__card-desc {
    font-family: var(--onv-body);
    font-size: 10.5px;
    color: var(--onv-ink-soft);
    margin: 0;
    line-height: 1.3;
    max-width: 150px;
  }

  /* Botón CTA Empezar Rutina */
  .onv-routine__cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-bottom: 22px;
    width: 100%;
    padding: 0 16px;
  }

  .onv-routine__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: #132E23;
    color: #ffffff;
    padding: 13px 24px;
    border-radius: 999px;
    font-family: var(--onv-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(19, 46, 35, 0.22);
    width: 100%;
    max-width: 320px;
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .onv-routine__cta-price {
    background: rgba(255, 255, 255, 0.18);
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
  }

  .onv-routine__cta-btn:hover {
    filter: brightness(1.15);
    transform: translateY(-1px);
  }

  .onv-routine__cta-btn:active {
    transform: scale(0.98);
  }

  .onv-routine__cta-micro {
    font-family: var(--onv-body);
    font-size: 10.5px;
    color: var(--onv-ink-soft);
    margin: 0;
    text-align: center;
  }

  /* Bloque de Testimonios Escritos */
  .onv-routine__reviews-block {
    width: 100%;
    background: #fafafa;
    border-top: 1px solid rgba(19, 46, 35, 0.06);
    border-bottom: 1px solid rgba(19, 46, 35, 0.06);
    padding: 16px 0 18px;
    overflow: hidden;
  }

  .onv-routine__reviews-header {
    text-align: center;
    padding: 0 16px;
    margin-bottom: 12px;
  }

  .onv-routine__reviews-badge {
    display: inline-block;
    font-family: var(--onv-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--onv-teal-600);
    text-transform: uppercase;
    margin-bottom: 2px;
  }

  .onv-routine__reviews-title {
    font-family: var(--onv-display);
    font-size: 18px;
    font-weight: 600;
    color: var(--onv-green-900);
    margin: 0;
  }

  /* Marquee continuo auto-desplazable */
  .onv-reviews-marquee {
    width: 100%;
    overflow: hidden;
    position: relative;
    user-select: none;
  }

  .onv-reviews-marquee__track {
    display: flex;
    width: max-content;
    animation: onv-reviews-slide 34s linear infinite;
  }

  /* Pausar al pasar el cursor o al tocar con el dedo */
  .onv-reviews-marquee:hover .onv-reviews-marquee__track,
  .onv-reviews-marquee:active .onv-reviews-marquee__track,
  .onv-reviews-marquee.is-paused .onv-reviews-marquee__track {
    animation-play-state: paused;
  }

  .onv-reviews-marquee__group {
    display: flex;
    gap: 12px;
    padding-right: 12px;
    flex-shrink: 0;
  }

  .onv-routine__review-card {
    flex: 0 0 250px;
    width: 250px;
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid rgba(19, 46, 35, 0.08);
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 2px 8px rgba(19, 46, 35, 0.04);
  }

  .onv-routine__review-stars {
    color: #A8833B;
    font-size: 13px;
    letter-spacing: 2px;
    margin-bottom: 4px;
  }

  .onv-routine__review-quote {
    font-family: var(--onv-body);
    font-size: 11px;
    line-height: 1.35;
    color: var(--onv-ink);
    margin: 0 0 8px 0;
    font-style: italic;
  }

  .onv-routine__review-author {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px solid rgba(19, 46, 35, 0.06);
  }

  .onv-routine__review-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(44, 110, 86, 0.12);
    color: var(--onv-teal-600);
    font-family: var(--onv-body);
    font-size: 11px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .onv-routine__review-meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .onv-routine__review-name {
    font-family: var(--onv-body);
    font-size: 11px;
    font-weight: 700;
    color: var(--onv-green-900);
    line-height: 1.2;
  }

  .onv-routine__review-tag {
    font-family: var(--onv-body);
    font-size: 9px;
    color: var(--onv-teal-600);
    font-weight: 600;
  }

  @keyframes onv-reviews-slide {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "ONV Rutina Semanas",
  "tag": "section",
  "class": "section-onv-routine",
  "presets": [
    {
      "name": "ONV Rutina Semanas"
    }
  ]
}
{% endschema %}
