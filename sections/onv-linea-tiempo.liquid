{%- comment -%}
  ONYVERA — Sección: Rutina de 4 Semanas + Carrusel Auto-desplazable de Reseñas
  4 tarjetas con fotos circulares de progreso + Carrusel de testimonios que se desplaza solo y se pausa al tocarlo.
{%- endcomment -%}

<section
  id="onv-linea-tiempo-{{ section.id }}"
  class="onv-routine"
>
  <div class="onv-routine__container">

    <!-- Encabezado diferenciado -->
    <div class="onv-routine__header">
      <p class="onv-routine__eyebrow">EVOLUCIÓN REAL</p>
      <h2 class="onv-routine__title">Tu rutina de 4 semanas</h2>
      <p class="onv-routine__subtitle">Resultados progresivos con la constancia diaria.</p>
    </div>

    <!-- Grilla 2x2 con las 4 fotos circulares de progreso -->
    <div class="onv-routine__grid">

      <!-- Día 1 -->
      <article class="onv-routine__card">
        <span class="onv-routine__day">DÍA 1</span>
        <div class="onv-routine__thumb-wrap">
          <img
            src="{{ 'onv-dia-uno.png' | asset_url }}"
            alt="Transformación uña Día 1"
            width="72"
            height="72"
            loading="lazy"
            class="onv-routine__thumb"
          >
        </div>
        <h3 class="onv-routine__card-title">Inicio del hábito</h3>
        <p class="onv-routine__card-desc">Uña lista y preparada para absorber la fórmula botánica.</p>
      </article>

      <!-- Día 15 -->
      <article class="onv-routine__card">
        <span class="onv-routine__day">DÍA 15</span>
        <div class="onv-routine__thumb-wrap">
          <img
            src="{{ 'onv-dia-15.png' | asset_url }}"
            alt="Transformación uña Día 15"
            width="72"
            height="72"
            loading="lazy"
            class="onv-routine__thumb"
          >
        </div>
        <h3 class="onv-routine__card-title">Superficie suave</h3>
        <p class="onv-routine__card-desc">Textura visiblemente más uniforme y acondicionada.</p>
      </article>

      <!-- Día 30 -->
      <article class="onv-routine__card">
        <span class="onv-routine__day">DÍA 30</span>
        <div class="onv-routine__thumb-wrap">
          <img
            src="{{ 'onv-dia-30.png' | asset_url }}"
            alt="Transformación uña Día 30"
            width="72"
            height="72"
            loading="lazy"
            class="onv-routine__thumb"
          >
        </div>
        <h3 class="onv-routine__card-title">Nutrición visible</h3>
        <p class="onv-routine__card-desc">Cutículas hidratadas y lecho ungueal fortalecido.</p>
      </article>

      <!-- Día 45 -->
      <article class="onv-routine__card">
        <span class="onv-routine__day">DÍA 45</span>
        <div class="onv-routine__thumb-wrap">
          <img
            src="{{ 'onv-dia-45.png' | asset_url }}"
            alt="Transformación uña Día 45"
            width="72"
            height="72"
            loading="lazy"
            class="onv-routine__thumb"
          >
        </div>
        <h3 class="onv-routine__card-title">Crecimiento limpio</h3>
        <p class="onv-routine__card-desc">Uña renovada, clara y protegida desde la raíz.</p>
      </article>
    </div>

    {%- liquid
      assign store_product = collections.all.products.first
      if store_product == blank
        assign store_product = all_products.first
      endif
      assign routine_variant = store_product.variants[2] | default: store_product.selected_or_first_available_variant
    -%}

    <!-- Botón CTA Empezar Rutina -->
    <div class="onv-routine__cta-wrap">
      <button
        type="button"
        class="onv-routine__cta-btn"
        data-onv-add
        data-variant-id="{{ routine_variant.id | default: '' }}"
        aria-label="Empezar rutina"
      >
        <span>EMPEZAR RUTINA</span>
        <span class="onv-routine__cta-price">
          {%- if routine_variant.price -%}
            {{ routine_variant.price | money }}
          {%- else -%}
            $25.00
          {%- endif -%}
        </span>
      </button>
      <p class="onv-routine__cta-micro">Despacho inmediato en 24h · Envío seguro</p>
    </div>

    <!-- Carrusel Auto-desplazable de Testimonios (Sin botones, se pausa al tocar) -->
    <div class="onv-routine__reviews-block">
      <div class="onv-routine__reviews-header">
        <span class="onv-routine__reviews-badge">EXPERIENCIAS REALES</span>
        <h3 class="onv-routine__reviews-title">Historias tras 45 días de rutina</h3>
      </div>

      <div class="onv-reviews-marquee" id="onv-reviews-marquee">
        <div class="onv-reviews-marquee__track" id="onv-reviews-track">

          <!-- GRUPO 1 -->
          <div class="onv-reviews-marquee__group">
            <!-- Reseña 1 -->
            <article class="onv-routine__review-card">
              <div class="onv-routine__review-stars">★★★★★</div>
              <p class="onv-routine__review-quote">
                “Al principio era escéptica, pero tras la 3ra semana la textura de mi uña del pie cambió por completo. Hoy al día 45 está creciendo limpia y clara. La brocha hace que no dé pereza aplicarlo.”
              </p>
              <div class="onv-routine__review-author">
                <div class="onv-routine__review-avatar">MF</div>
                <div class="onv-routine__review-meta">
                  <span class="onv-routine__review-name">Marta Fernández</span>
                  <span class="onv-routine__review-tag">✓ Compra verificada · Rutina 45 días</span>
                </div>
              </div>
            </article>

            <!-- Reseña 2 -->
            <article class="onv-routine__review-card">
              <div class="onv-routine__review-stars">★★★★★</div>
              <p class="onv-routine__review-quote">
                “Llevaba años escondiendo mis uñas en verano. Empecé el pack de 3 frascos y la constancia valió cada segundo. Se absorbe rápido y no mancha los calcetines.”
              </p>
              <div class="onv-routine__review-author">
                <div class="onv-routine__review-avatar">CR</div>
                <div class="onv-routine__review-meta">
                  <span class="onv-routine__review-name">Carlos Ramírez</span>
                  <span class="onv-routine__review-tag">✓ Compra verificada · Rutina 45 días</span>
                </div>
              </div>
            </article>

            <!-- Reseña 3 -->
            <article class="onv-routine__review-card">
              <div class="onv-routine__review-stars">★★★★★</div>
              <p class="onv-routine__review-quote">
                “El formato brocha es 10 veces mejor que los goteros. Mis uñas pasaron de estar secas y quebradizas a verse nutridas y suaves desde la base. 100% recomendado.”
              </p>
              <div class="onv-routine__review-author">
                <div class="onv-routine__review-avatar">DM</div>
                <div class="onv-routine__review-meta">
