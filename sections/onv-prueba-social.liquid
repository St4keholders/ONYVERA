<script>
  (function() {
    function initShoppableCarousel() {
      const stage = document.getElementById('onv-shoppable-stage');
      const track = document.getElementById('onv-shoppable-track');
      const cards = Array.from(document.querySelectorAll('.onv-shoppable-card'));
      const prevBtn = document.getElementById('onv-shoppable-prev');
      const nextBtn = document.getElementById('onv-shoppable-next');

      if (!stage || !track || cards.length === 0) return;

      let activeIndex = 3; // Inicia centrado en la posición 3
      const totalCards = cards.length;
      let autoInterval = null;

      function updateActiveClasses() {
        cards.forEach((card, idx) => {
          card.classList.remove('is-active', 'is-adjacent-left', 'is-adjacent-right', 'is-far');
          if (idx === activeIndex) {
            card.classList.add('is-active');
          } else if (idx === (activeIndex - 1 + totalCards) % totalCards) {
            card.classList.add('is-adjacent-left');
          } else if (idx === (activeIndex + 1) % totalCards) {
            card.classList.add('is-adjacent-right');
          } else {
            card.classList.add('is-far');
          }
        });

        // Centrar exactamente la tarjeta activa en el medio del escenario
        const activeCard = cards[activeIndex];
        if (activeCard && stage && track) {
          const stageWidth = stage.offsetWidth;
          const cardCenter = activeCard.offsetLeft + (activeCard.offsetWidth / 2);
          const targetTranslate = (stageWidth / 2) - cardCenter;
          
          track.style.transform = `translate3d(${targetTranslate}px, 0, 0)`;
        }
      }

      function goToSlide(index) {
        activeIndex = (index + totalCards) % totalCards;
        updateActiveClasses();
      }

      function nextSlide() {
        goToSlide(activeIndex + 1);
      }

      function prevSlide() {
        goToSlide(activeIndex - 1);
      }

      function startAutoplay() {
        stopAutoplay();
        autoInterval = setInterval(nextSlide, 3000);
      }

      function stopAutoplay() {
        if (autoInterval) {
          clearInterval(autoInterval);
          autoInterval = null;
        }
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          nextSlide();
          startAutoplay();
        });
      }
      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          prevSlide();
          startAutoplay();
        });
      }

      cards.forEach((card, idx) => {
        card.addEventListener('click', (e) => {
          if (e.target.closest('[data-onv-add]')) return;
          goToSlide(idx);
          startAutoplay();
        });
      });

      stage.addEventListener('mouseenter', stopAutoplay);
      stage.addEventListener('mouseleave', startAutoplay);

      // Gestos táctiles en móvil
      let touchStartX = 0;
      stage.addEventListener('touchstart', (e) => {
        stopAutoplay();
        touchStartX = e.touches[0].clientX;
      }, { passive: true });

      stage.addEventListener('touchend', (e) => {
        const diff = touchStartX - e.changedTouches[0].clientX;
        if (diff > 35) nextSlide();
        else if (diff < -35) prevSlide();
        startAutoplay();
      }, { passive: true });

      window.addEventListener('resize', updateActiveClasses);

      setTimeout(updateActiveClasses, 60);
      startAutoplay();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initShoppableCarousel);
    } else {
      initShoppableCarousel();
    }
  })();
</script>

{% style %}
  .onv-shoppable-ugc {
    background-color: #ffffff;
    padding: 24px 0 20px;
    color: var(--onv-green-900);
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .onv-shoppable-ugc__container {
    width: 100%;
    margin: 0 auto;
    padding: 0;
    box-sizing: border-box;
  }

  .onv-shoppable-ugc__header {
    text-align: center;
    padding: 0 16px;
    margin-bottom: 12px;
  }

  .onv-shoppable-ugc__badge {
    display: inline-block;
    font-family: var(--onv-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--onv-teal-600);
    text-transform: uppercase;
    margin: 0;
  }

  /* Escenario del Carrusel con Altura y Padding Suficiente para No Recortar la Tarjeta Central */
  .onv-shoppable-stage {
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow: hidden;
    padding: 48px 0 44px;
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }

  /* Flechas de navegación */
  .onv-shoppable-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid rgba(19, 46, 35, 0.16);
    color: var(--onv-green-900);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 30;
    box-shadow: 0 4px 16px rgba(0,0,0,0.14);
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .onv-shoppable-nav--prev { left: 24px; }
  .onv-shoppable-nav--next { right: 24px; }

  .onv-shoppable-nav:hover {
    background: var(--onv-green-900);
    color: #ffffff;
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 6px 20px rgba(0,0,0,0.20);
  }

  .onv-shoppable-nav svg {
    width: 18px;
    height: 18px;
  }

  .onv-shoppable-track {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 22px;
    width: max-content;
    padding: 0;
    margin: 0;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
  }

  /* Tarjeta Shoppable UGC */
  .onv-shoppable-card {
    flex: 0 0 220px;
    width: 220px;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.4s ease, filter 0.4s ease;
    opacity: 0.80;
    transform: scale(0.88);
    user-select: none;
  }

  .onv-shoppable-card__media {
    position: relative;
    width: 100%;
    height: 310px;
    border-radius: 18px;
    overflow: hidden;
    background: #111111;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.10);
    transition: height 0.45s ease, box-shadow 0.45s ease;
  }

  .onv-shoppable-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .onv-shoppable-card__overlay-icons {
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 12px;
  }

  .onv-shoppable-card__quote {
    position: absolute;
    bottom: 10px;
    left: 12px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 20px;
    font-family: serif;
    font-weight: 700;
    line-height: 1;
  }

  .onv-shoppable-card__sound {
    position: absolute;
    bottom: 10px;
    right: 10px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .onv-shoppable-card__sound svg {
    width: 13px;
    height: 13px;
  }

  /* Píldora de producto inferior */
  .onv-shoppable-card__product-pill {
    margin-top: 10px;
    padding: 8px 12px;
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid rgba(19, 46, 35, 0.08);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .onv-shoppable-card__thumb {
    width: 28px;
    height: 38px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .onv-shoppable-card__info {
    display: flex;
    flex-direction: column;
    gap: 1px;
    overflow: hidden;
    flex: 1;
  }

  .onv-shoppable-card__name {
    font-family: var(--onv-body);
    font-size: 11px;
    font-weight: 700;
    color: var(--onv-green-900);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .onv-shoppable-card__price {
    font-family: var(--onv-body);
    font-size: 12px;
    font-weight: 800;
    color: var(--onv-teal-600);
  }

  .onv-shoppable-card__btn {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #132E23;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .onv-shoppable-card__btn:hover {
    background: #2C6E56;
    transform: scale(1.1);
  }

  .onv-shoppable-card__btn svg {
    width: 14px;
    height: 14px;
  }

  /* ESTADO ACTIVO: LA TARJETA DEL CENTRO ES LA MÁS GRANDE Y DESTACADA SIN RECORTES */
  .onv-shoppable-card.is-active {
    transform: scale(1.14);
    opacity: 1;
    z-index: 15;
  }

  .onv-shoppable-card.is-active .onv-shoppable-card__media {
    height: 360px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.22);
    border: 2px solid rgba(44, 110, 86, 0.40);
  }

  .onv-shoppable-card.is-active .onv-shoppable-card__product-pill {
    padding: 10px 14px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.10);
    border-color: rgba(44, 110, 86, 0.30);
  }

  .onv-shoppable-card.is-active .onv-shoppable-card__thumb {
    width: 32px;
    height: 44px;
  }

  .onv-shoppable-card.is-active .onv-shoppable-card__name {
    font-size: 12px;
  }

  .onv-shoppable-card.is-active .onv-shoppable-card__price {
    font-size: 13.5px;
  }

  .onv-shoppable-card.is-active .onv-shoppable-card__btn {
    width: 32px;
    height: 32px;
  }

  /* Responsive Móvil / Tablets */
  @media (max-width: 767px) {
    .onv-shoppable-stage {
      padding: 36px 0 32px;
    }

    .onv-shoppable-card {
      flex: 0 0 180px;
      width: 180px;
      transform: scale(0.88);
    }

    .onv-shoppable-card__media {
      height: 270px;
    }

    .onv-shoppable-card.is-active {
      transform: scale(1.08);
    }

    .onv-shoppable-card.is-active .onv-shoppable-card__media {
      height: 310px;
    }

    .onv-shoppable-nav {
      display: none;
    }
  }
{% endstyle %}

