{%- comment -%}
  ONYVERA — Sección: Shoppable UGC Carousel (Estilo Ollie)
  Autoplay cada 3 segundos, traslación suave al centro, 7 tarjetas continuas y solo antetítulo superior.
{%- endcomment -%}

{%- liquid
  assign target_product = section.settings.product
  if target_product == blank
    assign target_product = collections.all.products.first
  endif
  if target_product == blank
    assign target_product = all_products.first
  endif
-%}

<section id="onv-shoppable-carousel-{{ section.id }}" class="onv-shoppable-ugc">
