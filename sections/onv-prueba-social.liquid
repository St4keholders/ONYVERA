<script>
  (function() {
    function initInfiniteShoppableCarousel() {
      const stage = document.getElementById('onv-shoppable-stage');
      const track = document.getElementById('onv-shoppable-track');
      const prevBtn = document.getElementById('onv-shoppable-prev');
      const nextBtn = document.getElementById('onv-shoppable-next');

      if (!stage || !track) return;

      let isAnimating = false;
      let autoInterval = null;

      function getCenterIndex() {
        return Math.floor(track.children.length / 2);
      }

      function updateActiveClasses() {
        const cards = Array.from(track.children);
        const centerIdx = getCenterIndex();

        cards.forEach((card, idx) => {
          card.classList.remove('is-active', 'is-adjacent', 'is-far');
          if (idx === centerIdx) {
            card.classList.add('is-active');
          } else if (Math.abs(idx - centerIdx) === 1) {
            card.classList.add('is-adjacent');
          } else {
            card.classList.add('is-far');
          }
        });
      }

      function getStepDistance() {
        const firstCard = track.children[0];
        if (!firstCard) return 244;
        const style = window.getComputedStyle(track);
        const gap = parseFloat(style.gap) || 24;
        return firstCard.offsetWidth + gap;
      }

      function nextSlide() {
        if (isAnimating) return;
        isAnimating = true;

        const step = getStepDistance();
        track.style.transition = 'transform 0.38s cubic-bezier(0.16, 1, 0.3, 1)';
        track.style.transform = `translate3d(-${step}px, 0, 0)`;

        setTimeout(() => {
          track.style.transition = 'none';
          track.appendChild(track.firstElementChild);
          track.style.transform = 'translate3d(0, 0, 0)';
          updateActiveClasses();
          void track.offsetWidth;
          isAnimating = false;
        }, 380);
      }

      function prevSlide() {
        if (isAnimating) return;
        isAnimating = true;

        const step = getStepDistance();
        track.style.transition = 'none';
        track.insertBefore(track.lastElementChild, track.firstElementChild);
        track.style.transform = `translate3d(-${step}px, 0, 0)`;
        void track.offsetWidth;

        track.style.transition = 'transform 0.38s cubic-bezier(0.16, 1, 0.3, 1)';
        track.style.transform = 'translate3d(0, 0, 0)';

        setTimeout(() => {
          updateActiveClasses();
          isAnimating = false;
        }, 380);
      }

      function startAutoplay() {
        stopAutoplay();
        autoInterval = setInterval(nextSlide, 3000);
      }

      function stopAutoplay() {
        if (autoInterval) {
          clearInterval(autoInterval);
          autoInterval = null;
        }
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          nextSlide();
          startAutoplay();
        });
      }
      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          prevSlide();
          startAutoplay();
        });
      }

      track.addEventListener('click', (e) => {
        if (e.target.closest('[data-onv-add]')) return;
        const clickedCard = e.target.closest('.onv-shoppable-card');
        if (!clickedCard) return;

        const cards = Array.from(track.children);
        const clickedIdx = cards.indexOf(clickedCard);
        const centerIdx = getCenterIndex();

        if (clickedIdx > centerIdx) {
          nextSlide();
          startAutoplay();
        } else if (clickedIdx < centerIdx) {
          prevSlide();
          startAutoplay();
        }
      });

      stage.addEventListener('mouseenter', stopAutoplay);
      stage.addEventListener('mouseleave', startAutoplay);

      let touchStartX = 0;
      stage.addEventListener('touchstart', (e) => {
        stopAutoplay();
        touchStartX = e.touches[0].clientX;
      }, { passive: true });

      stage.addEventListener('touchend', (e) => {
        const diff = touchStartX - e.changedTouches[0].clientX;
        if (diff > 35) nextSlide();
        else if (diff < -35) prevSlide();
        startAutoplay();
      }, { passive: true });

      updateActiveClasses();
      startAutoplay();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initInfiniteShoppableCarousel);
    } else {
      initInfiniteShoppableCarousel();
    }
  })();
</script>

{% style %}
  .onv-shoppable-ugc {
    background-color: #ffffff;
    padding: 28px 0 24px;
    color: var(--onv-green-900);
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .onv-shoppable-ugc__container {
    width: 100%;
    margin: 0 auto;
    padding: 0;
    box-sizing: border-box;
  }

  .onv-shoppable-ugc__header {
    text-align: center;
    padding: 0 16px;
    margin-bottom: 20px;
  }

  .onv-shoppable-ugc__badge {
    display: inline-block;
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--accent, #2F7A6B);
    text-transform: uppercase;
    margin: 0 0 8px 0;
  }

  .onv-shoppable-ugc__title {
    font-family: var(--font-ui, 'Karla', sans-serif) !important;
    font-size: clamp(24px, 3.2vw, 36px) !important;
    font-weight: 700 !important;
    line-height: 1.15;
    color: var(--ink, #1B3A2F);
    margin: 0;
  }

  /* Escenario con altura fija para evitar saltos o layout shifts en la página */
  .onv-shoppable-stage {
    position: relative;
    width: 100vw;
    height: 480px;
    min-height: 480px;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0;
    box-sizing: border-box;
  }

  /* Flechas de navegación */
  .onv-shoppable-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid rgba(19, 46, 35, 0.16);
    color: var(--onv-green-900);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 30;
    box-shadow: 0 4px 16px rgba(0,0,0,0.14);
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .onv-shoppable-nav--prev { left: 24px; }
  .onv-shoppable-nav--next { right: 24px; }

  .onv-shoppable-nav:hover {
    background: var(--onv-green-900);
    color: #ffffff;
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 6px 20px rgba(0,0,0,0.20);
  }

  .onv-shoppable-nav svg {
    width: 18px;
    height: 18px;
  }

  /* Pista del carrusel infinito */
  .onv-shoppable-track {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    width: max-content;
    padding: 0;
    margin: 0;
    will-change: transform;
  }

  /* Tarjeta Shoppable UGC con altura fija y sin bordes negros */
  .onv-shoppable-card {
    flex: 0 0 220px;
    width: 220px;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition: transform 0.38s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    opacity: 0.75;
    transform: scale(0.88);
    user-select: none;
    background: transparent;
  }

  .onv-shoppable-card.is-adjacent {
    opacity: 0.92;
    transform: scale(0.96);
  }

  .onv-shoppable-card__media {
    position: relative;
    width: 100%;
    height: 330px;
    border-radius: 18px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    border: none;
  }

  .onv-shoppable-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border: none;
    background: #ffffff;
  }

  .onv-shoppable-card__overlay-icons {
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 12px;
  }

  .onv-shoppable-card__quote {
    position: absolute;
    bottom: 10px;
    left: 12px;
    color: rgba(255, 255, 255, 0.90);
    font-size: 22px;
    font-family: serif;
    font-weight: 700;
    line-height: 1;
    text-shadow: 0 1px 3px rgba(0,0,0,0.4);
  }

  .onv-shoppable-card__sound {
    position: absolute;
    bottom: 10px;
    right: 10px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(4px);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .onv-shoppable-card__sound svg {
    width: 13px;
    height: 13px;
  }

  /* Píldora de producto inferior */
  .onv-shoppable-card__product-pill {
    margin-top: 10px;
    padding: 8px 12px;
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid rgba(19, 46, 35, 0.08);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .onv-shoppable-card__thumb {
    width: 28px;
    height: 38px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .onv-shoppable-card__info {
    display: flex;
    flex-direction: column;
    gap: 1px;
    overflow: hidden;
    flex: 1;
  }

  .onv-shoppable-card__name {
    font-family: var(--onv-body);
    font-size: 11px;
    font-weight: 700;
    color: var(--onv-green-900);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .onv-shoppable-card__price {
    font-family: var(--onv-body);
    font-size: 12px;
    font-weight: 800;
    color: var(--onv-teal-600);
  }

  .onv-shoppable-card__btn {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #132E23;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .onv-shoppable-card__btn:hover {
    background: #2C6E56;
    transform: scale(1.1);
  }

  .onv-shoppable-card__btn svg {
    width: 14px;
    height: 14px;
  }

  /* ESTADO ACTIVO: ESCALADO LIMPIO SIN BORDES OSCUROS NI CAMBIOS DE ALTURA EN EL DOM */
  .onv-shoppable-card.is-active {
    transform: scale(1.15);
    opacity: 1;
    z-index: 15;
  }

  .onv-shoppable-card.is-active .onv-shoppable-card__media {
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.16);
    border: none;
  }

  .onv-shoppable-card.is-active .onv-shoppable-card__product-pill {
    padding: 9px 13px;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
  }

  /* Responsive Móvil / Tablets */
  @media (max-width: 767px) {
    .onv-shoppable-stage {
      height: 390px;
      min-height: 390px;
    }

    .onv-shoppable-card {
      flex: 0 0 175px;
      width: 175px;
      transform: scale(0.86);
    }

    .onv-shoppable-card__media {
      height: 260px;
    }

    .onv-shoppable-card.is-active {
      transform: scale(1.08);
    }

    .onv-shoppable-nav {
      display: none;
    }
  }
{% endstyle %}

