{% comment %}
  Renders a megamenu for the header.

  Usage:
  {% render 'header-mega-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      {%- liquid
        assign link_text = link.title
        assign link_lower = link.title | downcase | strip
        if link_lower == 'inicio'
          assign link_text = 'Home'
        elsif link_lower == 'catálogo' or link_lower == 'catalogo'
          assign link_text = 'Catalog'
        elsif link_lower == 'contacto'
          assign link_text = 'Contact'
        elsif link_lower == 'nosotros' or link_lower == 'sobre nosotros'
          assign link_text = 'About Us'
        elsif link_lower == 'preguntas frecuentes' or link_lower == 'faq' or link_lower == 'faqs'
          assign link_text = 'FAQs'
        elsif link_lower == 'tienda' or link_lower == 'productos'
          assign link_text = 'Shop'
        elsif link_lower == 'cómo usar' or link_lower == 'como usar'
          assign link_text = 'How to Use'
        endif
      -%}
      <li>
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link_text | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
                tabindex="-1"
              >
                <ul
                  class="mega-menu__list page-width{% if link.levels == 1 %} mega-menu__list--condensed{% endif %}"
                  role="list"
                >
                  {%- for childlink in link.links -%}
                    {%- liquid
                      assign child_text = childlink.title
                      assign child_lower = childlink.title | downcase | strip
                      if child_lower == 'inicio'
                        assign child_text = 'Home'
                      elsif child_lower == 'catálogo' or child_lower == 'catalogo'
                        assign child_text = 'Catalog'
                      elsif child_lower == 'contacto'
                        assign child_text = 'Contact'
                      elsif child_lower == 'nosotros' or child_lower == 'sobre nosotros'
                        assign child_text = 'About Us'
                      elsif child_lower == 'preguntas frecuentes' or child_lower == 'faq' or child_lower == 'faqs'
                        assign child_text = 'FAQs'
                      elsif child_lower == 'tienda' or child_lower == 'productos'
                        assign child_text = 'Shop'
                      elsif child_lower == 'cómo usar' or child_lower == 'como usar'
                        assign child_text = 'How to Use'
                      endif
                    -%}
                    <li>
                      <a
                        id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                        href="{{ childlink.url }}"
                        class="mega-menu__link mega-menu__link--level-2 link{% if childlink.current %} mega-menu__link--active{% endif %}"
                        {% if childlink.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ child_text | escape }}
                      </a>
                      {%- if childlink.links != blank -%}
                        <ul class="list-unstyled" role="list">
                          {%- for grandchildlink in childlink.links -%}
                            {%- liquid
                              assign grand_text = grandchildlink.title
                              assign grand_lower = grandchildlink.title | downcase | strip
                              if grand_lower == 'inicio'
                                assign grand_text = 'Home'
                              elsif grand_lower == 'catálogo' or grand_lower == 'catalogo'
                                assign grand_text = 'Catalog'
                              elsif grand_lower == 'contacto'
                                assign grand_text = 'Contact'
                              elsif grand_lower == 'nosotros' or grand_lower == 'sobre nosotros'
                                assign grand_text = 'About Us'
                              elsif grand_lower == 'preguntas frecuentes' or grand_lower == 'faq' or grand_lower == 'faqs'
                                assign grand_text = 'FAQs'
                              elsif grand_lower == 'tienda' or grand_lower == 'productos'
                                assign grand_text = 'Shop'
                              elsif grand_lower == 'cómo usar' or grand_lower == 'como usar'
                                assign grand_text = 'How to Use'
                              endif
                            -%}
                            <li>
                              <a
                                id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                href="{{ grandchildlink.url }}"
                                class="mega-menu__link link{% if grandchildlink.current %} mega-menu__link--active{% endif %}"
                                {% if grandchildlink.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                {{ grand_text | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link_text | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
